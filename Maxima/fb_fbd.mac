/* https://github.com/mkraska/meclib/wiki/Feedback-for-Free-Body-Diagrams */
/* 2026 10 07 */

/* https://github.com/mkraska/meclib/wiki/direction%28%29 */
direction(o):=block([%_v, a0, le, r1, r2, a1],
  if member(o[1], ["bar", "force", "dashpot", "springt", "springc"]) then return(o[4]-o[3]),
  if member(o[1], ["fix1"]) then return([-sin(o[4]*%pi/180), cos(o[4]*%pi/180)]),
  if member(o[1], ["fix13", "dir"]) then return([cos(o[4]*%pi/180), sin(o[4]*%pi/180)]),
  if member(o[1], ["contact"]) then return(o[4]),
  if member(o[1], ["q"]) then (
    %_v: o[5]-o[4], le: cabs(%_v[1]+%i*%_v[2]), a0: carg(%_v[1]+%i*%_v[2]),
    return([cos(a0+o[8]*pi/180), sin(a0+o[8]*pi/180)]) 
    ),
  if member(o[1], ["rope"]) then (
    /* same math as in meclib */
    %_v: o[5]-o[3], le: cabs(%_v[1]+%i*%_v[2]), a0: carg(%_v[1]+%i*%_v[2]),
    r1: o[4], r2: o[6], a1: acos((r1-r2)/le),
    return(float(%_v+[(r2-r1)*cos(a0-a1), (r2-r1)*sin(a0-a1)]))
    )
);

/* https://github.com/mkraska/meclib/wiki/angle%28%29 */
angle(a,b):= block([da,db],
    da: direction(a), db: direction(b),
    if listp(da) and listp(db) then 
        return(-carg(da[1]+%i*da[2])+carg(db[1]+%i*db[2]) ) 
);

/* https://github.com/mkraska/meclib/wiki/moment_of_force%28%29 */
moment_of_force(p, f, fname, rname):=block([vf,vr],
   vf: (f[4]-f[3]),
   vf: vf/sqrt(vf[1]^2+vf[2]^2)*fname,
   vr: (f[3]-p)*rname,
   vr[1]*vf[2]-vr[2]*vf[1]
);

/* https://github.com/mkraska/meclib/wiki/Sums-of-Forces-and-Moments */
unitvec(l):=block( [v] , v:round((l[4]-l[3])*10),ratexpand(v/sqrt(v[1]^2+v[2]^2)));
msign(l):=block( [v1,v2] , v1:l[4]-l[3],v2:l[5]-l[3],round(signum(v1[1]*v2[2]-v1[2]*v2[1])));
moment(p, f, fname, rname):=block([vf,vr],
   vf: unitvec(f)*fname,
   vr: round((f[3]-p)*10)/10*rname,
   vr[1]*vf[2]-vr[2]*vf[1]);
sum_xyM(o,n,p,lu):=block([f: 0,m: 0],
  for i:1 thru length(o)  do (
    if (o[i][1]="force") then f: f+n[i]*unitvec(o[i]),
    if (o[i][1]="force") then m: m+moment(p, o[i], n[i],lu),
    if (o[i][1]="moment") then m: m+n[i]*msign(o[i])
  ),
  [f[1],f[2],m]
);

/* https://github.com/mkraska/meclib/wiki/sum_dir%28%29 */
/* Simple single-direction variant of sum_xyM: sums the scalar projections of all matched
   "force" loads in o/n onto a single given direction vector d (e.g. from direction() on a
   "dir" object). Intended for central/concurrent force systems, where only force equilibrium
   in self-chosen directions is needed and no moment term applies.
   Unlike sum_xyM (which uses unitvec()'s 0.1-grid rounding - appropriate for a hand-dragged
   force arrow, whose own JSXGraph point already snaps to the grid), the force direction here
   is normalized exactly, without that extra rounding step: it is redundant with the JSXGraph
   grid snap, and for a force at a fixed, exactly-known geometric position (as with a "dir"-based
   equilibrium direction) it would introduce its own small, spurious deviation from an otherwise
   exact perpendicularity. */
sum_dir(o,n,d):=block([f: 0, v, u],
  for i:1 thru length(o) do (
    if (o[i][1]="force") then (
      v: o[i][4]-o[i][3],
      u: v/sqrt(v[1]^2+v[2]^2),
      f: f+n[i]*(u[1]*d[1]+u[2]*d[2])
    )
  ),
  f
);

/* https://github.com/mkraska/meclib/wiki/parallelp%28%29 */
parallelp(a,b):= block([da,db],
    da: direction(a), db: direction(b),
    if listp(da) and listp(db) then
        return(is (abs(da[1]*db[2]-da[2]*db[1])<0.05) )
);

/* https://github.com/mkraska/meclib/wiki/perpendicularp%28%29 */
perpendicularp(a,b):= block([da,db],
    da: direction(a), db: direction(b),
    if listp(da) and listp(db) then
        return(is (abs(da[1]*db[1]+da[2]*db[2])<0.05) )
);

/* https://github.com/mkraska/meclib/wiki/contributor%28%29 */
/* Purely formative helper for a direction-choice PRT (no grading effect of its own): lists the
   names of every "force" object in o (regardless of state - an external force, a recognized
   reaction, or a reaction the student placed somewhere a "contact" doesn't recognize) that will
   actually contribute a non-negligible term when summed along the direction of the "dir" object
   at index i_dir, i.e. when o is later passed to sum_dir(o, n, direction(o[i_dir])).
   Deliberately does NOT reuse perpendicularp(), which compares the RAW (non-normalized)
   direction() vectors - for a "force" object that vector is o[4]-o[3], whose length depends on
   how long the student happened to drag the arrow, so a fixed threshold on that raw dot product
   is not meaningfully comparable across forces of different length. Instead this recomputes the
   same normalized projection coefficient sum_dir itself would use (unit force vector dotted with
   the direction), and compares its absolute value against tol directly - so tol is on the same
   footing as the coefficient tolerance already used in fb_coeffs.
   Returns the list of names (n[i]) of the contributing forces, ready for fb_strip_list(); an
   empty list means every force present is (numerically) perpendicular to this direction. */
contributor(o, n, i_dir, tol):= block([d: direction(o[i_dir]), v, u, result: []],
  for i: 1 thru length(o) do (
    if o[i][1] = "force" then (
      v: o[i][4]-o[i][3],
      u: v/sqrt(v[1]^2+v[2]^2),
      if abs(u[1]*d[1]+u[2]*d[2]) > tol then result: cons(n[i], result)
    )
  ),
  reverse(result)
);

/* https://github.com/mkraska/meclib/wiki/fb_dir */
/* Feedback for one or two direction-choice PRTs, combining contributor()'s formative listing for
   each direction with, when two directions are given, a check that they aren't parallel: if they
   are, the resulting equilibrium equations would be linearly dependent - that is a genuine
   mistake, not just a suboptimal-but-valid choice, so the returned flag is false in that case and
   the calling PRT should apply a real grading consequence. The per-direction contributor listing
   is still appended afterwards regardless of the parallelity outcome, since it remains useful
   either way.
   %_dirs: a list of [i_dir, desc] pairs, length 1 (purely formative, flag always true - same
   behavior as the previous single-direction fb_dir()) or 2 (adds the parallelity check).
   %_desc is the phrase naming the direction, inserted as-is at the end of its sentence, e.g.
   "in 1-Richtung" (so this stays reusable in other questions/languages without hardcoding the
   direction's own name or numbering here).
   Returns [text, flag], to be dropped into a PRT node the same way as fb_fix1/fb_contact/etc. */
/* %_desc (the phrase naming the direction, see above) is supplied by the calling question
   and is NOT translated here - a question that wants this feedback in both languages must
   author %_desc itself bilingually (e.g. as its own [[lang]]-wrapped phrase), the same way a
   caller is responsible for %_description elsewhere in this file (fb_fix1 etc.). Only the
   fixed wrapper text below is converted. */
fb_dir(%_o, %_n, %_dirs, %_tol):= block([%_ok: true, %_parts: [], %_contrib, %_i, %_desc, %_sentence, %_text, %_k,
    str_parallel: castext("[[lang code='de']]Die gewählten Richtungen sind parallel. Damit liefern die beiden Gleichgewichtsbedingungen keine voneinander unabhängigen Gleichungen.[[/lang]][[lang code='en,other']]The chosen directions are parallel. The two equilibrium conditions would then not provide independent equations.[[/lang]]"),
    str_none_pre: castext("[[lang code='de']]Keine Kraft hat Anteile [[/lang]][[lang code='en,other']]No force has components [[/lang]]"),
    str_has_mid: castext("[[lang code='de']] hat Anteile [[/lang]][[lang code='en,other']] has components [[/lang]]"),
    str_have_mid: castext("[[lang code='de']] haben Anteile [[/lang]][[lang code='en,other']] have components [[/lang]]")],
  if length(%_dirs) = 2 and parallelp(%_o[%_dirs[1][1]], %_o[%_dirs[2][1]]) then (
    %_ok: false,
    %_parts: cons(str_parallel, %_parts)
  ),
  for %_pair in %_dirs do (
    %_i: %_pair[1], %_desc: %_pair[2],
    %_contrib: contributor(%_o, %_n, %_i, %_tol),
    %_sentence: if %_contrib = [] then
        castext_concat(str_none_pre, castext_concat(%_desc, "."))
      elseif length(%_contrib) = 1 then
        castext_concat(castext_concat(fb_strip_list(%_contrib), str_has_mid), castext_concat(%_desc, "."))
      else
        castext_concat(castext_concat(fb_strip_list(%_contrib), str_have_mid), castext_concat(%_desc, ".")),
    %_parts: cons(%_sentence, %_parts)
  ),
  %_parts: reverse(%_parts),
  %_text: %_parts[1],
  for %_k: 2 thru length(%_parts) do %_text: castext_concat(%_text, castext_concat("<br>", %_parts[%_k])),
  [%_text, %_ok]
);

/* https://github.com/mkraska/meclib/wiki/fb_force_hvxy */
fb_force_hvxy(o,i):=block([dir, name, nl, base, idx,
    str_multiletter: castext("[[lang code='de']]\\): Physikalische Gr&ouml;&szlig;en immer nur mit einem Buchstabe und eventuell Index schreiben, z.B. <code>F_1</code>.[[/lang]][[lang code='en,other']]\\): always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>.[[/lang]]"),
    str_noindex: castext("[[lang code='de']]\\) sollte einen Richtungsindex (x, y, h, v) haben.[[/lang]][[lang code='en,other']]\\) should have a direction index (x, y, h, v).[[/lang]]"),
    str_idxlong: castext("[[lang code='de']]\\): Ein Buchstabe sollte für den Index reichen.[[/lang]][[lang code='en,other']]\\): a single letter should be enough for the index.[[/lang]]"),
    str_idxunknown: castext("[[lang code='de']]\\): Der Richtungsindex sollte h, v, x oder y sein[[/lang]][[lang code='en,other']]\\): the direction index should be h, v, x or y[[/lang]]"),
    str_should_h: castext("[[lang code='de']]\\) m&uuml;sste eine horizontale Kraft bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a horizontal force.[[/lang]]"),
    str_should_v: castext("[[lang code='de']]\\) m&uuml;sste eine vertikale Kraft bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a vertical force.[[/lang]]"),
    str_should_x: castext("[[lang code='de']]\\) m&uuml;sste eine Kraft in positive x-Richtung (nach rechts) bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a force in the positive x direction (to the right).[[/lang]]"),
    str_should_y: castext("[[lang code='de']]\\) m&uuml;sste eine Kraft in positive y-Richtung (nach oben) bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a force in the positive y direction (upward).[[/lang]]")],
    name: o[i][2], nl: split(name,"_"),
    /* All str_* above are fully static (no dynamic value of their own) and safe to hoist at the
       top. The dynamic part (name) is plain-concatenated at each point of use below instead of
       being embedded inside a castext() call - "\\(" is pure LaTeX markup, not translated text,
       so it doesn't need its own castext() entry. This keeps every piece of translatable text in
       exactly one place at the top of the function. */
    /* base name single character? */
    if slength(first(nl)) > 1
    then return([sconcat("\\(", name, str_multiletter), false]),
    /* is there an index? */
    if length(nl) # 2
    then return([sconcat("\\(", name, str_noindex), false]),
    /* are name and index just a single character? */
    idx: last(nl),
    if slength(idx) > 1
    then return([sconcat("\\(", name, str_idxlong), false]),
    /* is the index known? */
    if not member(sdowncase(idx), ["h","v","x","y"])
    then return([sconcat("\\(", name, str_idxunknown), false]),
    /* check directions */
    dir: direction(o[i]),
    if (sdowncase(idx)="h" and abs(dir[2]) > 0.01) then
    return([sconcat("\\(", name, str_should_h), false]),
    if (sdowncase(idx)="v" and abs(dir[1]) > 0.01) then
    return([sconcat("\\(", name, str_should_v), false]),
    if (sdowncase(idx)="x" and (abs(dir[2]) > 0.01 or dir[1] <0) ) then
    return([sconcat("\\(", name, str_should_x), false]),
    if (sdowncase(idx)="y" and (abs(dir[1]) > 0.01 or dir[2] <0) ) then
    return([sconcat("\\(", name, str_should_y), false]),
    /* Name is ok */
    return(["",true])
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-%22fix1%22 */
fb_fix1(%_o, %_n, %_i, %_description):=block(
    [%_txt: sconcat("<br>",%_description), %_R,
     str_not_deactivated: castext("[[lang code='de']]ist nicht deaktiviert.[[/lang]][[lang code='en,other']]is not deactivated.[[/lang]]"),
     str_no_reaction: castext("[[lang code='de']]Keine Reaktion gefunden.[[/lang]][[lang code='en,other']]No reaction found.[[/lang]]"),
     str_more_than_one: castext("[[lang code='de']]Mehr als eine Reaktion gefunden.[[/lang]][[lang code='en,other']]More than one reaction found.[[/lang]]"),
     str_must_be_force: castext("[[lang code='de']]Die Reaktion muss eine Kraft sein.[[/lang]][[lang code='en,other']]The reaction must be a force.[[/lang]]"),
     str_wrong_direction_pre: castext("[[lang code='de']]Die Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
     str_wrong_direction_post: castext("[[lang code='de']]\\) hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]\\) does not have the correct direction.[[/lang]]"),
     str_found_pre: castext("[[lang code='de']]Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
     str_found_post: castext("[[lang code='de']]\\) gefunden.[[/lang]][[lang code='en,other']]\\) found.[[/lang]]")],
    /* Is object i a fixed support */
    if ( %_o[%_i][1] # "fix1" ) then return ([sconcat(%_txt, "object ", string(%_i), " is not a fixed support (fix1)"), false]),
    /* Is object i de-activated */
    if ( %_o[%_i][length(%_o[%_i])] # "hide") then return ([castext_concat(%_txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(%_n[%_i]) or %_n[%_i]=[] then return([castext_concat(%_txt, str_no_reaction), false]),
    /* Exactly 1 reaction found? */
    if (length(%_n[%_i]) > 1) then return( [castext_concat(%_txt, str_more_than_one), false]),
    /* Is the reaction a force? */
    if ( %_o[%_n[%_i][1]][1] # "force" ) then return ([castext_concat(%_txt, str_must_be_force), false]),
    /* Now ready for examination of the reaction */
    %_R: %_o[%_n[%_i][1]],
    /* Is the force normal to the support? */
    if not parallelp(%_R, %_o[%_i]) then return ([castext_concat(%_txt, sconcat(str_wrong_direction_pre, %_R[2], str_wrong_direction_post)),false]),
    /* everything should be ok here */
    return([castext_concat(%_txt, sconcat(str_found_pre, %_R[2], str_found_post)),true])
);

fb_fix1_name(%_o, %_n, %_i):=block(
    [%_R,
     str_single_letter: castext("[[lang code='de']]<br>Ein einzelner Buchstabe sollte f&uuml;r die Bezeichnung der Kraft ausreichen.[[/lang]][[lang code='en,other']]<br>A single letter should be enough to name the force.[[/lang]]"),
     str_name_mismatch: castext("[[lang code='de']]<br>Der Name der Reaktionskraft sollte zum Namen des Lagerpunkts passen.[[/lang]][[lang code='en,other']]<br>The reaction force's name should match the name of the support point.[[/lang]]")],
    if not listp(%_n[%_i]) then return(["",false]),
    %_R: %_o[%_n[%_i][1]],
    /* name checking */
    if slength(%_R[2]) # 1 then return([str_single_letter,false]),
    if %_R[2] # %_o[%_i][2] then return([str_name_mismatch, false]),
    /* everything should be ok here */
    return(["",true])
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-%22fix12%22 */
fb_fix12(o, n, i, description):=block(
    [L1, L2, R1, R2,
     str_not_deactivated: castext("[[lang code='de']]ist nicht deaktiviert.[[/lang]][[lang code='en,other']]is not deactivated.[[/lang]]"),
     str_no_reaction: castext("[[lang code='de']]Keine Reaktion gefunden.[[/lang]][[lang code='en,other']]No reaction found.[[/lang]]"),
     str_more_than_two: castext("[[lang code='de']]Mehr als 2 Reaktionen gefunden.[[/lang]][[lang code='en,other']]More than 2 reactions found.[[/lang]]"),
     str_less_than_two: castext("[[lang code='de']]Weniger als 2 Reaktionen gefunden.[[/lang]][[lang code='en,other']]Fewer than 2 reactions found.[[/lang]]"),
     str_different_names: castext("[[lang code='de']]Die Reaktionen müssen verschiedene Namen haben.[[/lang]][[lang code='en,other']]The reactions must have different names.[[/lang]]"),
     str_must_be_force_pre: castext("[[lang code='de']]Die Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
     str_must_be_force_post: castext("[[lang code='de']]\\) muss eine Kraft sein.[[/lang]][[lang code='en,other']]\\) must be a force.[[/lang]]"),
     str_parallel_pre: castext("[[lang code='de']]Die Reaktionen \\([[/lang]][[lang code='en,other']]Reactions \\([[/lang]]"),
     str_parallel_post: castext("[[lang code='de']]\\) sind parallel.[[/lang]][[lang code='en,other']]\\) are parallel.[[/lang]]"),
     str_fix12_found_pre: castext("[[lang code='de']]Reaktionen \\([[/lang]][[lang code='en,other']]Reactions \\([[/lang]]"),
     str_fix12_found_post: castext("[[lang code='de']]\\) gefunden. [[/lang]][[lang code='en,other']]\\) found. [[/lang]]")],
    txt: sconcat("<br>",description),
     /* Is object i an fixed support? */
    if not member(o[i][1], ["fix12"])
    then return ([sconcat(txt, "object ", string(i), " (", o[i][1], ") is not a fixed support."), false]),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
    /* Exactly 2 reaction found? */
    if (length(n[i]) > 2) then return( [castext_concat(txt, str_more_than_two), false]),
    /* Is the reaction a force? */
    if (length(n[i]) < 2) then return( [castext_concat(txt, str_less_than_two), false]),
    R1: o[n[i][1]], R2: o[n[i][2]],
    /* Is the reaction a force? */
    if ( o[n[i][1]][1] # "force" )
    then return ([castext_concat(txt, sconcat(str_must_be_force_pre, R1[2], str_must_be_force_post)),false]),
    if ( o[n[i][2]][1] # "force" )
    then return ([castext_concat(txt, sconcat(str_must_be_force_pre, R2[2], str_must_be_force_post)),false]),
    /* Equal names? */
    if (R1[2] = R2[2]) then return ([castext_concat(txt, str_different_names),false]),
    /* Are the reactions non-parallel? */
    if parallelp(R1, R2) then return ([castext_concat(txt, sconcat(str_parallel_pre, R1[2], ",", R2[2], str_parallel_post)),false]),
    /* everything should be ok here */
    return([castext_concat(txt, sconcat(str_fix12_found_pre, R1[2], ",", R2[2], str_fix12_found_post)),true])
);
fb_fix12_name(o, n, i):=block(
    [dir, idx, nl, L, R, txt: "", flag:false,
     str_multiletter: castext("[[lang code='de']]\\): Physikalische Gr&ouml;&szlig;en immer nur mit einem Buchstabe und eventuell Index schreiben, z.B. <code>F_1</code>.[[/lang]][[lang code='en,other']]\\): always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>.[[/lang]]"),
     str_namemismatch_pre: castext("[[lang code='de']]<br>Der Name \\([[/lang]][[lang code='en,other']]<br>The name \\([[/lang]]"),
     str_namemismatch_post: castext("[[lang code='de']]\\) passt nicht zum Name des Lagerpunkts.[[/lang]][[lang code='en,other']]\\) does not match the name of the support point.[[/lang]]"),
     str_noindex: castext("[[lang code='de']]\\) sollte einen Richtungsindex (x, y, h, v) haben.[[/lang]][[lang code='en,other']]\\) should have a direction index (x, y, h, v).[[/lang]]"),
     str_idxlong: castext("[[lang code='de']]\\): Ein Buchstabe sollte für den Index reichen.[[/lang]][[lang code='en,other']]\\): a single letter should be enough for the index.[[/lang]]"),
     str_idxunknown: castext("[[lang code='de']]\\): Der Richtungsindex sollte h, v, x oder y sein[[/lang]][[lang code='en,other']]\\): the direction index should be h, v, x or y[[/lang]]"),
     str_should_h: castext("[[lang code='de']]\\) m&uuml;sste eine horizontale Kraft bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a horizontal force.[[/lang]]"),
     str_should_v: castext("[[lang code='de']]\\) m&uuml;sste eine vertikale Kraft bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a vertical force.[[/lang]]"),
     str_should_x: castext("[[lang code='de']]\\) m&uuml;sste eine Kraft in positive x-Richtung (nach rechts) bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a force in the positive x-direction (to the right).[[/lang]]"),
     str_should_y: castext("[[lang code='de']]\\) m&uuml;sste eine Kraft in positive y-Richtung (nach oben) bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a force in the positive y-direction (upward).[[/lang]]")],
    /* All str_* above are fully static and hoisted once here, outside the loop - they don't
       depend on R (the reaction object currently being checked), which only gets a new value on
       each iteration of the "for ir in n[i]" loop below. Only the dynamic part (R[2]) is inserted
       at the point of use, via plain concatenation, once per iteration - no castext() call is
       made inside the loop at all. */
    /* do the non-name checks to avoid runtime-errors */
    if not member(o[i][1], ["fix12"]) then return (["", false]),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return (["", false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return(["", false]),
    /* Exactly 2 reaction found? */
    if (length(n[i]) > 2) then return( ["", false]),
    for ir in n[i] do (      /* loop over the reactions */
       R: o[ir],
       /* Is the reaction a force? */
       if ( R[1] # "force" ) then return,
       /* Extract name parts */
       nl: split(R[2],"_"),
       /* base name single character? */
       if slength(nl[1]) > 1 then (flag:true,
          txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_multiletter)),
             return(return)),
       /* force name matches support name?*/
       if is(nl[1] # o[i][2]) then (flag:true,
            txt: castext_concat(txt, sconcat(str_namemismatch_pre, R[2], str_namemismatch_post))),
       /* is there an index? */
       if length(nl) # 2 then (flag: true,
         txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_noindex))),
       /* is  index just a single character? */
       idx: last(nl),
       if slength(idx) > 1 then (flag:true,
        txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_idxlong))),
       /* is the index known? */
       if not member(sdowncase(idx), ["h","v","x","y"]) then (flag:true,
            txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_idxunknown))),
       /* check directions */
       dir: direction(R),
       if (sdowncase(idx)="h" and abs(dir[2]) > 0.01) then (flag:true,
            txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_should_h))),
       if (sdowncase(idx)="v" and abs(dir[1]) > 0.01) then (flag:true,
            txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_should_v))),
       if (sdowncase(idx)="x" and (abs(dir[2]) > 0.01 or dir[1] <0) ) then (flag:true,
            txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_should_x))),
       if (sdowncase(idx)="y" and (abs(dir[1]) > 0.01 or dir[2] <0) ) then(flag:true,
            txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_should_y)))
    ),
 if flag then return([txt,false]),
   ["",true]
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-%22fix123%22 */
fb_fix123(o, n, i, description):=block(
    [sname: o[i][2], txt: sconcat("<br>",description), lf, lm,
     str_not_deactivated: castext("[[lang code='de']]ist nicht deaktiviert.[[/lang]][[lang code='en,other']]is not deactivated.[[/lang]]"),
     str_no_reaction: castext("[[lang code='de']]Keine Reaktion gefunden.[[/lang]][[lang code='en,other']]No reaction found.[[/lang]]"),
     str_too_few: castext("[[lang code='de']]Weniger als drei Reaktionen gefunden.[[/lang]][[lang code='en,other']]Fewer than three reactions found.[[/lang]]"),
     str_too_many: castext("[[lang code='de']]Mehr als drei Reaktionen gefunden.[[/lang]][[lang code='en,other']]More than three reactions found.[[/lang]]"),
     str_count_pre: castext("[[lang code='de']]Kräfte: [[/lang]][[lang code='en,other']]Forces: [[/lang]]"),
     str_count_mid: castext("[[lang code='de']], Momente: [[/lang]][[lang code='en,other']], moments: [[/lang]]"),
     str_count_post: castext("[[lang code='de']] gefunden[[/lang]][[lang code='en,other']] found[[/lang]]"),
     str_parallel_pre: castext("[[lang code='de']]Die Reaktionen \\([[/lang]][[lang code='en,other']]Reactions \\([[/lang]]"),
     str_parallel_mid: castext("[[lang code='de']]\\) und \\([[/lang]][[lang code='en,other']]\\) and \\([[/lang]]"),
     str_parallel_post: castext("[[lang code='de']]\\) sind parallel.[[/lang]][[lang code='en,other']]\\) are parallel.[[/lang]]"),
     str_found_pre: castext("[[lang code='de']]Reaktionskräfte \\([[/lang]][[lang code='en,other']]Reaction forces \\([[/lang]]"),
     str_found_mid: castext("[[lang code='de']]\\) und Moment \\([[/lang]][[lang code='en,other']]\\) and moment \\([[/lang]]"),
     str_found_post: castext("[[lang code='de']]\\) gefunden.[[/lang]][[lang code='en,other']]\\) found.[[/lang]]")],
    /* Is object i a built-in support? */
    if not member(o[i][1], ["fix123"])
    then return ([sconcat(txt, "object ", string(i), "(",o[i][1],") is not a built-in support."), false]),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
    /* Too few reactions found? */
    if (length(n[i]) <3) then return( [castext_concat(txt, str_too_few), false]),
    /* Too many reactions found? */
    if (length(n[i]) >3) then return( [castext_concat(txt, str_too_many), false]),
    /* 2 forces and 1 moment?*/
    lf: sublist(n[i], lambda ([x], o[x][1]="force")),
    lm: sublist(n[i], lambda ([x], o[x][1]="moment")),
    if ( length(lf) # 2 or length(lm) #1) then return ([castext_concat(txt, sconcat(str_count_pre, length(lf), str_count_mid, length(lm), str_count_post)),false]),
    /* Forces not parallel? */
    if (parallelp( o[lf[1]], o[lf[2]] ) ) then return([castext_concat(txt, sconcat(str_parallel_pre, n[lf[1]], str_parallel_mid, n[lf[2]], str_parallel_post)), false]),
    /* everything should be ok here */
    return([castext_concat(txt, sconcat(str_found_pre, n[lf[1]], ",", n[lf[2]], str_found_mid, n[lm[1]], str_found_post)),true])
);
fb_fix123_name(o, n, i):=block(
    [sname: o[i][2], txt: "", ir, fb_required, ntxt, nok,
     str_namemismatch_pre: castext("[[lang code='de']]<br>Der Name \\([[/lang]][[lang code='en,other']]<br>The name \\([[/lang]]"),
     str_namemismatch_post: castext("[[lang code='de']]\\) passt nicht zum Name des Lagerpunktes.[[/lang]][[lang code='en,other']]\\) does not match the name of the support point.[[/lang]]"),
     str_notmoment_post: castext("[[lang code='de']]\\) passt nicht zu einem Moment.[[/lang]][[lang code='en,other']]\\) does not match a moment.[[/lang]]")],
    /* make sure that there is at least one reaction */
    if not listp(n[i]) or n[i]=[] then return(["", false]),
    /*iterate over reactions*/
    fb_required: false,
    /* The static str_* above are hoisted once here, outside the loop - they don't depend on ir.
       Only the dynamic part (n[ir]) is inserted at the point of use, via plain concatenation,
       once per iteration - no castext() call is made inside the loop at all. */
    for ir in n[i] do (
        /* feedback for forces */
        if o[ir][1]="force" then (
            if (sname # first(charlist( o[ir][2] ))  ) then (
                 txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_namemismatch_post)),
                 fb_required: true),
            [ntxt,nok]: fb_force_hvxy(o, ir),
            if not nok then (
                txt: castext_concat(txt, castext_concat("<br>", ntxt)),
                fb_required: true)
         ),
		/* Feedback for moments */
        if o[ir][1]="moment" then (
            if (sname # last(charlist( o[ir][2] ))  ) then (
                txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_namemismatch_post)),
                fb_required: true),
            if (first(charlist( o[ir][2] )) # "M" ) then (
                txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_notmoment_post)),
                fb_required: true)
        )
    ),
    if fb_required then return([txt, false]),
    ["",true]
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-%22fix13%22 */
fb_fix13(o, n, i, description):=block(
    [sname: o[i][2], txt: sconcat("<br>",description), lf, lm,
     str_not_deactivated: castext("[[lang code='de']]ist nicht deaktiviert.[[/lang]][[lang code='en,other']]is not deactivated.[[/lang]]"),
     str_no_reaction: castext("[[lang code='de']]Keine Reaktion gefunden.[[/lang]][[lang code='en,other']]No reaction found.[[/lang]]"),
     str_too_few: castext("[[lang code='de']]Weniger als zwei Reaktionen gefunden.[[/lang]][[lang code='en,other']]Fewer than two reactions found.[[/lang]]"),
     str_too_many: castext("[[lang code='de']]Mehr als zwei Reaktionen gefunden.[[/lang]][[lang code='en,other']]More than two reactions found.[[/lang]]"),
     str_count_pre: castext("[[lang code='de']]Kräfte: [[/lang]][[lang code='en,other']]Forces: [[/lang]]"),
     str_count_mid: castext("[[lang code='de']], Momente: [[/lang]][[lang code='en,other']], moments: [[/lang]]"),
     str_count_post: castext("[[lang code='de']] gefunden[[/lang]][[lang code='en,other']] found[[/lang]]"),
     str_wrong_direction_pre: castext("[[lang code='de']]Die Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
     str_wrong_direction_post: castext("[[lang code='de']]\\) hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]\\) does not have the correct direction.[[/lang]]"),
     str_found_pre: castext("[[lang code='de']]Reaktionskraft \\([[/lang]][[lang code='en,other']]Reaction force \\([[/lang]]"),
     str_found_mid: castext("[[lang code='de']]\\) und Moment \\([[/lang]][[lang code='en,other']]\\) and moment \\([[/lang]]"),
     str_found_post: castext("[[lang code='de']]\\) gefunden.[[/lang]][[lang code='en,other']]\\) found.[[/lang]]")],
    /* Is object a frictionless support? */
    if not member(o[i][1], ["fix13"])
    then return ([sconcat(txt, "object ", string(i), "(",o[i][1],") is not a frictionless support."), false]),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
    /* Too few reactions found? */
    if (length(n[i]) <2) then return( [castext_concat(txt, str_too_few), false]),
    /* Too many reactions found? */
    if (length(n[i]) >2) then return( [castext_concat(txt, str_too_many), false]),
    /* 1 force and 1 moment?*/
    lf: sublist(n[i], lambda ([x], o[x][1]="force")),
    lm: sublist(n[i], lambda ([x], o[x][1]="moment")),
    if ( length(lf) # 1 or length(lm) #1) then return ([castext_concat(txt, sconcat(str_count_pre, length(lf), str_count_mid, length(lm), str_count_post)),false]),
    /* Forces in correct direction? */
    if (not parallelp( o[i], o[lf[1]] ) ) then return([castext_concat(txt, sconcat(str_wrong_direction_pre, n[lf[1]], str_wrong_direction_post)), false]),
    /* everything should be ok here */
    return([castext_concat(txt, sconcat(str_found_pre, n[lf[1]], str_found_mid, n[lm[1]], str_found_post)),true])
);

fb_fix13_names(o, n, i):=block(
    [sname: o[i][2], txt: "", ir, fb_required,
     str_singleletter_pre: castext("[[lang code='de']]<br> \\([[/lang]][[lang code='en,other']]<br> \\([[/lang]]"),
     str_singleletter_post: castext("[[lang code='de']]\\) Ein einzelner Buchstabe sollte f&uuml;r die Bezeichnung der Kraft ausreichen[[/lang]][[lang code='en,other']]\\) a single letter should be enough to name the force[[/lang]]"),
     str_namemismatch_pre: castext("[[lang code='de']]<br>Der Name \\([[/lang]][[lang code='en,other']]<br>The name \\([[/lang]]"),
     str_namemismatch_post: castext("[[lang code='de']]\\) passt nicht zum Name des Lagerpunktes.[[/lang]][[lang code='en,other']]\\) does not match the name of the support point.[[/lang]]"),
     str_notmoment_post: castext("[[lang code='de']]\\) passt nicht zu einem Moment.[[/lang]][[lang code='en,other']]\\) does not match a moment.[[/lang]]")],
    /* make sure that there is at least one reaction */
    if not listp(n[i]) or n[i]=[] then return(["", false]),
    /*iterate over reactions*/
    fb_required: false,
    /* The static str_* above are hoisted once here, outside the loop. Only the dynamic part
       (n[ir]) is inserted at the point of use, via plain concatenation, once per iteration - no
       castext() call is made inside the loop at all. */
    for ir in n[i] do (
        /* feedback for forces */
        if o[ir][1]="force" then (
             if slength(o[ir][2]) # 1 then (
                  txt: castext_concat(txt, sconcat(str_singleletter_pre, n[ir], str_singleletter_post)),
                  fb_required: true),
            if (sname # o[ir][2]   ) then (
                 txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_namemismatch_post)),
                 fb_required: true)
            /* No fb_force_hvxy() check here: a fix13 support has exactly one reaction force
               (plus one moment), so the H/V/x/y naming scheme checked in fb_fix123_name() does not apply. */
         ),
        if o[ir][1]="moment" then (
            if (sname # last(charlist( o[ir][2] ))  ) then (
                txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_namemismatch_post)),
                fb_required: true),
            if (first(charlist( o[ir][2] )) # "M" ) then (
                txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_notmoment_post)),
                fb_required: true)
        )
    ),
    if fb_required then return([txt, false]),
    ["",true]
);
/* Alias for consistency */
fb_fix13_name(%_o, %_n, %_i):= fb_fix13_names(%_o, %_n, %_i);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-unidirectional-supports */
fb_unidir(o, n, i, description):=block(
    [txt, R,
     str_not_deactivated: castext("[[lang code='de']]Nicht deaktiviert.[[/lang]][[lang code='en,other']]Not deactivated.[[/lang]]"),
     str_no_reaction: castext("[[lang code='de']]Keine Reaktion gefunden.[[/lang]][[lang code='en,other']]No reaction found.[[/lang]]"),
     str_more_than_one: castext("[[lang code='de']]Mehr als eine Reaktion gefunden.[[/lang]][[lang code='en,other']]More than one reaction found.[[/lang]]"),
     str_must_be_force: castext("[[lang code='de']]Die Reaktion muss eine Kraft sein.[[/lang]][[lang code='en,other']]The reaction must be a force.[[/lang]]"),
     str_wrong_direction_pre: castext("[[lang code='de']]Die Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
     str_wrong_direction_post: castext("[[lang code='de']]\\) hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]\\) does not have the correct direction.[[/lang]]"),
     str_found_pre: castext("[[lang code='de']]Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
     str_found_post: castext("[[lang code='de']]\\) gefunden.[[/lang]][[lang code='en,other']]\\) found.[[/lang]]")],
    txt: description,
    /* Is object i an unidirectional support? */
    if not member(o[i][1], ["bar", "dashpot", "springt", "springc", "fix1", "rope"])
    then return ([sconcat(txt, "object ", string(i), " (",o[i][1],") is not an unidirectional support."), false]),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
    /* Exactly 1 reaction found? */
    if (length(n[i]) > 1) then return( [castext_concat(txt, str_more_than_one), false]),
    /* Is the reaction a force? */
    if ( o[n[i][1]][1] # "force" ) then return ([castext_concat(txt, str_must_be_force), false]),
    R: o[n[i][1]],
    /* Is the force normal to the support? */
    if not parallelp(R, o[i]) then return ([castext_concat(txt, sconcat(str_wrong_direction_pre, n[n[i][1]], str_wrong_direction_post)), false]),
    /* everything should be ok here */
    return([castext_concat(txt, sconcat(str_found_pre, n[n[i][1]], str_found_post)), true])
);

/* https://github.com/mkraska/meclib/wiki/fb_resolve_ref */
/* Resolves a "contact" targetRef to an index into o. %_ref may be a name string, a 1-based
   index, or a LIST of either (for a contact that cuts away several environment objects at
   once, e.g. two wall segments meeting at a corner) - in the list case every element must
   resolve, and the result is the list of their indices, in the same order. */
/* Returns false if any reference cannot be resolved unambiguously. */
fb_resolve_ref(%_o, %_ref):=block([%_idx],
  if integerp(%_ref) then return(%_ref),
  if listp(%_ref) then (
    %_idx: map(lambda([%_r], fb_resolve_ref(%_o, %_r)), %_ref),
    return(if member(false, %_idx) then false else %_idx)
  ),
  %_idx: sublist_indices(%_o, lambda([%_x], %_x[2] = %_ref)),
  if length(%_idx) # 1 then return(false),
  first(%_idx)
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-"contact" */
/* Direction convention for a "contact" object's stored direction o[4]: it points OUTWARD from
   the free body, away from the support/environment (e.g. straight down into the floor for a
   body resting on the ground, or radially outward from a circle's center through the contact
   point) - NOT into the body. A frictionless point contact can only push, never pull, so a
   correctly entered reaction (pointing from the support INTO the body, i.e. opposite o[4]) must
   have a NEGATIVE scalar product with o[4]; zero or positive means the student entered a
   tension/pulling force, which is physically impossible for this kind of contact and is now
   flagged below. (Existing "contact" sketches authored before this convention was fixed may
   have o[4] pointing the other way - into the body - and need their direction negated to keep
   passing this check; see the wiki TODO for fb_contact()/"contact".) */
fb_contact(%_o, %_n, %_i, %_description):=block(
    [%_txt: %_description, %_ref, %_j, %_jlist, %_pending, %_names, %_R, %_mn, %_dR, %_dC,
     str_environment: castext("[[lang code='de']]Umgebung[[/lang]][[lang code='en,other']]environment[[/lang]]"),
     str_and: castext("[[lang code='de']] und [[/lang]][[lang code='en,other']] and [[/lang]]"),
     str_is_not_deactivated: castext("[[lang code='de']] ist nicht deaktiviert.[[/lang]][[lang code='en,other']] is not deactivated.[[/lang]]"),
     str_are_not_deactivated: castext("[[lang code='de']] sind nicht deaktiviert.[[/lang]][[lang code='en,other']] are not deactivated.[[/lang]]"),
     str_no_reaction: castext("[[lang code='de']]Keine Reaktion gefunden.[[/lang]][[lang code='en,other']]No reaction found.[[/lang]]"),
     str_more_than_one: castext("[[lang code='de']]Mehr als eine Reaktion gefunden.[[/lang]][[lang code='en,other']]More than one reaction found.[[/lang]]"),
     str_must_be_force: castext("[[lang code='de']]Die Reaktion muss eine Kraft sein.[[/lang]][[lang code='en,other']]The reaction must be a force.[[/lang]]"),
     str_wrong_direction_pre: castext("[[lang code='de']]Die Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
     str_wrong_direction_post: castext("[[lang code='de']]\\) hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]\\) does not have the correct direction.[[/lang]]"),
     str_must_be_compressive_pre: castext("[[lang code='de']]Die Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
     str_must_be_compressive_post: castext("[[lang code='de']]\\) muss eine Druckkraft sein.[[/lang]][[lang code='en,other']]\\) must be a compressive force.[[/lang]]"),
     str_found_pre: castext("[[lang code='de']]Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
     str_found_post: castext("[[lang code='de']]\\) gefunden.[[/lang]][[lang code='en,other']]\\) found.[[/lang]]")],
    /* Is object i a contact? */
    if ( %_o[%_i][1] # "contact" ) then return ([sconcat(%_txt, "object ", string(%_i), " is not a contact."), false]),
    /* Resolve the referenced (cut-away) object(s) - targetRef may be a single name/index or a
       list of several (see fb_resolve_ref) */
    %_ref: %_o[%_i][5],
    %_j: fb_resolve_ref(%_o, %_ref),
    if %_j = false then return ([sconcat(%_txt, "fb_contact(): referenced object '",
      if stringp(%_ref) then %_ref else string(%_ref), "' not found or ambiguous."), false]),
    %_jlist: if listp(%_j) then %_j else [%_j],
    /* Are ALL referenced objects de-activated? */
    %_pending: sublist(%_jlist, lambda([%_k], last(%_o[%_k]) # "hide")),
    if %_pending # [] then (
      %_names: map(lambda([%_k], if %_o[%_k][2] = "" then str_environment else %_o[%_k][2]), %_pending),
      return ([castext_concat(%_txt, castext_concat(simplode(%_names, str_and),
        if length(%_pending) = 1 then str_is_not_deactivated else str_are_not_deactivated)), false])
    ),
    /* Any reactions found at i? */
    if not listp(%_n[%_i]) or %_n[%_i]=[] then return([castext_concat(%_txt, str_no_reaction), false]),
    /* Exactly 1 reaction found? */
    if (length(%_n[%_i]) > 1) then return( [castext_concat(%_txt, str_more_than_one), false]),
    /* Is the reaction a force? */
    if ( %_o[%_n[%_i][1]][1] # "force" ) then return ([castext_concat(%_txt, str_must_be_force), false]),
    %_R: %_o[%_n[%_i][1]],
    %_mn: %_n[%_n[%_i][1]],
    /* Is the force normal to the contact? */
    if not parallelp(%_R, %_o[%_i]) then return ([castext_concat(%_txt, sconcat(str_wrong_direction_pre, %_mn, str_wrong_direction_post)),false]),
    /* Does it push (compression), not pull (tension)? See the convention note above. */
    %_dR: direction(%_R), %_dC: direction(%_o[%_i]),
    if is(%_dR[1]*%_dC[1] + %_dR[2]*%_dC[2] >= 0) then
      return ([castext_concat(%_txt, sconcat(str_must_be_compressive_pre, %_mn, str_must_be_compressive_post)),false]),
    /* everything should be ok here */
    return([castext_concat(%_txt, sconcat(str_found_pre, %_mn, str_found_post)),true])
);

/* https://github.com/mkraska/meclib/wiki/fb_reaction_name */
/* Returns the name the student assigned to the single reaction force currently matched at
   contact/support index i, or %_default if none, more than one, or a non-force object is found
   there. Unlike fb_contact()/fb_unidir(), this never reports an error and has no [text, flag]
   shape - it is meant purely for a cosmetic dynamic label (e.g. showing the student's own name
   next to a numeric input field), falling back silently to a static placeholder name whenever
   the reaction can't yet be resolved unambiguously; use fb_contact()/fb_unidir() on the same
   index for the actual correctness check. */
fb_reaction_name(%_o, %_n, %_i, %_default):= block([],
  if not listp(%_n[%_i]) or length(%_n[%_i]) # 1 then return(%_default),
  if %_o[%_n[%_i][1]][1] # "force" then return(%_default),
  %_n[%_n[%_i][1]]
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-line-loads */
fb_q(o, n, i, description,q1,q2,le):=block(
    [varcheck, txt: description, %_v, ir, ir1, ir2, %_R, mag, a0, xref, Rref, lm,
     str_not_deactivated: castext("[[lang code='de']]ist nicht deaktiviert.[[/lang]][[lang code='en,other']]is not deactivated.[[/lang]]"),
     str_no_reaction: castext("[[lang code='de']]Keine Resultierende gefunden.[[/lang]][[lang code='en,other']]No resultant found.[[/lang]]"),
     str_not_a_force: castext("[[lang code='de']] ist keine Kraft.[[/lang]][[lang code='en,other']] is not a force.[[/lang]]"),
     str_too_many_pre: castext("[[lang code='de']]Höchstens zwei Resultierende sind sinnvoll. Gefunden wurden mehr:<br>[[/lang]][[lang code='en,other']]At most two resultants make sense. More were found:<br>[[/lang]]"),
     str_constant_load: castext("[[lang code='de']]Bei konstanter Streckenlast sollte eine Resultierende ausreichen.[[/lang]][[lang code='en,other']]For a constant line load, one resultant should be sufficient.[[/lang]]"),
     str_triangular_load: castext("[[lang code='de']]Bei einer Dreiecks-Streckenlast sollte eine Resultierende ausreichen.[[/lang]][[lang code='en,other']]For a triangular line load, one resultant should be sufficient.[[/lang]]"),
     str_ok: castext("[[lang code='de']]Resultierende OK[[/lang]][[lang code='en,other']]Resultant OK[[/lang]]")],
    /* Is object a line load? */
    if not member(o[i][1], ["q"])
       then return ([sconcat(txt, "object ", string(i), " (",o[i][1],") is not a line load."), false]),
    /* Resultant force */
    %_v: o[i][5]-o[i][4],
    mag: (cabs(%_v[1]+%i*%_v[2]))*le*(q1+q2)/2, a0: carg(%_v[1]+%i*%_v[2]),
    xref: (o[i][4]*(2/3*q1+q2/3)+o[i][5]*(q1/3+2/3*q2))/(q1+q2),
    Rref: [ "force", mag, xref, xref+[-sin(a0+o[i][8]*pi/180), -cos(a0+o[i][8]*pi/180)] ],
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
    /* forces only?*/
    lm: sublist(n[i], lambda ([x], o[x][1]="moment")),
    if ( length(lm) # 0 ) then (
        /* NOTE: this concatenates each matched moment's {@n[ir]@} directly adjacent to the
           next, with no separator - a pre-existing formatting gap (visible only when more
           than one moment is present), left as current behaviour here, not fixed. */
        for ir in lm do txt: castext_concat(txt, castext("{@n[ir]@}") ),
        return ([castext_concat(txt, str_not_a_force),false])
    ),
    if (length(n[i]) =1) then (     /* just one reaction */
      /* correct direction? */
      ir: n[i][1],
      if abs(angle(Rref, o[ir]))>0.01 then
        return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not have the correct direction.[[/lang]]") ) ,false]),
      /* correct set of variables in the expression */
      varcheck: fb_vars(n[ir], mag, []),
      if varcheck # "" then return( [
	  castext_concat( castext_concat( txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} hat nicht den richtigen Betrag. [[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not have the correct magnitude. [[/lang]]") ), varcheck),
          false]),
      /* correct value (comparison requires consistent set of variables) */
      if abs((mag-n[ir])/mag)>0.01 then
         return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} hat nicht den richtigen Betrag.[[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not have the correct magnitude.[[/lang]]") ) ,false]),
      /* correct position? */
      if abs(moment_of_force(xref, o[ir], 1, 1) ) > 0.01 then
        return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} geht nicht durch den Schwerpunkt.[[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not pass through the centroid.[[/lang]]") ) ,false])
    ) else ( /* two resultants, should be a trapezoidal load */
      /* just two resultants? */
      if (length(n[i]) >2) then (
        %_R: fb_strip_list(makelist(n[n[i][ir]], ir, 1, length(n[i]) ) ),
        return([lreduce(castext_concat, [txt, str_too_many_pre, %_R ] ), false])
      ),
      if q1 = q2 then return([castext_concat(txt, str_constant_load) ,false]),
      if q1*q2 =0 then return([castext_concat(txt, str_triangular_load) ,false]),
      /* correct direction? */
      ir1: n[i][1], ir2: n[i][2],
      if abs(angle(Rref, o[ir1]))>0.01 then
        return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir1]@} hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]Resultant {@n[ir1]@} does not have the correct direction.[[/lang]]") ) ,false]),
      if abs(angle(Rref, o[ir2]))>0.01 then
        return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir2]@} hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]Resultant {@n[ir2]@} does not have the correct direction.[[/lang]]") ) ,false]),
      /* correct value */
      varcheck: fb_vars(n[ir1], mag, []),
      if varcheck # "" then return([ castext_concat( castext_concat( txt, castext("[[lang code='de']]Die Resultierende {@n[ir1]@} kann nicht stimmen. [[/lang]][[lang code='en,other']]Resultant {@n[ir1]@} cannot be correct. [[/lang]]") ), varcheck) ,false]),
      varcheck: fb_vars(n[ir2], mag, []),
      if varcheck # "" then return([ castext_concat( castext_concat( txt, castext("[[lang code='de']]Die Resultierende {@n[ir2]@} kann nicht stimmen. [[/lang]][[lang code='en,other']]Resultant {@n[ir2]@} cannot be correct. [[/lang]]") ), varcheck) ,false]),
      if abs((mag-n[ir1]-n[ir2])/mag)>0.01 then
         return([castext_concat(txt, castext("[[lang code='de']]Die Summe der Resultierenden {@n[ir1]+n[ir2]@} hat nicht den richtigen Wert. [[/lang]][[lang code='en,other']]The sum of the resultants {@n[ir1]+n[ir2]@} does not have the correct value. [[/lang]]") ) ,false]),
      /* correct position? */
      if abs((moment_of_force(xref, o[ir1], n[ir1], 1) + moment_of_force(xref, o[ir2], n[ir2], 1))/mag ) > 0.01 then
        return( [castext_concat(txt, castext("[[lang code='de']]Pr&uuml;fen Sie die Lage der Resultierenden. Der gemeinsame Schwerpunkt entspricht nicht der Streckenlast. <br>{@n[ir1]@}, {@n[ir2]@}[[/lang]][[lang code='en,other']]Check the position of the resultants. Their common centroid does not match the line load. <br>{@n[ir1]@}, {@n[ir2]@}[[/lang]]") ) ,false])
    ),
   [castext_concat(txt, str_ok) ,true]
);

/* Which end of a "bar" object a force's own application point (R[3]) is anchored at, by
   coordinate match within a small tolerance (sketches are grid-snapped, so a correctly
   dragged reaction lands exactly on the bar's endpoint): 1 for the bar's own point 3, 2
   for point 4, 0 if it matches neither (not expected in normal use - e.g. it was never
   moved onto the bar at all). Used only by fb_bar()'s "2" (two-force member) option. */
fb_bar_end(%_bar, %_R):= block([%_p3: %_bar[3], %_p4: %_bar[4], %_rp: %_R[3], %_tol: 0.1],
  if sqrt((%_rp[1]-%_p3[1])^2+(%_rp[2]-%_p3[2])^2) < %_tol then 1
  elseif sqrt((%_rp[1]-%_p4[1])^2+(%_rp[2]-%_p4[2])^2) < %_tol then 2
  else 0
);

/* Does the force point AWAY from the bar at the given end (tension, not compression)? end
   must be 1 or 2, as returned by fb_bar_end(). */
fb_bar_tension_ok(%_bar, %_R, %_end):= block([%_bd: direction(%_bar), %_rd: direction(%_R), %_ref],
  %_ref: if %_end=1 then -%_bd else %_bd,
  is(%_rd[1]*%_ref[1]+%_rd[2]*%_ref[2] > 0)
);

/* https://github.com/mkraska/meclib/wiki/fb_bar */
/* opt may contain "T" (single-force case only: also check the reaction's sign, i.e. that
   it is defined as tension rather than compression) and/or "2" (two-force-member case: the
   bar is cut free at BOTH ends at once, expecting one reaction at each end, sharing the
   bar's own name - the free-body cut used for the method of joints/sections. Both ends are
   always checked for the correct tension sign in this case - unlike the single-force case,
   this isn't gated by "T", since a two-force member's whole point is that both ends must
   be tension (or both compression, with the sign flipped) together; "T" is simply not
   consulted when "2" is set.) */
fb_bar(o, n, i, [opt]):=block(
    [txt, R, R1, R2, name, testT, test2, L, e1, e2,
     str_bar_pre: castext("[[lang code='de']]Stab [[/lang]][[lang code='en,other']]Bar [[/lang]]"),
     str_not_deactivated: castext("[[lang code='de']]Nicht deaktiviert.[[/lang]][[lang code='en,other']]Not deactivated.[[/lang]]"),
     str_no_match_pre: castext("[[lang code='de']]Keine Stabkraft mit passendem Namen (mit Index [[/lang]][[lang code='en,other']]No bar force with a matching name (with index [[/lang]]"),
     str_no_match_post: castext("[[lang code='de']]) gefunden.[[/lang]][[lang code='en,other']]) found.[[/lang]]"),
     str_not_parallel: castext("[[lang code='de']] ist nicht parallel zum Stab.[[/lang]][[lang code='en,other']] is not parallel to the bar.[[/lang]]"),
     str_not_tension: castext("[[lang code='de']] ist nicht als Zugkraft definiert.[[/lang]][[lang code='en,other']] is not defined as a tensile force.[[/lang]]"),
     str_ok: castext("[[lang code='de']] OK.[[/lang]][[lang code='en,other']] OK.[[/lang]]"),
     str_fewer_than_two: castext("[[lang code='de']]Weniger als zwei Stabkräfte mit passendem Namen gefunden.[[/lang]][[lang code='en,other']]Fewer than two bar forces with a matching name found.[[/lang]]"),
     str_more_than_two: castext("[[lang code='de']]Mehr als zwei Stabkräfte mit passendem Namen gefunden.[[/lang]][[lang code='en,other']]More than two bar forces with a matching name found.[[/lang]]"),
     str_not_at_end: castext("[[lang code='de']] greift an keinem Stabende an.[[/lang]][[lang code='en,other']] does not act at either end of the bar.[[/lang]]"),
     str_same_end: castext("[[lang code='de']] greifen beide am selben Stabende an. An jedem Stabende sollte eine Stabkraft angreifen.[[/lang]][[lang code='en,other']] both act at the same end of the bar. One bar force should act at each end.[[/lang]]"),
     str_name_mismatch: castext("[[lang code='de']] haben unterschiedliche Namen. Als Freischnitt desselben Stabes sollten beide denselben Namen tragen.[[/lang]][[lang code='en,other']] have different names. As the free-body cut of the same bar, both should carry the same name.[[/lang]]")],
	/* Extract options */
    if length(opt) = 1 then opt: string(opt[1]) else opt: "",
    testT: member("T", charlist(opt)),
    test2: member("2", charlist(opt)),
    /* Is object i a bar? */
    if o[i][1]  # "bar" then return ([sconcat("object ", string(i), " (",o[i][1],") is not a bar."), false]),
    /* Has the object a name? The name is used later to identify associated reactions. */
    name: o[i][2],
    if name = "" then return ([ sconcat("object #", string(i), " has no name."), false]),
    txt: castext_concat(str_bar_pre, sconcat(name, ": ")),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Extract forces with matching name*/
    if listp(n[i]) then L: sublist (n[i], lambda ([x], o[x][1]="force" and split(o[x][2],"_")[2] = name )) else L: [],
    /* Check number of forces */
    if L = [] then return ([castext_concat(txt, sconcat(str_no_match_pre, name, str_no_match_post)) , false]),
    /* Single force required */
    if not test2 then (
      R: o[L[1]],
      /* force parallel to bar? */
      if not parallelp(R, o[i]) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_parallel)),false]),
      /* eventually complaining about wrong direction */
      if testT and (abs(angle(R, o[i])) > 0.1) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_tension)), false] ),
      return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_ok)), true] )
    ) else (
      /* Two-force member: exactly one reaction anchored at EACH end, both pointing
         outward along the bar (tension), sharing the bar's own name. */
      if length(L) < 2 then return ([castext_concat(txt, str_fewer_than_two), false]),
      if length(L) > 2 then return ([castext_concat(txt, str_more_than_two), false]),
      R1: o[L[1]], R2: o[L[2]],
      /* The two reactions are the Newton's-third-law pair at the member's two cut ends, so
         they should carry the same (student-chosen) object name - unlike fb_fix12(), which
         requires its two reactions to have DIFFERENT names because those are two distinct
         unknowns. */
      if R1[2] # R2[2] then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}, {@n[L[2]]@}"), str_name_mismatch)),false]),
      if not parallelp(R1, o[i]) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_parallel)),false]),
      if not parallelp(R2, o[i]) then return ([castext_concat(txt, castext_concat(castext("{@n[L[2]]@}"), str_not_parallel)),false]),
      e1: fb_bar_end(o[i], R1), e2: fb_bar_end(o[i], R2),
      if e1 = 0 then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_at_end)), false]),
      if e2 = 0 then return ([castext_concat(txt, castext_concat(castext("{@n[L[2]]@}"), str_not_at_end)), false]),
      if e1 = e2 then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}, {@n[L[2]]@}"), str_same_end)), false]),
      if not fb_bar_tension_ok(o[i], R1, e1) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_tension)), false]),
      if not fb_bar_tension_ok(o[i], R2, e2) then return ([castext_concat(txt, castext_concat(castext("{@n[L[2]]@}"), str_not_tension)), false]),
      return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}, {@n[L[2]]@}"), str_ok)), true])
    )
);

/* https://github.com/mkraska/meclib/wiki/fb_bar_name */
fb_bar_name(%_o, %_n, %_i):=block(
  [%_str,%_R,%_nl,%_OK,%_var, %_bl,
   str_multiletter: castext("[[lang code='de']]Physikalische Gr&ouml;&szlig;en immer nur mit einem Buchstabe und eventuell Index schreiben, z.B. <code>F_1</code>.[[/lang]][[lang code='en,other']]Always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>.[[/lang]]"),
   str_sensible_names: castext("[[lang code='de']]Sinnvolle Namen für eine Stabkraft sind \\(F\\) (Kraft), \\(N\\) (Normalkraft) oder \\(S\\) (Stabkraft)[[/lang]][[lang code='en,other']]Sensible names for a bar force are \\(F\\) (force), \\(N\\) (normal force), or \\(S\\) (bar force)[[/lang]]"),
   str_index_mismatch_pre: castext("[[lang code='de']]Der Index [[/lang]][[lang code='en,other']]The index [[/lang]]"),
   str_index_mismatch_mid: castext("[[lang code='de']] passt nicht zum Stabname [[/lang]][[lang code='en,other']] does not match the bar's name [[/lang]]")],
  /* are the values consistent? */
  if length(%_n) # length(%_o) then return(sconcat("length(o)= ",length(%_o), " length(n)=", length(%_n))),
  if length(%_n) < %_i then return(sconcat("length(n)= ",length(%_n), " <", %_i)),
  /* is the object a bar */
  if not member(%_o[%_i][1], ["bar"]) then return ([sconcat("object ", %_i, " is not of type 'bar'"), false]),
  /* Is object i de-activated */ 
  if debug then %_str: sconcat("object ", %_i, " is not deactivated (debug message)" ) else %_str: "",
  if ( last(%_o[%_i]) # "hide") then return ([%_str, false]),
  /* Any reactions found at i? */
  if debug then %_str: sconcat("no reaction found at object ", %_i, " (debug message)" ) else %_str: "",
  if not listp(%_n[%_i]) or %_n[%_i]=[] then return([%_str, false]),
  /* Exactly 1 reaction found? */
  if debug then %_str: sconcat("more than one reaction found ", %_n[%_i], " (debug message)" ) else %_str: "",
  if (length(%_n[%_i]) > 1) then return( [%_str, false]),  
  /* now we know it is a single reaction */ 
  %_R: %_o[%_n[%_i][1]],
  %_var: %_n[%_n[%_i][1]],
  /* Is the reaction a force? */
  if debug then %_str: sconcat("Reaction ", %_R[2], " is not a force (debug message)" ) else	 %_str: "",
  if %_R[1] # "force" then return( [%_str, false]), 
  /* now we have a valid reaction, the remainder is about naming */
  %_str: "",
  %_OK: true,
  /* Extract name parts */
  %_nl: split(%_R[2],"_"),
  /* base name single character? */    
  if slength(%_nl[1]) > 1 then [ %_str, %_OK ]:
    [ castext_concat(castext("<br>{@%_var@}: "), str_multiletter), false ],
  /* base name a sensible character? (F-Kraft, N-Normalkraft, S-Stabkraft)  */
  if not member(charlist(%_nl[1])[1], ["F", "N", "S" ])  then [ %_str, %_OK ]:
    [ castext_concat( %_str, castext_concat(castext("<br>{@%_var@}: "), str_sensible_names) ), false ],
  /* label of the bar */
  %_bl: %_o[%_i][2],
  if %_bl # "" then (
    /* the label is not empty */
    if length(%_nl) = 2 then /* the reaction should have an index */
      if %_bl # %_nl[2] then /* the index and the label don't match */
        [ %_str, %_OK ]:
    [ castext_concat( %_str, castext_concat(castext("<br>"), castext_concat(str_index_mismatch_pre, castext_concat(castext("{@%_nl[2]@}"), castext_concat(str_index_mismatch_mid, castext("{@%_bl@}."))))))
, false ]
  ),
      
  [%_str, %_OK]
);

/* https://github.com/mkraska/meclib/wiki/fb_name */
fb_name(n,i,lon,[opt]):=block([name,txt,%_namestex,%_show,%_lonstr,
  str_or: castext("[[lang code='de']] oder [[/lang]][[lang code='en,other']] or [[/lang]]"),
  str_no_match_post: castext("[[lang code='de']] \\) ist kein passender Name.[[/lang]][[lang code='en,other']] \\) is not an acceptable name.[[/lang]]"),
  str_no_match_list_mid: castext("[[lang code='de']] \\) ist kein passender Name. Akzeptiert: [[/lang]][[lang code='en,other']] \\) is not an acceptable name. Accepted: [[/lang]]")],
  /* str_* above are fully static and safe to hoist here. name/%_namestex only get their real
     value further down, so the dynamic part is plain-concatenated at each point of use below
     instead of being embedded inside a castext() call - this keeps every piece of translatable
     text in exactly one place at the top of the function, regardless of when the dynamic value
     becomes available. */
  name: none,
  if listp(n[i]) and  not emptyp(n[i]) then name: n[n[i][1]] else return(["", false]),
  /* the resolved name from the live `names` array may be a CAS symbol (algebraic input) or a
     string, and lon may be written either way too (e.g. ["N_A","A"] or [N_A,A]) - normalize
     both sides to plain strings before comparing, since a symbol and a string of the same
     spelling are never equal to Maxima's member(). */
  %_lonstr: map(lambda([%_x], if stringp(%_x) then %_x else string(%_x)), lon),
  if member(if stringp(name) then name else string(name), %_lonstr) then return( ["",true]),
  %_show: if opt=[] then true else opt[1],
  if not %_show then return([sconcat("\\(", name, str_no_match_post), false]),
  %_namestex: if length(lon)=1 then sconcat("\\(",lon[1],"\\)")
    else sconcat(simplode(map(lambda([%_x], sconcat("\\(",%_x,"\\)")), rest(lon,-1)), ", "), str_or, "\\(", last(lon), "\\)"),
  return([sconcat("\\(", name, str_no_match_list_mid, %_namestex, "."), false])
);

/* https://github.com/mkraska/meclib/wiki/fb_reactions() */
fb_reactions(%_o, %_f, %_m):=block(
  [%_fnum, %_mnum, %_txt, %_OK, %_msgs,
   str_count_ok: castext("[[lang code='de']]Die Zahl der Reaktionen stimmt.[[/lang]][[lang code='en,other']]The number of reactions is correct.[[/lang]]"),
   str_force_count_wrong: castext("[[lang code='de']]Die Zahl der Reaktionskräfte stimmt nicht.[[/lang]][[lang code='en,other']]The number of reaction forces is incorrect.[[/lang]]"),
   str_moment_count_wrong: castext("[[lang code='de']]Die Zahl der Reaktionsmomente stimmt nicht.[[/lang]][[lang code='en,other']]The number of reaction moments is incorrect.[[/lang]]")],
  %_fnum: length(sublist_indices (%_o, lambda ([x], x[1]="force" and last(x)="active" and  not sposition(" ",x[2])))),
  %_mnum: length(sublist_indices (%_o, lambda ([x], x[1]="moment" and last(x)="active"))),
  if (%_fnum=%_f) and (%_mnum=%_m) then [%_txt, %_OK]: [str_count_ok,true] else (
    %_OK: false, %_msgs: [],
    if %_fnum # %_f then %_msgs: endcons(str_force_count_wrong, %_msgs),
    if %_mnum # %_m then %_msgs: endcons(str_moment_count_wrong, %_msgs),
    %_txt: simplode(%_msgs, "<br>")
  ),
  [%_txt,%_OK]
);

/* https://github.com/mkraska/meclib/wiki/fb_force() */
/* General-purpose feedback check for a single active force that is not tied to any particular
   contact/support index (use fb_contact()/fb_bar() for those instead) - e.g. a weight force or
   a resultant the student places freely via forceGen:
     %_name   - the expected object name, as a string, or a list of strings if several names
                would be equally acceptable (e.g. "G" or "F_G")
     %_point  - a point the force's line of action must pass through
     %_dir    - the expected direction, either a number (angle in degrees, standard math
                convention: 0 = +x axis, 90 = +y axis) or a direction vector [dx, dy]
     %_toldeg  - direction tolerance in degrees
     %_toldist - tolerance for the line of action's distance from %_point, either a bare number
                 (compared directly against the sketch's own coordinate units, as the deviation
                 from moment_of_force() naturally comes out) or a [tol, "unit"] list (e.g.
                 [0.01,"mm"]) - in that case the sketch-unit deviation is converted using the
                 grid object's [fx,fy] scaling factor (see the "grid" wiki page; object 1 must
                 be the grid, and fx must equal fy - any geometry sketch must be scaled equally
                 in x and y, so a mismatch is reported as a question-authoring/developer error,
                 not student feedback) and the deviation is reported together with that unit
     %_description - text prefix for the feedback, as elsewhere
   On a direction or distance mismatch, the actual deviation is reported as a rounded value, the
   same way fb_unit() reports a numeric deviation as a rounded percentage. */
fb_force(%_o, %_name, %_point, %_dir, %_toldeg, %_toldist, %_description):=block(
  [%_txt: %_description, %_names, %_namestex, %_idx, %_i, %_dref, %_devDeg, %_devDist, %_mn,
   %_toldistval, %_tolunit, %_fx, %_fy,
   str_or: castext("[[lang code='de']] oder [[/lang]][[lang code='en,other']] or [[/lang]]"),
   str_notfound_pre: castext("[[lang code='de']]Keine Kraft [[/lang]][[lang code='en,other']]No force [[/lang]]"),
   str_ambiguous_pre: castext("[[lang code='de']]Mehr als eine Kraft [[/lang]][[lang code='en,other']]More than one force [[/lang]]"),
   str_notfound_post: castext("[[lang code='de']] gefunden.[[/lang]][[lang code='en,other']] found.[[/lang]]"),
   str_wrong_direction_mid: castext("[[lang code='de']]\\) hat nicht die richtige Richtung. Richtungsabweichung: [[/lang]][[lang code='en,other']]\\) does not have the correct direction. Direction deviation: [[/lang]]"),
   str_wrong_line_pre: castext("[[lang code='de']]Die Wirkungslinie von \\([[/lang]][[lang code='en,other']]The line of action of \\([[/lang]]"),
   str_wrong_line_mid: castext("[[lang code='de']]\\) geht am richtigen Angriffspunkt vorbei. Abstand: [[/lang]][[lang code='en,other']]\\) misses the correct point of application. Distance: [[/lang]]"),
   str_found_post: castext("[[lang code='de']]\\) gefunden.[[/lang]][[lang code='en,other']]\\) found.[[/lang]]")],
  %_names: if listp(%_name) then %_name else [%_name],
  /* %_names holds variable names (e.g. "G", "F_G") - these must render as LaTeX math, like %_mn
     further down, not as plain text (which loses the subscript and looks inconsistent). */
  %_namestex: simplode(map(lambda([%_x], sconcat("\\(", %_x, "\\)")), %_names), str_or),
  %_idx: sublist_indices(%_o, lambda([%_x], %_x[1]="force" and member(%_x[2],%_names) and last(%_x)="active")),
  /* All str_* above are fully static and safe to hoist at the top. The remaining messages below
     each reference a local variable (%_namestex, %_mn, %_devDeg, %_devDist, %_tolunit) that only
     gets its real value here in the body - that dynamic part is plain-concatenated at the point
     of use instead of being embedded inside a castext() call, so every piece of translatable
     text still lives in exactly one place at the top of the function. */
  if length(%_idx) = 0 then return([castext_concat(%_txt, sconcat(str_notfound_pre, %_namestex, str_notfound_post)), false]),
  if length(%_idx) > 1 then return([castext_concat(%_txt, sconcat(str_ambiguous_pre, %_namestex, str_notfound_post)), false]),
  %_i: first(%_idx),
  %_mn: %_o[%_i][2],
  %_dref: if listp(%_dir) then ["force", 1, [0,0], %_dir]
          else ["force", 1, [0,0], [cos(%_dir*%pi/180), sin(%_dir*%pi/180)]],
  /* correct direction? report the deviation itself, rounded, rather than just pass/fail. */
  %_devDeg: ev(round(angle(%_dref, %_o[%_i])*180/%pi*10)/10.0, simp),
  if abs(%_devDeg) > %_toldeg then
    return([castext_concat(%_txt, sconcat("\\(", %_mn, str_wrong_direction_mid, %_devDeg, "°.")), false]),
  /* correct line of action (through %_point)? moment_of_force() with a force magnitude of 1 is
     exactly the signed perpendicular distance from %_point to the line of action, so it can be
     rounded and reported directly, the same way as %_devDeg above. */
  %_devDist: ev(round(moment_of_force(%_point, %_o[%_i], 1, 1)*10)/10.0, simp),
  if listp(%_toldist) then (
    if %_o[1][1] # "grid" then
      return([sconcat("fb_force(): object 1 is not a \"grid\" - cannot determine the scaling factor for a unit-tagged toldist."), false]),
    [%_fx, %_fy]: %_o[1][9],
    if %_fx # %_fy then
      return([sconcat("fb_force(): grid scaling factors fx (", string(%_fx), ") and fy (", string(%_fy), ") differ - a unit-tagged toldist requires equal x/y scaling."), false]),
    %_toldistval: %_toldist[1], %_tolunit: %_toldist[2],
    %_devDist: ev(round(%_devDist*%_fx*10)/10.0, simp),
    if abs(%_devDist) > %_toldistval then
      return([castext_concat(%_txt, sconcat(str_wrong_line_pre, %_mn, str_wrong_line_mid, %_devDist, " ", %_tolunit, ".")), false])
  ) else (
    if abs(%_devDist) > %_toldist then
      return([castext_concat(%_txt, sconcat(str_wrong_line_pre, %_mn, str_wrong_line_mid, %_devDist, ".")), false])
  ),
  [castext_concat(%_txt, sconcat("\\(", %_mn, str_found_post)), true]
);

/* https://github.com/mkraska/meclib/wiki/fb_system() */
/* %_names[%_i] is either a state string ("show"/"hide"/"SHOW"/"HIDE") or, once loads have been
   matched to the object, a list of load indices - stringp() guards sdowncase() against the latter. */
fb_system(%_names, %_sys, %_env, %_hint):=block(
  [%_i, %_str_ok: castext("[[lang code='de']]Die Systemgrenzen stimmen. [[/lang]][[lang code='en,other']]The system boundaries are correct. [[/lang]]"),
        %_str_wrong: castext("[[lang code='de']]Die Systemgrenzen stimmen nicht. [[/lang]][[lang code='en,other']]The system boundaries are incorrect. [[/lang]]"),
        %_fb, %_fbfalse],
  %_fb: [%_str_ok, true],
  %_fbfalse: [sconcat(%_str_wrong, %_hint), false],
  for %_i in %_env do if (stringp(%_names[%_i]) and sdowncase(%_names[%_i]) = "show") then %_fb: %_fbfalse,
  return(%_fb)
);

/* https://github.com/mkraska/meclib/wiki/MatchByParallel%28%29 */
matchByParallel(o,n):=block([res, llist],res: [],
    /* for all objects */
    for i:1 thru length(o) do (
        /* if names entry is not a list, copy it to result */
        if (not listp(n[i])) then res: endcons(n[i], res) else (
            /* either a nondirectional item or parallel to the force */
            llist: sublist(n[i], 
                lambda([x], 
                    member(o[i][1], [ "fix12, fix123", "circle"]) or
                    parallelp(o[i], o[x] )
                )
            ),
            res: endcons(llist, res)
        )
    ),
    return(res)
);
