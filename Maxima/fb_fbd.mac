/* https://github.com/mkraska/meclib/wiki/Feedback-for-Free-Body-Diagrams */
fb_fbd_version: "2026 10 23";

/* https://github.com/mkraska/meclib/wiki/fb_objects() */
/* fb_objects(objects): the content of the objects input (JSON of meclib's object list) as a
   Maxima list - the same as STACK's stackjson_parse(objects), but in one pass: stackjson_parse
   needs time growing with the square of the length (about 1 s for a sketch of 30 objects, in
   every PRT). JSON objects ({...}) are left to stackjson_parse. */
/* fb_lang(de, en): a text in German and English, as castext("[[lang code='de']]de[[/lang]]
   [[lang code='en,other']]en[[/lang]]") gives it, but without castext(): STACK compiles every
   castext literal of the question code including the includes, which costs much time at
   import and first preview (and runs is_lang() at runtime just as here). With fb_lang_tags
   true (offline tests, workbench) the [[lang]] blocks are kept, for their language switch. */
fb_lang(%_de, %_en) := if fb_lang_tags = true
  then sconcat("[[lang code='de']]", %_de, "[[/lang]][[lang code='en,other']]", %_en, "[[/lang]]")
  else sconcat(if is_lang("de") then %_de else "", if is_lang("en") or is_lang("other") then %_en else "");

fb_objects(%_objects):= block([simp: true, %_st: [[]], %_mode: 0, %_buf: [], %_esc: false, %_u: 0, %_hex: [], %_c, %_top, %_lit: []],
  /* %_mode 0: between values, 1: in a string, 2: in a number, 3: in a literal (true/false/null) */
  if not stringp(%_objects) then return(%_objects),
  if sposition("{", %_objects) # false then return(stackjson_parse(%_objects)),
  for %_c in append(charlist(%_objects), [" "]) do (
    if %_mode = 1 then (
      if %_u > 0 then (%_hex: cons(%_c, %_hex), %_u: %_u - 1,
        if %_u = 0 then %_buf: cons(unicode(stack_string_hex_to_num(simplode(reverse(%_hex)))), %_buf))
      else if %_esc then (%_esc: false,
        if %_c = "u" then (%_u: 4, %_hex: [])
        else %_buf: cons(if %_c = "n" then ascii(10) else if %_c = "t" then ascii(9) else if %_c = "r" then ascii(13)
                         else if %_c = "b" then ascii(8) else if %_c = "f" then ascii(12) else %_c, %_buf))
      else if %_c = "\\" then %_esc: true
      else if %_c = "\"" then (%_st: cons(cons(simplode(reverse(%_buf)), first(%_st)), rest(%_st)), %_mode: 0)
      else %_buf: cons(%_c, %_buf))
    else (
      /* end of a number or literal */
      if %_mode = 2 and sposition(%_c, "0123456789.eE+-") = false then (
        %_st: cons(cons(stack_string_parse_number(simplode(reverse(%_buf))), first(%_st)), rest(%_st)), %_mode: 0),
      if %_mode = 3 and not alphacharp(%_c) then (
        %_lit: simplode(reverse(%_buf)),
        %_st: cons(cons(if %_lit = "true" then true else if %_lit = "false" then false else und, first(%_st)), rest(%_st)),
        %_mode: 0),
      if %_mode = 2 or %_mode = 3 then %_buf: cons(%_c, %_buf)
      else if %_c = "[" then %_st: cons([], %_st)
      else if %_c = "]" then (%_top: reverse(first(%_st)), %_st: rest(%_st), %_st: cons(cons(%_top, first(%_st)), rest(%_st)))
      else if %_c = "\"" then (%_mode: 1, %_buf: [])
      else if %_c = "-" or digitcharp(%_c) then (%_mode: 2, %_buf: [%_c])
      else if alphacharp(%_c) then (%_mode: 3, %_buf: [%_c]))),
  if length(%_st) # 1 or length(first(%_st)) # 1 then return(stackjson_parse(%_objects)),   /* not well formed */
  first(first(%_st))
);

/* https://github.com/mkraska/meclib/wiki/direction%28%29 */
direction(o):=block([%_v, a0, le, r1, r2, a1],
  if member(o[1], ["bar", "force", "dashpot", "springt", "springc"]) then return(o[4]-o[3]),
  if member(o[1], ["fix1"]) then return([-sin(o[4]*%pi/180), cos(o[4]*%pi/180)]),
  if member(o[1], ["fix13", "dir", "disp"]) then return([cos(o[4]*%pi/180), sin(o[4]*%pi/180)]),
  if member(o[1], ["contact"]) then return(o[4]),
  if member(o[1], ["q"]) then (
    %_v: o[5]-o[4], le: cabs(%_v[1]+%i*%_v[2]), a0: carg(%_v[1]+%i*%_v[2]),
    return([cos(a0+o[8]*pi/180), sin(a0+o[8]*pi/180)]) 
    ),
  if member(o[1], ["rope"]) then (
    /* same math as in meclib */
    %_v: o[5]-o[3], le: cabs(%_v[1]+%i*%_v[2]), a0: carg(%_v[1]+%i*%_v[2]),
    r1: o[4], r2: o[6], a1: acos((r1-r2)/le),
    return(float(%_v+[(r2-r1)*cos(a0-a1), (r2-r1)*sin(a0-a1)]))
    )
);

/* https://github.com/mkraska/meclib/wiki/angle%28%29 */
angle(a,b):= block([da,db],
    da: direction(a), db: direction(b),
    if listp(da) and listp(db) then 
        return(-carg(da[1]+%i*da[2])+carg(db[1]+%i*db[2]) ) 
);

/* https://github.com/mkraska/meclib/wiki/moment_of_force%28%29 */
moment_of_force(p, f, fname, rname):=block([vf,vr],
   vf: (f[4]-f[3]),
   vf: vf/sqrt(vf[1]^2+vf[2]^2)*fname,
   vr: (f[3]-p)*rname,
   vr[1]*vf[2]-vr[2]*vf[1]
);

/* https://github.com/mkraska/meclib/wiki/Sums-of-Forces-and-Moments */
unitvec(l):=block( [v] , v:round((l[4]-l[3])*10),ratexpand(v/sqrt(v[1]^2+v[2]^2)));
msign(l):=block( [v1,v2] , v1:l[4]-l[3],v2:l[5]-l[3],round(signum(v1[1]*v2[2]-v1[2]*v2[1])));
moment(p, f, fname, rname):=block([vf,vr],
   vf: unitvec(f)*fname,
   vr: round((f[3]-p)*10)/10*rname,
   vr[1]*vf[2]-vr[2]*vf[1]);
/* Options of sumF(), sumM() (list of name = value, both optional):
     contacts = [i, ...]  forces found at these "contact" objects get the exact normal or tangent
                          direction of the contact (sense as drawn) and the contact point as point
                          of application - a drawn arrow is snapped to 0.1 and only roughly along
                          the contact; give the contact direction with exact numbers
     at = [[k, r], ...]   symbolic point of application r (in length units, like p*lu) of load k,
                          e.g. a centre of gravity that depends on symbols of the problem (sumM)
   Without options: directions of the arrows (rounded to 0.1), points of the sketch. */
/* per object: [exact direction or false, point of application or false]; a point is
   ["grid", [x,y]] (sketch coordinates) or ["len", r] (length units) */
fb_sum_prep(o, n, %_options):= block([%_get, %_dir, %_pt, %_u, %_uf, %_t, %_d, %_c, %_k, %_e],
  %_get: lambda([%_key], block([%_v: false],
    for %_e in %_options do if equationp(%_e) and string(lhs(%_e)) = %_key then %_v: rhs(%_e), %_v)),
  %_dir: makelist(false, length(o)), %_pt: makelist(false, length(o)),
  if listp(%_get("contacts")) then for %_c in %_get("contacts") do if listp(n[%_c]) then (
    %_u: o[%_c][4], %_u: ratsimp(%_u/sqrt(%_u . %_u)), %_uf: float(%_u), %_t: [-%_u[2], %_u[1]],
    for %_k in n[%_c] do if o[%_k][1] = "force" then (
      %_d: float(o[%_k][4] - o[%_k][3]), %_d: %_d/sqrt(%_d . %_d),
      if abs(%_d[1]*%_uf[2] - %_d[2]*%_uf[1]) < 0.05 then %_dir[%_k]: signum(%_d . %_uf)*%_u
      else if abs(%_d . %_uf) < 0.05 then %_dir[%_k]: signum(%_d . float(%_t))*%_t,
      if %_dir[%_k] # false then %_pt[%_k]: ["grid", o[%_c][3]])),
  if listp(%_get("at")) then for %_e in %_get("at") do %_pt[%_e[1]]: ["len", %_e[2]],
  [%_dir, %_pt]
);

/* https://github.com/mkraska/meclib/wiki/Sums-of-Forces-and-Moments */
/* sumF(o, n, d [, options]): sum of all forces projected onto the direction d - a vector, or the
   index of a "dir" object whose direction is taken. */
sumF(o, n, d, [%_options]):= block([%_pd, %_f: 0, %_v, i],
  if integerp(d) then d: direction(o[d]),
  d: ratsimp(d/sqrt(d . d)),
  %_pd: fb_sum_prep(o, n, if %_options = [] then [] else %_options[1]),
  for i: 1 thru length(o) do if o[i][1] = "force" then (
    %_v: if %_pd[1][i] # false then %_pd[1][i] else unitvec(o[i]),
    %_f: %_f + n[i]*(%_v . d)),
  ratsimp(%_f)
);
/* sumM(o, n, p, lu [, options]): sum of the moments about p (sketch coordinates) of all forces
   and moments, counterclockwise positive; lu: length unit of the sketch. */
sumM(o, n, p, lu, [%_options]):= block([%_pd, %_m: 0, %_v, %_r, i],
  %_pd: fb_sum_prep(o, n, if %_options = [] then [] else %_options[1]),
  for i: 1 thru length(o) do (
    if o[i][1] = "force" then (
      %_v: if %_pd[1][i] # false then %_pd[1][i] else unitvec(o[i]),
      if %_pd[2][i] = false then %_m: %_m + moment(p, o[i], n[i], lu)
      else (
        %_r: if %_pd[2][i][1] = "len" then %_pd[2][i][2] - p*lu else (%_pd[2][i][2] - p)*lu,
        %_m: %_m + n[i]*(%_r[1]*%_v[2] - %_r[2]*%_v[1]))),
    if o[i][1] = "moment" then %_m: %_m + n[i]*msign(o[i])),
  %_m
);
/* legacy: [sum in x, sum in y, moment about p]; takes the options of sumF() and sumM() */
sum_xyM(o, n, p, lu, [%_options]):= block([%_op: if %_options = [] then [] else %_options[1]],
  [sumF(o, n, [1,0], %_op), sumF(o, n, [0,1], %_op), sumM(o, n, p, lu, %_op)]
);

/* https://github.com/mkraska/meclib/wiki/sum_dir%28%29 */
/* Simple single-direction variant of sum_xyM: sums the scalar projections of all matched
   "force" loads in o/n onto a single given direction vector d (e.g. from direction() on a
   "dir" object). Intended for central/concurrent force systems, where only force equilibrium
   in self-chosen directions is needed and no moment term applies.
   Unlike sum_xyM (which uses unitvec()'s 0.1-grid rounding - appropriate for a hand-dragged
   force arrow, whose own JSXGraph point already snaps to the grid), the force direction here
   is normalized exactly, without that extra rounding step: it is redundant with the JSXGraph
   grid snap, and for a force at a fixed, exactly-known geometric position (as with a "dir"-based
   equilibrium direction) it would introduce its own small, spurious deviation from an otherwise
   exact perpendicularity. */
sum_dir(o,n,d):=block([f: 0, v, u],
  for i:1 thru length(o) do (
    if (o[i][1]="force") then (
      v: o[i][4]-o[i][3],
      u: v/sqrt(v[1]^2+v[2]^2),
      f: f+n[i]*(u[1]*d[1]+u[2]*d[2])
    )
  ),
  f
);

/* https://github.com/mkraska/meclib/wiki/parallelp%28%29 */
parallelp(a,b):= block([da,db],
    da: direction(a), db: direction(b),
    if listp(da) and listp(db) then
        return(is (abs(da[1]*db[2]-da[2]*db[1])<0.05) )
);

/* https://github.com/mkraska/meclib/wiki/perpendicularp%28%29 */
perpendicularp(a,b):= block([da,db],
    da: direction(a), db: direction(b),
    if listp(da) and listp(db) then
        return(is (abs(da[1]*db[1]+da[2]*db[2])<0.05) )
);

/* https://github.com/mkraska/meclib/wiki/contributor%28%29 */
/* Purely formative helper for a direction-choice PRT (no grading effect of its own): lists the
   names of every "force" object in o (regardless of state - an external force, a recognized
   reaction, or a reaction the student placed somewhere a "contact" doesn't recognize) that will
   actually contribute a non-negligible term when summed along the direction of the "dir" object
   at index i_dir, i.e. when o is later passed to sum_dir(o, n, direction(o[i_dir])).
   Deliberately does NOT reuse perpendicularp(), which compares the RAW (non-normalized)
   direction() vectors - for a "force" object that vector is o[4]-o[3], whose length depends on
   how long the student happened to drag the arrow, so a fixed threshold on that raw dot product
   is not meaningfully comparable across forces of different length. Instead this recomputes the
   same normalized projection coefficient sum_dir itself would use (unit force vector dotted with
   the direction), and compares its absolute value against tol directly - so tol is on the same
   footing as the coefficient tolerance already used in fb_coeffs.
   Returns the list of names (n[i]) of the contributing forces, ready for fb_strip_list(); an
   empty list means every force present is (numerically) perpendicular to this direction. */
contributor(o, n, i_dir, tol):= block([d: direction(o[i_dir]), v, u, result: []],
  for i: 1 thru length(o) do (
    if o[i][1] = "force" then (
      v: o[i][4]-o[i][3],
      u: v/sqrt(v[1]^2+v[2]^2),
      if abs(u[1]*d[1]+u[2]*d[2]) > tol then result: cons(n[i], result)
    )
  ),
  reverse(result)
);

/* https://github.com/mkraska/meclib/wiki/fb_dir */
/* Feedback for one or two direction-choice PRTs, combining contributor()'s formative listing for
   each direction with, when two directions are given, a check that they aren't parallel: if they
   are, the resulting equilibrium equations would be linearly dependent - that is a genuine
   mistake, not just a suboptimal-but-valid choice, so the returned flag is false in that case and
   the calling PRT should apply a real grading consequence. The per-direction contributor listing
   is still appended afterwards regardless of the parallelity outcome, since it remains useful
   either way.
   %_dirs: a list of [i_dir, desc] pairs, length 1 (purely formative, flag always true - same
   behavior as the previous single-direction fb_dir()) or 2 (adds the parallelity check).
   %_desc is the phrase naming the direction, inserted as-is at the end of its sentence, e.g.
   "in 1-Richtung" (so this stays reusable in other questions/languages without hardcoding the
   direction's own name or numbering here).
   Returns [text, flag], to be dropped into a PRT node the same way as fb_fix1/fb_contact/etc. */
/* %_desc (the phrase naming the direction, see above) is supplied by the calling question
   and is NOT translated here - a question that wants this feedback in both languages must
   author %_desc itself bilingually (e.g. as its own [[lang]]-wrapped phrase), the same way a
   caller is responsible for %_description elsewhere in this file (fb_fix1 etc.). Only the
   fixed wrapper text below is converted. */
fb_dir(%_o, %_n, %_dirs, %_tol):= block([%_ok: true, %_parts: [], %_contrib, %_i, %_desc, %_sentence, %_text, %_k,
    str_parallel: fb_lang("Die gewählten Richtungen sind parallel. Damit liefern die beiden Gleichgewichtsbedingungen keine voneinander unabhängigen Gleichungen.", "The chosen directions are parallel. The two equilibrium conditions would then not provide independent equations."),
    str_none_pre: fb_lang("Keine Kraft hat Anteile ", "No force has components "),
    str_has_mid: fb_lang(" hat Anteile ", " has components "),
    str_have_mid: fb_lang(" haben Anteile ", " have components ")],
  if length(%_dirs) = 2 and parallelp(%_o[%_dirs[1][1]], %_o[%_dirs[2][1]]) then (
    %_ok: false,
    %_parts: cons(str_parallel, %_parts)
  ),
  for %_pair in %_dirs do (
    %_i: %_pair[1], %_desc: %_pair[2],
    %_contrib: contributor(%_o, %_n, %_i, %_tol),
    %_sentence: if %_contrib = [] then
        castext_concat(str_none_pre, castext_concat(%_desc, "."))
      elseif length(%_contrib) = 1 then
        castext_concat(castext_concat(fb_strip_list(%_contrib), str_has_mid), castext_concat(%_desc, "."))
      else
        castext_concat(castext_concat(fb_strip_list(%_contrib), str_have_mid), castext_concat(%_desc, ".")),
    %_parts: cons(%_sentence, %_parts)
  ),
  %_parts: reverse(%_parts),
  %_text: %_parts[1],
  for %_k: 2 thru length(%_parts) do %_text: castext_concat(%_text, castext_concat("<br>", %_parts[%_k])),
  [%_text, %_ok]
);

/* https://github.com/mkraska/meclib/wiki/fb_force_hvxy */
fb_force_hvxy(o,i):=block([dir, name, nl, base, idx,
    str_multiletter: fb_lang("\\): Physikalische Gr&ouml;&szlig;en immer nur mit einem Buchstabe und eventuell Index schreiben, z.B. <code>F_1</code>.", "\\): always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>."),
    str_noindex: fb_lang("\\) sollte einen Richtungsindex (x, y, h, v) haben.", "\\) should have a direction index (x, y, h, v)."),
    str_idxlong: fb_lang("\\): Ein Buchstabe sollte für den Index reichen.", "\\): a single letter should be enough for the index."),
    str_idxunknown: fb_lang("\\): Der Richtungsindex sollte h, v, x oder y sein", "\\): the direction index should be h, v, x or y"),
    str_should_h: fb_lang("\\) m&uuml;sste eine horizontale Kraft bezeichnen.", "\\) should denote a horizontal force."),
    str_should_v: fb_lang("\\) m&uuml;sste eine vertikale Kraft bezeichnen.", "\\) should denote a vertical force."),
    str_should_x: fb_lang("\\) m&uuml;sste eine Kraft in positive x-Richtung (nach rechts) bezeichnen.", "\\) should denote a force in the positive x direction (to the right)."),
    str_should_y: fb_lang("\\) m&uuml;sste eine Kraft in positive y-Richtung (nach oben) bezeichnen.", "\\) should denote a force in the positive y direction (upward).")],
    name: o[i][2], nl: split(name,"_"),
    /* All str_* above are fully static (no dynamic value of their own) and safe to hoist at the
       top. The dynamic part (name) is plain-concatenated at each point of use below instead of
       being embedded inside a castext() call - "\\(" is pure LaTeX markup, not translated text,
       so it doesn't need its own castext() entry. This keeps every piece of translatable text in
       exactly one place at the top of the function. */
    /* base name single character? */
    if slength(first(nl)) > 1
    then return([sconcat("\\(", name, str_multiletter), false]),
    /* is there an index? */
    if length(nl) # 2
    then return([sconcat("\\(", name, str_noindex), false]),
    /* are name and index just a single character? */
    idx: last(nl),
    if slength(idx) > 1
    then return([sconcat("\\(", name, str_idxlong), false]),
    /* is the index known? */
    if not member(sdowncase(idx), ["h","v","x","y"])
    then return([sconcat("\\(", name, str_idxunknown), false]),
    /* check directions */
    dir: direction(o[i]),
    if (sdowncase(idx)="h" and abs(dir[2]) > 0.01) then
    return([sconcat("\\(", name, str_should_h), false]),
    if (sdowncase(idx)="v" and abs(dir[1]) > 0.01) then
    return([sconcat("\\(", name, str_should_v), false]),
    if (sdowncase(idx)="x" and (abs(dir[2]) > 0.01 or dir[1] <0) ) then
    return([sconcat("\\(", name, str_should_x), false]),
    if (sdowncase(idx)="y" and (abs(dir[1]) > 0.01 or dir[2] <0) ) then
    return([sconcat("\\(", name, str_should_y), false]),
    /* Name is ok */
    return(["",true])
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-%22fix1%22 */
fb_fix1(%_o, %_n, %_i, %_description):=block(
    [%_txt: sconcat("<br>",%_description), %_R,
     str_not_deactivated: fb_lang("ist nicht deaktiviert.", "is not deactivated."),
     str_no_reaction: fb_lang("Keine Reaktion gefunden.", "No reaction found."),
     str_more_than_one: fb_lang("Mehr als eine Reaktion gefunden.", "More than one reaction found."),
     str_must_be_force: fb_lang("Die Reaktion muss eine Kraft sein.", "The reaction must be a force."),
     str_wrong_direction_pre: fb_lang("Die Reaktion \\(", "Reaction \\("),
     str_wrong_direction_post: fb_lang("\\) hat nicht die richtige Richtung.", "\\) does not have the correct direction."),
     str_found_pre: fb_lang("Reaktion \\(", "Reaction \\("),
     str_found_post: fb_lang("\\) gefunden.", "\\) found.")],
    /* Is object i a fixed support */
    if ( %_o[%_i][1] # "fix1" ) then return ([sconcat(%_txt, "object ", string(%_i), " is not a fixed support (fix1)"), false]),
    /* Is object i de-activated */
    if ( %_o[%_i][length(%_o[%_i])] # "hide") then return ([castext_concat(%_txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(%_n[%_i]) or %_n[%_i]=[] then return([castext_concat(%_txt, str_no_reaction), false]),
    /* Exactly 1 reaction found? */
    if (length(%_n[%_i]) > 1) then return( [castext_concat(%_txt, str_more_than_one), false]),
    /* Is the reaction a force? */
    if ( %_o[%_n[%_i][1]][1] # "force" ) then return ([castext_concat(%_txt, str_must_be_force), false]),
    /* Now ready for examination of the reaction */
    %_R: %_o[%_n[%_i][1]],
    /* Is the force normal to the support? */
    if not parallelp(%_R, %_o[%_i]) then return ([castext_concat(%_txt, sconcat(str_wrong_direction_pre, %_R[2], str_wrong_direction_post)),false]),
    /* everything should be ok here */
    return([castext_concat(%_txt, sconcat(str_found_pre, %_R[2], str_found_post)),true])
);

fb_fix1_name(%_o, %_n, %_i):=block(
    [%_R,
     str_single_letter: fb_lang("<br>Ein einzelner Buchstabe sollte f&uuml;r die Bezeichnung der Kraft ausreichen.", "<br>A single letter should be enough to name the force."),
     str_name_mismatch: fb_lang("<br>Der Name der Reaktionskraft sollte zum Namen des Lagerpunkts passen.", "<br>The reaction force's name should match the name of the support point.")],
    if not listp(%_n[%_i]) then return(["",false]),
    %_R: %_o[%_n[%_i][1]],
    /* name checking */
    if slength(%_R[2]) # 1 then return([str_single_letter,false]),
    if %_R[2] # %_o[%_i][2] then return([str_name_mismatch, false]),
    /* everything should be ok here */
    return(["",true])
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-%22fix12%22 */
fb_fix12(o, n, i, description):=block(
    [L1, L2, R1, R2,
     str_not_deactivated: fb_lang("ist nicht deaktiviert.", "is not deactivated."),
     str_no_reaction: fb_lang("Keine Reaktion gefunden.", "No reaction found."),
     str_more_than_two: fb_lang("Mehr als 2 Reaktionen gefunden.", "More than 2 reactions found."),
     str_less_than_two: fb_lang("Weniger als 2 Reaktionen gefunden.", "Fewer than 2 reactions found."),
     str_different_names: fb_lang("Die Reaktionen müssen verschiedene Namen haben.", "The reactions must have different names."),
     str_must_be_force_pre: fb_lang("Die Reaktion \\(", "Reaction \\("),
     str_must_be_force_post: fb_lang("\\) muss eine Kraft sein.", "\\) must be a force."),
     str_parallel_pre: fb_lang("Die Reaktionen \\(", "Reactions \\("),
     str_parallel_post: fb_lang("\\) sind parallel.", "\\) are parallel."),
     str_fix12_found_pre: fb_lang("Reaktionen \\(", "Reactions \\("),
     str_fix12_found_post: fb_lang("\\) gefunden. ", "\\) found. ")],
    txt: sconcat("<br>",description),
     /* Is object i an fixed support? */
    if not member(o[i][1], ["fix12"])
    then return ([sconcat(txt, "object ", string(i), " (", o[i][1], ") is not a fixed support."), false]),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
    /* Exactly 2 reaction found? */
    if (length(n[i]) > 2) then return( [castext_concat(txt, str_more_than_two), false]),
    /* Is the reaction a force? */
    if (length(n[i]) < 2) then return( [castext_concat(txt, str_less_than_two), false]),
    R1: o[n[i][1]], R2: o[n[i][2]],
    /* Is the reaction a force? */
    if ( o[n[i][1]][1] # "force" )
    then return ([castext_concat(txt, sconcat(str_must_be_force_pre, R1[2], str_must_be_force_post)),false]),
    if ( o[n[i][2]][1] # "force" )
    then return ([castext_concat(txt, sconcat(str_must_be_force_pre, R2[2], str_must_be_force_post)),false]),
    /* Equal names? */
    if (R1[2] = R2[2]) then return ([castext_concat(txt, str_different_names),false]),
    /* Are the reactions non-parallel? */
    if parallelp(R1, R2) then return ([castext_concat(txt, sconcat(str_parallel_pre, R1[2], ",", R2[2], str_parallel_post)),false]),
    /* everything should be ok here */
    return([castext_concat(txt, sconcat(str_fix12_found_pre, R1[2], ",", R2[2], str_fix12_found_post)),true])
);
fb_fix12_name(o, n, i):=block(
    [dir, idx, nl, L, R, txt: "", flag:false,
     str_multiletter: fb_lang("\\): Physikalische Gr&ouml;&szlig;en immer nur mit einem Buchstabe und eventuell Index schreiben, z.B. <code>F_1</code>.", "\\): always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>."),
     str_namemismatch_pre: fb_lang("<br>Der Name \\(", "<br>The name \\("),
     str_namemismatch_post: fb_lang("\\) passt nicht zum Name des Lagerpunkts.", "\\) does not match the name of the support point."),
     str_noindex: fb_lang("\\) sollte einen Richtungsindex (x, y, h, v) haben.", "\\) should have a direction index (x, y, h, v)."),
     str_idxlong: fb_lang("\\): Ein Buchstabe sollte für den Index reichen.", "\\): a single letter should be enough for the index."),
     str_idxunknown: fb_lang("\\): Der Richtungsindex sollte h, v, x oder y sein", "\\): the direction index should be h, v, x or y"),
     str_should_h: fb_lang("\\) m&uuml;sste eine horizontale Kraft bezeichnen.", "\\) should denote a horizontal force."),
     str_should_v: fb_lang("\\) m&uuml;sste eine vertikale Kraft bezeichnen.", "\\) should denote a vertical force."),
     str_should_x: fb_lang("\\) m&uuml;sste eine Kraft in positive x-Richtung (nach rechts) bezeichnen.", "\\) should denote a force in the positive x-direction (to the right)."),
     str_should_y: fb_lang("\\) m&uuml;sste eine Kraft in positive y-Richtung (nach oben) bezeichnen.", "\\) should denote a force in the positive y-direction (upward).")],
    /* All str_* above are fully static and hoisted once here, outside the loop - they don't
       depend on R (the reaction object currently being checked), which only gets a new value on
       each iteration of the "for ir in n[i]" loop below. Only the dynamic part (R[2]) is inserted
       at the point of use, via plain concatenation, once per iteration - no castext() call is
       made inside the loop at all. */
    /* do the non-name checks to avoid runtime-errors */
    if not member(o[i][1], ["fix12"]) then return (["", false]),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return (["", false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return(["", false]),
    /* Exactly 2 reaction found? */
    if (length(n[i]) > 2) then return( ["", false]),
    for ir in n[i] do (      /* loop over the reactions */
       R: o[ir],
       /* Is the reaction a force? */
       if ( R[1] # "force" ) then return,
       /* Extract name parts */
       nl: split(R[2],"_"),
       /* base name single character? */
       if slength(nl[1]) > 1 then (flag:true,
          txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_multiletter)),
             return(return)),
       /* force name matches support name?*/
       if is(nl[1] # o[i][2]) then (flag:true,
            txt: castext_concat(txt, sconcat(str_namemismatch_pre, R[2], str_namemismatch_post))),
       /* is there an index? */
       if length(nl) # 2 then (flag: true,
         txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_noindex))),
       /* is  index just a single character? */
       idx: last(nl),
       if slength(idx) > 1 then (flag:true,
        txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_idxlong))),
       /* is the index known? */
       if not member(sdowncase(idx), ["h","v","x","y"]) then (flag:true,
            txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_idxunknown))),
       /* check directions */
       dir: direction(R),
       if (sdowncase(idx)="h" and abs(dir[2]) > 0.01) then (flag:true,
            txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_should_h))),
       if (sdowncase(idx)="v" and abs(dir[1]) > 0.01) then (flag:true,
            txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_should_v))),
       if (sdowncase(idx)="x" and (abs(dir[2]) > 0.01 or dir[1] <0) ) then (flag:true,
            txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_should_x))),
       if (sdowncase(idx)="y" and (abs(dir[1]) > 0.01 or dir[2] <0) ) then(flag:true,
            txt: castext_concat(txt, sconcat("<br>\\(", R[2], str_should_y)))
    ),
 if flag then return([txt,false]),
   ["",true]
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-%22fix123%22 */
fb_fix123(o, n, i, description):=block(
    [sname: o[i][2], txt: sconcat("<br>",description), lf, lm,
     str_not_deactivated: fb_lang("ist nicht deaktiviert.", "is not deactivated."),
     str_no_reaction: fb_lang("Keine Reaktion gefunden.", "No reaction found."),
     str_too_few: fb_lang("Weniger als drei Reaktionen gefunden.", "Fewer than three reactions found."),
     str_too_many: fb_lang("Mehr als drei Reaktionen gefunden.", "More than three reactions found."),
     str_count_pre: fb_lang("Kräfte: ", "Forces: "),
     str_count_mid: fb_lang(", Momente: ", ", moments: "),
     str_count_post: fb_lang(" gefunden", " found"),
     str_parallel_pre: fb_lang("Die Reaktionen \\(", "Reactions \\("),
     str_parallel_mid: fb_lang("\\) und \\(", "\\) and \\("),
     str_parallel_post: fb_lang("\\) sind parallel.", "\\) are parallel."),
     str_found_pre: fb_lang("Reaktionskräfte \\(", "Reaction forces \\("),
     str_found_mid: fb_lang("\\) und Moment \\(", "\\) and moment \\("),
     str_found_post: fb_lang("\\) gefunden.", "\\) found.")],
    /* Is object i a built-in support? */
    if not member(o[i][1], ["fix123"])
    then return ([sconcat(txt, "object ", string(i), "(",o[i][1],") is not a built-in support."), false]),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
    /* Too few reactions found? */
    if (length(n[i]) <3) then return( [castext_concat(txt, str_too_few), false]),
    /* Too many reactions found? */
    if (length(n[i]) >3) then return( [castext_concat(txt, str_too_many), false]),
    /* 2 forces and 1 moment?*/
    lf: sublist(n[i], lambda ([x], o[x][1]="force")),
    lm: sublist(n[i], lambda ([x], o[x][1]="moment")),
    if ( length(lf) # 2 or length(lm) #1) then return ([castext_concat(txt, sconcat(str_count_pre, length(lf), str_count_mid, length(lm), str_count_post)),false]),
    /* Forces not parallel? */
    if (parallelp( o[lf[1]], o[lf[2]] ) ) then return([castext_concat(txt, sconcat(str_parallel_pre, n[lf[1]], str_parallel_mid, n[lf[2]], str_parallel_post)), false]),
    /* everything should be ok here */
    return([castext_concat(txt, sconcat(str_found_pre, n[lf[1]], ",", n[lf[2]], str_found_mid, n[lm[1]], str_found_post)),true])
);
fb_fix123_name(o, n, i):=block(
    [sname: o[i][2], txt: "", ir, fb_required, ntxt, nok,
     str_namemismatch_pre: fb_lang("<br>Der Name \\(", "<br>The name \\("),
     str_namemismatch_post: fb_lang("\\) passt nicht zum Name des Lagerpunktes.", "\\) does not match the name of the support point."),
     str_notmoment_post: fb_lang("\\) passt nicht zu einem Moment.", "\\) does not match a moment.")],
    /* make sure that there is at least one reaction */
    if not listp(n[i]) or n[i]=[] then return(["", false]),
    /*iterate over reactions*/
    fb_required: false,
    /* The static str_* above are hoisted once here, outside the loop - they don't depend on ir.
       Only the dynamic part (n[ir]) is inserted at the point of use, via plain concatenation,
       once per iteration - no castext() call is made inside the loop at all. */
    for ir in n[i] do (
        /* feedback for forces */
        if o[ir][1]="force" then (
            if (sname # first(charlist( o[ir][2] ))  ) then (
                 txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_namemismatch_post)),
                 fb_required: true),
            [ntxt,nok]: fb_force_hvxy(o, ir),
            if not nok then (
                txt: castext_concat(txt, castext_concat("<br>", ntxt)),
                fb_required: true)
         ),
		/* Feedback for moments */
        if o[ir][1]="moment" then (
            if (sname # last(charlist( o[ir][2] ))  ) then (
                txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_namemismatch_post)),
                fb_required: true),
            if (first(charlist( o[ir][2] )) # "M" ) then (
                txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_notmoment_post)),
                fb_required: true)
        )
    ),
    if fb_required then return([txt, false]),
    ["",true]
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-%22fix13%22 */
fb_fix13(o, n, i, description):=block(
    [sname: o[i][2], txt: sconcat("<br>",description), lf, lm,
     str_not_deactivated: fb_lang("ist nicht deaktiviert.", "is not deactivated."),
     str_no_reaction: fb_lang("Keine Reaktion gefunden.", "No reaction found."),
     str_too_few: fb_lang("Weniger als zwei Reaktionen gefunden.", "Fewer than two reactions found."),
     str_too_many: fb_lang("Mehr als zwei Reaktionen gefunden.", "More than two reactions found."),
     str_count_pre: fb_lang("Kräfte: ", "Forces: "),
     str_count_mid: fb_lang(", Momente: ", ", moments: "),
     str_count_post: fb_lang(" gefunden", " found"),
     str_wrong_direction_pre: fb_lang("Die Reaktion \\(", "Reaction \\("),
     str_wrong_direction_post: fb_lang("\\) hat nicht die richtige Richtung.", "\\) does not have the correct direction."),
     str_found_pre: fb_lang("Reaktionskraft \\(", "Reaction force \\("),
     str_found_mid: fb_lang("\\) und Moment \\(", "\\) and moment \\("),
     str_found_post: fb_lang("\\) gefunden.", "\\) found.")],
    /* Is object a frictionless support? */
    if not member(o[i][1], ["fix13"])
    then return ([sconcat(txt, "object ", string(i), "(",o[i][1],") is not a frictionless support."), false]),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
    /* Too few reactions found? */
    if (length(n[i]) <2) then return( [castext_concat(txt, str_too_few), false]),
    /* Too many reactions found? */
    if (length(n[i]) >2) then return( [castext_concat(txt, str_too_many), false]),
    /* 1 force and 1 moment?*/
    lf: sublist(n[i], lambda ([x], o[x][1]="force")),
    lm: sublist(n[i], lambda ([x], o[x][1]="moment")),
    if ( length(lf) # 1 or length(lm) #1) then return ([castext_concat(txt, sconcat(str_count_pre, length(lf), str_count_mid, length(lm), str_count_post)),false]),
    /* Forces in correct direction? */
    if (not parallelp( o[i], o[lf[1]] ) ) then return([castext_concat(txt, sconcat(str_wrong_direction_pre, n[lf[1]], str_wrong_direction_post)), false]),
    /* everything should be ok here */
    return([castext_concat(txt, sconcat(str_found_pre, n[lf[1]], str_found_mid, n[lm[1]], str_found_post)),true])
);

fb_fix13_names(o, n, i):=block(
    [sname: o[i][2], txt: "", ir, fb_required,
     str_singleletter_pre: fb_lang("<br> \\(", "<br> \\("),
     str_singleletter_post: fb_lang("\\) Ein einzelner Buchstabe sollte f&uuml;r die Bezeichnung der Kraft ausreichen", "\\) a single letter should be enough to name the force"),
     str_namemismatch_pre: fb_lang("<br>Der Name \\(", "<br>The name \\("),
     str_namemismatch_post: fb_lang("\\) passt nicht zum Name des Lagerpunktes.", "\\) does not match the name of the support point."),
     str_notmoment_post: fb_lang("\\) passt nicht zu einem Moment.", "\\) does not match a moment.")],
    /* make sure that there is at least one reaction */
    if not listp(n[i]) or n[i]=[] then return(["", false]),
    /*iterate over reactions*/
    fb_required: false,
    /* The static str_* above are hoisted once here, outside the loop. Only the dynamic part
       (n[ir]) is inserted at the point of use, via plain concatenation, once per iteration - no
       castext() call is made inside the loop at all. */
    for ir in n[i] do (
        /* feedback for forces */
        if o[ir][1]="force" then (
             if slength(o[ir][2]) # 1 then (
                  txt: castext_concat(txt, sconcat(str_singleletter_pre, n[ir], str_singleletter_post)),
                  fb_required: true),
            if (sname # o[ir][2]   ) then (
                 txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_namemismatch_post)),
                 fb_required: true)
            /* No fb_force_hvxy() check here: a fix13 support has exactly one reaction force
               (plus one moment), so the H/V/x/y naming scheme checked in fb_fix123_name() does not apply. */
         ),
        if o[ir][1]="moment" then (
            if (sname # last(charlist( o[ir][2] ))  ) then (
                txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_namemismatch_post)),
                fb_required: true),
            if (first(charlist( o[ir][2] )) # "M" ) then (
                txt: castext_concat(txt, sconcat(str_namemismatch_pre, n[ir], str_notmoment_post)),
                fb_required: true)
        )
    ),
    if fb_required then return([txt, false]),
    ["",true]
);
/* Alias for consistency */
fb_fix13_name(%_o, %_n, %_i):= fb_fix13_names(%_o, %_n, %_i);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-unidirectional-supports */
fb_unidir(o, n, i, description):=block(
    [txt, R,
     str_not_deactivated: fb_lang("Nicht deaktiviert.", "Not deactivated."),
     str_no_reaction: fb_lang("Keine Reaktion gefunden.", "No reaction found."),
     str_more_than_one: fb_lang("Mehr als eine Reaktion gefunden.", "More than one reaction found."),
     str_must_be_force: fb_lang("Die Reaktion muss eine Kraft sein.", "The reaction must be a force."),
     str_wrong_direction_pre: fb_lang("Die Reaktion \\(", "Reaction \\("),
     str_wrong_direction_post: fb_lang("\\) hat nicht die richtige Richtung.", "\\) does not have the correct direction."),
     str_found_pre: fb_lang("Reaktion \\(", "Reaction \\("),
     str_found_post: fb_lang("\\) gefunden.", "\\) found.")],
    txt: description,
    /* Is object i an unidirectional support? */
    if not member(o[i][1], ["bar", "dashpot", "springt", "springc", "fix1", "rope"])
    then return ([sconcat(txt, "object ", string(i), " (",o[i][1],") is not an unidirectional support."), false]),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
    /* Exactly 1 reaction found? */
    if (length(n[i]) > 1) then return( [castext_concat(txt, str_more_than_one), false]),
    /* Is the reaction a force? */
    if ( o[n[i][1]][1] # "force" ) then return ([castext_concat(txt, str_must_be_force), false]),
    R: o[n[i][1]],
    /* Is the force normal to the support? */
    if not parallelp(R, o[i]) then return ([castext_concat(txt, sconcat(str_wrong_direction_pre, n[n[i][1]], str_wrong_direction_post)), false]),
    /* everything should be ok here */
    return([castext_concat(txt, sconcat(str_found_pre, n[n[i][1]], str_found_post)), true])
);

/* https://github.com/mkraska/meclib/wiki/fb_resolve_ref */
/* Resolves a "contact" targetRef to an index into o. %_ref may be a name string, a 1-based
   index, or a LIST of either (for a contact that cuts away several environment objects at
   once, e.g. two wall segments meeting at a corner) - in the list case every element must
   resolve, and the result is the list of their indices, in the same order. */
/* Returns false if any reference cannot be resolved unambiguously. */
fb_resolve_ref(%_o, %_ref):=block([%_idx],
  if integerp(%_ref) then return(%_ref),
  if listp(%_ref) then (
    %_idx: map(lambda([%_r], fb_resolve_ref(%_o, %_r)), %_ref),
    return(if member(false, %_idx) then false else %_idx)
  ),
  %_idx: sublist_indices(%_o, lambda([%_x], %_x[2] = %_ref)),
  if length(%_idx) # 1 then return(false),
  first(%_idx)
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-"contact" */
/* Direction convention for a "contact" object's stored direction o[4]: it points OUTWARD from
   the free body, away from the support/environment (e.g. straight down into the floor for a
   body resting on the ground, or radially outward from a circle's center through the contact
   point) - NOT into the body. A frictionless point contact can only push, never pull, so a
   correctly entered reaction (pointing from the support INTO the body, i.e. opposite o[4]) must
   have a NEGATIVE scalar product with o[4]; zero or positive means the student entered a
   tension/pulling force, which is physically impossible for this kind of contact and is now
   flagged below. (Existing "contact" sketches authored before this convention was fixed may
   have o[4] pointing the other way - into the body - and need their direction negated to keep
   passing this check; see the wiki TODO for fb_contact()/"contact".) */
fb_contact(%_o, %_n, %_i, %_description, [%_opt]):=block(
    [%_txt: %_description, %_ref, %_j, %_jlist, %_pending, %_names, %_R, %_mn, %_dR, %_dC,
     str_environment: fb_lang("Umgebung", "environment"),
     str_and: fb_lang(" und ", " and "),
     str_is_not_deactivated: fb_lang(" ist nicht deaktiviert.", " is not deactivated."),
     str_are_not_deactivated: fb_lang(" sind nicht deaktiviert.", " are not deactivated."),
     str_no_reaction: fb_lang("Keine Reaktion gefunden.", "No reaction found."),
     str_more_than_one: fb_lang("Mehr als eine Reaktion gefunden.", "More than one reaction found."),
     str_must_be_force: fb_lang("Die Reaktion muss eine Kraft sein.", "The reaction must be a force."),
     str_wrong_direction_pre: fb_lang("Die Reaktion \\(", "Reaction \\("),
     str_wrong_direction_post: fb_lang("\\) hat nicht die richtige Richtung.", "\\) does not have the correct direction."),
     str_must_be_compressive_pre: fb_lang("Die Reaktion \\(", "Reaction \\("),
     str_must_be_compressive_post: fb_lang("\\) muss eine Druckkraft sein.", "\\) must be a compressive force."),
     str_found_pre: fb_lang("Reaktion \\(", "Reaction \\("),
     str_found_post: fb_lang("\\) gefunden.", "\\) found.")],
    /* Is object i a contact? */
    if ( %_o[%_i][1] # "contact" ) then return ([sconcat(%_txt, "object ", string(%_i), " is not a contact."), false]),
    /* Resolve the referenced (cut-away) object(s) - targetRef may be a single name/index or a
       list of several (see fb_resolve_ref) */
    %_ref: %_o[%_i][5],
    %_j: fb_resolve_ref(%_o, %_ref),
    if %_j = false then return ([sconcat(%_txt, "fb_contact(): referenced object '",
      if stringp(%_ref) then %_ref else string(%_ref), "' not found or ambiguous."), false]),
    %_jlist: if listp(%_j) then %_j else [%_j],
    /* Are ALL referenced objects de-activated? */
    %_pending: sublist(%_jlist, lambda([%_k], last(%_o[%_k]) # "hide")),
    if %_pending # [] then (
      %_names: map(lambda([%_k], if %_o[%_k][2] = "" then str_environment else %_o[%_k][2]), %_pending),
      return ([castext_concat(%_txt, castext_concat(simplode(%_names, str_and),
        if length(%_pending) = 1 then str_is_not_deactivated else str_are_not_deactivated)), false])
    ),
    /* Rough contact or accepted names given: see fb_contact_rough() */
    if not (%_opt = [] or (length(%_opt) = 1 and member(%_opt[1], ["", "smooth"])))
      then return(fb_contact_rough(%_o, %_n, %_i, %_txt, %_opt)),
    /* Any reactions found at i? */
    if not listp(%_n[%_i]) or %_n[%_i]=[] then return([castext_concat(%_txt, str_no_reaction), false]),
    /* Exactly 1 reaction found? */
    if (length(%_n[%_i]) > 1) then return( [castext_concat(%_txt, str_more_than_one), false]),
    /* Is the reaction a force? */
    if ( %_o[%_n[%_i][1]][1] # "force" ) then return ([castext_concat(%_txt, str_must_be_force), false]),
    %_R: %_o[%_n[%_i][1]],
    %_mn: %_n[%_n[%_i][1]],
    /* Is the force normal to the contact? */
    if not parallelp(%_R, %_o[%_i]) then return ([castext_concat(%_txt, sconcat(str_wrong_direction_pre, %_mn, str_wrong_direction_post)),false]),
    /* Does it push (compression), not pull (tension)? See the convention note above. */
    %_dR: direction(%_R), %_dC: direction(%_o[%_i]),
    if is(%_dR[1]*%_dC[1] + %_dR[2]*%_dC[2] >= 0) then
      return ([castext_concat(%_txt, sconcat(str_must_be_compressive_pre, %_mn, str_must_be_compressive_post)),false]),
    /* everything should be ok here */
    return([castext_concat(%_txt, sconcat(str_found_pre, %_mn, str_found_post)),true])
);

/* Optional arguments of fb_contact(): friction, normal names, friction names, ignore names
   friction: "" or "smooth" - no friction (no tangential reaction allowed)
             "static"       - static friction: a tangential reaction of either sense
             [vx, vy]       - kinetic friction, velocity of the body relative to the environment:
                              the friction force must act against it
             "v_A"          - kinetic friction, velocity given by the "disp" object of that name
   normal names, friction names: accepted names (string or list of strings). If given, the forces
             at the contact with one of these names are its reactions. Other forces at the point are
             commented as probable reactions with a wrong name (with their direction: normal,
             tangential, or the angle to the nearer of the two) unless their names are in the
             ignore list. Without names, every load at the point is a reaction and must be normal
             or (with friction) tangential.
   ignore names (4th entry, optional): names of other forces at the point (a weight, member
             forces, ...) that are not commented.
   Called by fb_contact() after the contact, its reference and the deactivation are checked;
   %_txt is the description. Returns [text, isOK]. */
fb_contact_rough(%_o, %_n, %_i, %_txt, %_opt):=block(
  [%_fr, %_nn, %_tn, %_named, %_L, %_LN: [], %_LT: [], %_c, %_u, %_t, %_v: false, %_vname: "",
   %_idx, %_k, %_d, %_msgs: [], %_nm, %_str, %_tex, %_texlist, %_found: [],
   %_ig, %_LF, %_dn, %_dt, %_deg, %_hintN: false, %_hintT: false, %_fmsgs: [],
   str_or: fb_lang(" oder ", " or "),
   str_and: fb_lang(" und ", " and "),
   str_must_be_force_pre: fb_lang("Die Reaktion ", "Reaction "),
   str_must_be_force_post: fb_lang(" muss eine Kraft sein.", " must be a force."),
   str_wrong_direction_pre: fb_lang("Die Reaktion ", "Reaction "),
   str_dev_mid: fb_lang(" weicht um ", " deviates by "),
   str_from_normal: fb_lang("° von der Normalen ab.", "° from the normal."),
   str_from_tangent: fb_lang("° von der Tangente ab.", "° from the tangent."),
   str_force_pre: fb_lang("Die Kraft ", "Force "),
   str_acts_normal: fb_lang(" wirkt normal zur Berührfläche.", " acts normal to the contact surface."),
   str_acts_tangential: fb_lang(" wirkt tangential zur Berührfläche.", " acts tangential to the contact surface."),
   str_expected_normal: fb_lang(" Als Normalkraft erwartet: ", " Expected normal force: "),
   str_expected_friction: fb_lang(" Als Reibkraft erwartet: ", " Expected friction force: "),
   str_expected_friction_s: fb_lang(" Als Haftkraft erwartet: ", " Expected friction force: "),
   str_contact_smooth: fb_lang(" Der Kontakt ist glatt.", " The contact is smooth."),
   str_expected_reaction: fb_lang(" Als Reaktion erwartet: ", " Expected reaction: "),
   str_expected_reactions: fb_lang(" Als Reaktionen erwartet: ", " Expected reactions: "),
   str_normal_paren: fb_lang(" (normal)", " (normal)"),
   str_tangential_paren: fb_lang(" (tangential)", " (tangential)"),
   str_no_normal: fb_lang("Keine Normalkraft gefunden.", "No normal force found."),
   str_no_normal_named_pre: fb_lang("Keine Normalkraft ", "No normal force "),
   str_no_normal_named_post: fb_lang(" gefunden.", " found."),
   str_more_normal: fb_lang("Mehr als eine Normalkraft gefunden.", "More than one normal force found."),
   str_not_normal_pre: fb_lang("Die Normalkraft ", "Normal force "),
   str_compressive_pre: fb_lang("Die Normalkraft ", "Normal force "),
   str_compressive_post: fb_lang(" muss eine Druckkraft sein.", " must be a compressive force."),
   /* German: "Haftkraft" for static friction, "Reibkraft" for kinetic friction (the _s variants) */
   str_no_friction: fb_lang("Keine Reibkraft gefunden.", "No friction force found."),
   str_no_friction_s: fb_lang("Keine Haftkraft gefunden.", "No friction force found."),
   str_no_friction_named_pre: fb_lang("Keine Reibkraft ", "No friction force "),
   str_no_friction_named_pre_s: fb_lang("Keine Haftkraft ", "No friction force "),
   str_no_friction_named_post: fb_lang(" gefunden.", " found."),
   str_more_friction: fb_lang("Mehr als eine Reibkraft gefunden.", "More than one friction force found."),
   str_more_friction_s: fb_lang("Mehr als eine Haftkraft gefunden.", "More than one friction force found."),
   str_not_tangential_pre: fb_lang("Die Reibkraft ", "Friction force "),
   str_not_tangential_pre_s: fb_lang("Die Haftkraft ", "Friction force "),
   str_smooth_pre: fb_lang("Der Kontakt ist glatt, die Kraft ", "The contact is smooth, force "),
   str_smooth_post: fb_lang(" ist nicht zulässig.", " is not admissible."),
   str_against_pre: fb_lang("Die Reibkraft ", "Friction force "),
   str_against_mid: fb_lang(" muss entgegen ", " must act against "),
   str_against_post: fb_lang(" wirken.", "."),
   str_against_sliding: fb_lang(" muss der Gleitbewegung entgegen wirken.", " must act against the sliding motion."),
   str_found_one_pre: fb_lang("Reaktion ", "Reaction "),
   str_found_two_pre: fb_lang("Reaktionen ", "Reactions "),
   str_found_post: fb_lang(" gefunden.", " found.")],
  /* names as plain strings (the names field may hold CAS symbols, see fb_name()) */
  %_str: lambda([%_x], if stringp(%_x) then %_x else string(%_x)),
  %_tex: lambda([%_x], sconcat("\\(", %_str(%_x), "\\)")),
  %_texlist: lambda([%_l], if length(%_l) = 1 then %_tex(%_l[1])
    else sconcat(simplode(map(%_tex, rest(%_l, -1)), ", "), str_or, %_tex(last(%_l)))),
  %_nm: lambda([%_k], %_str(%_n[%_k])),
  %_fr: %_opt[1],
  if %_fr = "smooth" then %_fr: "",
  %_nn: if length(%_opt) >= 2 then (if listp(%_opt[2]) then map(%_str, %_opt[2]) else [%_str(%_opt[2])]) else [],
  %_tn: if length(%_opt) >= 3 then (if listp(%_opt[3]) then map(%_str, %_opt[3]) else [%_str(%_opt[3])]) else [],
  %_ig: if length(%_opt) >= 4 then (if listp(%_opt[4]) then map(%_str, %_opt[4]) else [%_str(%_opt[4])]) else [],
  %_named: is(%_nn # []),
  if %_fr = "static" then (
    str_no_friction: str_no_friction_s, str_no_friction_named_pre: str_no_friction_named_pre_s,
    str_more_friction: str_more_friction_s, str_not_tangential_pre: str_not_tangential_pre_s,
    str_expected_friction: str_expected_friction_s),
  /* unit normal (outward, see fb_contact()) and unit tangent */
  %_c: float(direction(%_o[%_i])),
  %_u: %_c/sqrt(%_c . %_c), %_t: [-%_u[2], %_u[1]],
  /* angle in degrees between the line of a force and the normal (the tangent: 90 minus it) */
  %_dn: lambda([%_k], block([%_e: float(direction(%_o[%_k]))],
    float(acos(min(1, abs(%_e . %_u)/sqrt(%_e . %_e)))*180/%pi))),
  %_deg: lambda([%_x], string(round(%_x))),
  /* friction kind: velocity of the body for kinetic friction (developer messages in English) */
  if listp(%_fr) then %_v: float(%_fr)
  else if stringp(%_fr) and not member(%_fr, ["", "static"]) then (
    %_idx: sublist_indices(%_o, lambda([%_x], %_x[1] = "disp" and %_x[2] = %_fr)),
    if length(%_idx) # 1 then return([sconcat(%_txt, "fb_contact(): disp object '", %_fr, "' not found or ambiguous."), false]),
    %_v: float(direction(%_o[%_idx[1]])), %_vname: %_fr)
  else if not stringp(%_fr) then return([sconcat(%_txt, "fb_contact(): invalid friction argument ", string(%_fr), "."), false]),
  if listp(%_v) and abs(%_v . %_t) < 1e-6*sqrt(%_v . %_v) then
    return([sconcat(%_txt, "fb_contact(): the velocity has no tangential component."), false]),
  if %_fr # "" and %_named and %_tn = [] then
    return([sconcat(%_txt, "fb_contact(): names of the friction force missing."), false]),
  /* loads at the contact point */
  %_L: if listp(%_n[%_i]) then %_n[%_i] else [],
  if %_named then (
    /* only the forces named as contact reactions count */
    %_LN: sublist(%_L, lambda([%_k], member(%_nm(%_k), %_nn))),
    %_LT: sublist(%_L, lambda([%_k], member(%_nm(%_k), %_tn))),
    for %_k in append(%_LN, %_LT) do if %_o[%_k][1] # "force" then
      %_msgs: endcons(sconcat(str_must_be_force_pre, %_tex(%_nm(%_k)), str_must_be_force_post), %_msgs),
    if %_msgs # [] then return([castext_concat(%_txt, simplode(%_msgs, " ")), false]),
    /* forces at the point with other names (not in the ignore list): probably reactions with a
       wrong name, commented with their direction */
    %_LF: sublist(%_L, lambda([%_k], not member(%_nm(%_k), append(%_nn, %_tn, %_ig)))),
    for %_k in %_LF do (
      if %_o[%_k][1] # "force" then
        %_fmsgs: endcons(sconcat(str_must_be_force_pre, %_tex(%_nm(%_k)), str_must_be_force_post), %_fmsgs)
      else if sin(%_dn(%_k)*%pi/180) < 0.05 then (
        %_hintN: true,
        %_fmsgs: endcons(sconcat(str_force_pre, %_tex(%_nm(%_k)), str_acts_normal, str_expected_normal, %_texlist(%_nn), "."), %_fmsgs))
      else if cos(%_dn(%_k)*%pi/180) < 0.05 then (
        if %_fr = "" then
          %_fmsgs: endcons(sconcat(str_force_pre, %_tex(%_nm(%_k)), str_acts_tangential, str_contact_smooth), %_fmsgs)
        else (%_hintT: true,
          %_fmsgs: endcons(sconcat(str_force_pre, %_tex(%_nm(%_k)), str_acts_tangential, str_expected_friction, %_texlist(%_tn), "."), %_fmsgs)))
      else
        %_fmsgs: endcons(sconcat(str_force_pre, %_tex(%_nm(%_k)), str_dev_mid,
          if %_dn(%_k) <= 45 then sconcat(%_deg(%_dn(%_k)), str_from_normal) else sconcat(%_deg(90 - %_dn(%_k)), str_from_tangent),
          if %_fr = "" then sconcat(str_expected_reaction, %_texlist(%_nn), str_normal_paren, ".")
          else sconcat(str_expected_reactions, %_texlist(%_nn), str_normal_paren, ", ", %_texlist(%_tn), str_tangential_paren, ".")),
          %_fmsgs)))
  else (
    /* every load at the point is a reaction: sort by direction */
    for %_k in %_L do (
      if %_o[%_k][1] # "force" then
        %_msgs: endcons(sconcat(str_must_be_force_pre, %_tex(%_nm(%_k)), str_must_be_force_post), %_msgs)
      else (
        %_d: float(direction(%_o[%_k])), %_d: %_d/sqrt(%_d . %_d),
        if abs(%_d[1]*%_u[2] - %_d[2]*%_u[1]) < 0.05 then %_LN: endcons(%_k, %_LN)
        else if abs(%_d . %_u) < 0.05 then (
          if %_fr = "" then %_msgs: endcons(sconcat(str_smooth_pre, %_tex(%_nm(%_k)), str_smooth_post), %_msgs)
          else %_LT: endcons(%_k, %_LT))
        else %_msgs: endcons(sconcat(str_wrong_direction_pre, %_tex(%_nm(%_k)), str_dev_mid,
          if %_dn(%_k) <= 45 then sconcat(%_deg(%_dn(%_k)), str_from_normal) else sconcat(%_deg(90 - %_dn(%_k)), str_from_tangent)), %_msgs))),
    if %_msgs # [] then return([castext_concat(%_txt, simplode(%_msgs, " ")), false])
  ),
  /* normal force */
  if %_LN = [] then (if not %_hintN then %_msgs: endcons(
      if %_named then sconcat(str_no_normal_named_pre, %_texlist(%_nn), str_no_normal_named_post) else str_no_normal, %_msgs))
  else if length(%_LN) > 1 then %_msgs: endcons(str_more_normal, %_msgs)
  else (
    %_k: %_LN[1], %_d: float(direction(%_o[%_k])), %_d: %_d/sqrt(%_d . %_d),
    if abs(%_d[1]*%_u[2] - %_d[2]*%_u[1]) >= 0.05 then
      %_msgs: endcons(sconcat(str_not_normal_pre, %_tex(%_nm(%_k)), str_dev_mid, %_deg(%_dn(%_k)), str_from_normal), %_msgs)
    else if %_d . %_u >= 0 then
      %_msgs: endcons(sconcat(str_compressive_pre, %_tex(%_nm(%_k)), str_compressive_post), %_msgs)
    else %_found: endcons(%_nm(%_k), %_found)),
  /* friction force */
  if %_fr # "" then (
    if %_LT = [] then (if not %_hintT then %_msgs: endcons(
        if %_named then sconcat(str_no_friction_named_pre, %_texlist(%_tn), str_no_friction_named_post) else str_no_friction, %_msgs))
    else if length(%_LT) > 1 then %_msgs: endcons(str_more_friction, %_msgs)
    else (
      %_k: %_LT[1], %_d: float(direction(%_o[%_k])), %_d: %_d/sqrt(%_d . %_d),
      if abs(%_d . %_u) >= 0.05 then
        %_msgs: endcons(sconcat(str_not_tangential_pre, %_tex(%_nm(%_k)), str_dev_mid, %_deg(90 - %_dn(%_k)), str_from_tangent), %_msgs)
      else if listp(%_v) and %_d . %_v >= 0 then
        %_msgs: endcons(if %_vname # "" then sconcat(str_against_pre, %_tex(%_nm(%_k)), str_against_mid, %_tex(%_vname), str_against_post)
          else sconcat(str_against_pre, %_tex(%_nm(%_k)), str_against_sliding), %_msgs)
      else %_found: endcons(%_nm(%_k), %_found))),
  %_msgs: append(%_msgs, %_fmsgs),
  if %_msgs # [] then return([castext_concat(%_txt, simplode(%_msgs, " ")), false]),
  [castext_concat(%_txt, sconcat(if length(%_found) = 1 then str_found_one_pre else str_found_two_pre,
     simplode(map(%_tex, %_found), str_and), str_found_post)), true]
);

/* https://github.com/mkraska/meclib/wiki/fb_reaction_name */
/* Returns the name the student assigned to the single reaction force currently matched at
   contact/support index i, or %_default if none, more than one, or a non-force object is found
   there. Unlike fb_contact()/fb_unidir(), this never reports an error and has no [text, flag]
   shape - it is meant purely for a cosmetic dynamic label (e.g. showing the student's own name
   next to a numeric input field), falling back silently to a static placeholder name whenever
   the reaction can't yet be resolved unambiguously; use fb_contact()/fb_unidir() on the same
   index for the actual correctness check. */
fb_reaction_name(%_o, %_n, %_i, %_default):= block([],
  if not listp(%_n[%_i]) or length(%_n[%_i]) # 1 then return(%_default),
  if %_o[%_n[%_i][1]][1] # "force" then return(%_default),
  %_n[%_n[%_i][1]]
);

/* https://github.com/mkraska/meclib/wiki/fb_contact_reactions() */
/* Names of the reactions the student drew at contact %_i, sorted by direction: [normal name,
   friction name, direction of the friction force as drawn]; false where none is found (the first
   of several is taken). Same tolerance as fb_contact(). No feedback - check the contact with
   fb_contact(). Use it to build reference equations with the student's names. */
fb_contact_reactions(%_o, %_n, %_i):= block([%_c, %_u, %_d, %_k, %_nn: false, %_tn: false, %_td: false],
  if not listp(%_n[%_i]) then return([false, false, false]),
  %_c: float(direction(%_o[%_i])), %_u: %_c/sqrt(%_c . %_c),
  for %_k in %_n[%_i] do
    if %_o[%_k][1] = "force" then (
      %_d: float(direction(%_o[%_k])), %_d: %_d/sqrt(%_d . %_d),
      if abs(%_d[1]*%_u[2] - %_d[2]*%_u[1]) < 0.05 then (if %_nn = false then %_nn: %_n[%_k])
      else if abs(%_d . %_u) < 0.05 and %_tn = false then (%_tn: %_n[%_k], %_td: %_d)),
  [%_nn, %_tn, %_td]
);

/* https://github.com/mkraska/meclib/wiki/Feedback-for-line-loads */
fb_q(o, n, i, description,q1,q2,le):=block(
    [varcheck, txt: description, %_v, ir, ir1, ir2, %_R, mag, a0, xref, Rref, lm,
     str_not_deactivated: fb_lang("ist nicht deaktiviert.", "is not deactivated."),
     str_no_reaction: fb_lang("Keine Resultierende gefunden.", "No resultant found."),
     str_not_a_force: fb_lang(" ist keine Kraft.", " is not a force."),
     str_too_many_pre: fb_lang("Höchstens zwei Resultierende sind sinnvoll. Gefunden wurden mehr:<br>", "At most two resultants make sense. More were found:<br>"),
     str_constant_load: fb_lang("Bei konstanter Streckenlast sollte eine Resultierende ausreichen.", "For a constant line load, one resultant should be sufficient."),
     str_triangular_load: fb_lang("Bei einer Dreiecks-Streckenlast sollte eine Resultierende ausreichen.", "For a triangular line load, one resultant should be sufficient."),
     str_ok: fb_lang("Resultierende OK", "Resultant OK")],
    /* Is object a line load? */
    if not member(o[i][1], ["q"])
       then return ([sconcat(txt, "object ", string(i), " (",o[i][1],") is not a line load."), false]),
    /* Resultant force */
    %_v: o[i][5]-o[i][4],
    mag: (cabs(%_v[1]+%i*%_v[2]))*le*(q1+q2)/2, a0: carg(%_v[1]+%i*%_v[2]),
    xref: (o[i][4]*(2/3*q1+q2/3)+o[i][5]*(q1/3+2/3*q2))/(q1+q2),
    Rref: [ "force", mag, xref, xref+[-sin(a0+o[i][8]*pi/180), -cos(a0+o[i][8]*pi/180)] ],
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Any reactions found at i? */
    if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
    /* forces only?*/
    lm: sublist(n[i], lambda ([x], o[x][1]="moment")),
    if ( length(lm) # 0 ) then (
        /* NOTE: this concatenates each matched moment's {@n[ir]@} directly adjacent to the
           next, with no separator - a pre-existing formatting gap (visible only when more
           than one moment is present), left as current behaviour here, not fixed. */
        for ir in lm do txt: castext_concat(txt, castext("{@n[ir]@}") ),
        return ([castext_concat(txt, str_not_a_force),false])
    ),
    if (length(n[i]) =1) then (     /* just one reaction */
      /* correct direction? */
      ir: n[i][1],
      if abs(angle(Rref, o[ir]))>0.01 then
        return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not have the correct direction.[[/lang]]") ) ,false]),
      /* correct set of variables in the expression */
      varcheck: fb_vars(n[ir], mag, []),
      if varcheck # "" then return( [
	  castext_concat( castext_concat( txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} hat nicht den richtigen Betrag. [[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not have the correct magnitude. [[/lang]]") ), varcheck),
          false]),
      /* correct value (comparison requires consistent set of variables) */
      if abs((mag-n[ir])/mag)>0.01 then
         return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} hat nicht den richtigen Betrag.[[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not have the correct magnitude.[[/lang]]") ) ,false]),
      /* correct position? */
      if abs(moment_of_force(xref, o[ir], 1, 1) ) > 0.01 then
        return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} geht nicht durch den Schwerpunkt.[[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not pass through the centroid.[[/lang]]") ) ,false])
    ) else ( /* two resultants, should be a trapezoidal load */
      /* just two resultants? */
      if (length(n[i]) >2) then (
        %_R: fb_strip_list(makelist(n[n[i][ir]], ir, 1, length(n[i]) ) ),
        return([lreduce(castext_concat, [txt, str_too_many_pre, %_R ] ), false])
      ),
      if q1 = q2 then return([castext_concat(txt, str_constant_load) ,false]),
      if q1*q2 =0 then return([castext_concat(txt, str_triangular_load) ,false]),
      /* correct direction? */
      ir1: n[i][1], ir2: n[i][2],
      if abs(angle(Rref, o[ir1]))>0.01 then
        return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir1]@} hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]Resultant {@n[ir1]@} does not have the correct direction.[[/lang]]") ) ,false]),
      if abs(angle(Rref, o[ir2]))>0.01 then
        return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir2]@} hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]Resultant {@n[ir2]@} does not have the correct direction.[[/lang]]") ) ,false]),
      /* correct value */
      varcheck: fb_vars(n[ir1], mag, []),
      if varcheck # "" then return([ castext_concat( castext_concat( txt, castext("[[lang code='de']]Die Resultierende {@n[ir1]@} kann nicht stimmen. [[/lang]][[lang code='en,other']]Resultant {@n[ir1]@} cannot be correct. [[/lang]]") ), varcheck) ,false]),
      varcheck: fb_vars(n[ir2], mag, []),
      if varcheck # "" then return([ castext_concat( castext_concat( txt, castext("[[lang code='de']]Die Resultierende {@n[ir2]@} kann nicht stimmen. [[/lang]][[lang code='en,other']]Resultant {@n[ir2]@} cannot be correct. [[/lang]]") ), varcheck) ,false]),
      if abs((mag-n[ir1]-n[ir2])/mag)>0.01 then
         return([castext_concat(txt, castext("[[lang code='de']]Die Summe der Resultierenden {@n[ir1]+n[ir2]@} hat nicht den richtigen Wert. [[/lang]][[lang code='en,other']]The sum of the resultants {@n[ir1]+n[ir2]@} does not have the correct value. [[/lang]]") ) ,false]),
      /* correct position? */
      if abs((moment_of_force(xref, o[ir1], n[ir1], 1) + moment_of_force(xref, o[ir2], n[ir2], 1))/mag ) > 0.01 then
        return( [castext_concat(txt, castext("[[lang code='de']]Pr&uuml;fen Sie die Lage der Resultierenden. Der gemeinsame Schwerpunkt entspricht nicht der Streckenlast. <br>{@n[ir1]@}, {@n[ir2]@}[[/lang]][[lang code='en,other']]Check the position of the resultants. Their common centroid does not match the line load. <br>{@n[ir1]@}, {@n[ir2]@}[[/lang]]") ) ,false])
    ),
   [castext_concat(txt, str_ok) ,true]
);

/* Which end of a "bar" object a force's own application point (R[3]) is anchored at, by
   coordinate match within a small tolerance (sketches are grid-snapped, so a correctly
   dragged reaction lands exactly on the bar's endpoint): 1 for the bar's own point 3, 2
   for point 4, 0 if it matches neither (not expected in normal use - e.g. it was never
   moved onto the bar at all). Used only by fb_bar()'s "2" (two-force member) option. */
fb_bar_end(%_bar, %_R):= block([%_p3: %_bar[3], %_p4: %_bar[4], %_rp: %_R[3], %_tol: 0.1],
  if sqrt((%_rp[1]-%_p3[1])^2+(%_rp[2]-%_p3[2])^2) < %_tol then 1
  elseif sqrt((%_rp[1]-%_p4[1])^2+(%_rp[2]-%_p4[2])^2) < %_tol then 2
  else 0
);

/* Does the force point AWAY from the bar at the given end (tension, not compression)? end
   must be 1 or 2, as returned by fb_bar_end(). */
fb_bar_tension_ok(%_bar, %_R, %_end):= block([%_bd: direction(%_bar), %_rd: direction(%_R), %_ref],
  %_ref: if %_end=1 then -%_bd else %_bd,
  is(%_rd[1]*%_ref[1]+%_rd[2]*%_ref[2] > 0)
);

/* https://github.com/mkraska/meclib/wiki/fb_bar */
/* opt may contain "T" (single-force case only: also check the reaction's sign, i.e. that
   it is defined as tension rather than compression) and/or "2" (two-force-member case: the
   bar is cut free at BOTH ends at once, expecting one reaction at each end, sharing the
   bar's own name - the free-body cut used for the method of joints/sections. Both ends are
   always checked for the correct tension sign in this case - unlike the single-force case,
   this isn't gated by "T", since a two-force member's whole point is that both ends must
   be tension (or both compression, with the sign flipped) together; "T" is simply not
   consulted when "2" is set.) */
fb_bar(o, n, i, [opt]):=block(
    [txt, R, R1, R2, name, testT, test2, L, e1, e2,
     str_bar_pre: fb_lang("Stab ", "Bar "),
     str_not_deactivated: fb_lang("Nicht deaktiviert.", "Not deactivated."),
     str_no_match_pre: fb_lang("Keine Stabkraft mit passendem Namen (mit Index ", "No bar force with a matching name (with index "),
     str_no_match_post: fb_lang(") gefunden.", ") found."),
     str_not_parallel: fb_lang(" ist nicht parallel zum Stab.", " is not parallel to the bar."),
     str_not_tension: fb_lang(" ist nicht als Zugkraft definiert.", " is not defined as a tensile force."),
     str_ok: fb_lang(" OK.", " OK."),
     str_fewer_than_two: fb_lang("Weniger als zwei Stabkräfte mit passendem Namen gefunden.", "Fewer than two bar forces with a matching name found."),
     str_more_than_two: fb_lang("Mehr als zwei Stabkräfte mit passendem Namen gefunden.", "More than two bar forces with a matching name found."),
     str_not_at_end: fb_lang(" greift an keinem Stabende an.", " does not act at either end of the bar."),
     str_same_end: fb_lang(" greifen beide am selben Stabende an. An jedem Stabende sollte eine Stabkraft angreifen.", " both act at the same end of the bar. One bar force should act at each end."),
     str_name_mismatch: fb_lang(" haben unterschiedliche Namen. Als Freischnitt desselben Stabes sollten beide denselben Namen tragen.", " have different names. As the free-body cut of the same bar, both should carry the same name.")],
	/* Extract options */
    if length(opt) = 1 then opt: string(opt[1]) else opt: "",
    testT: member("T", charlist(opt)),
    test2: member("2", charlist(opt)),
    /* Is object i a bar? */
    if o[i][1]  # "bar" then return ([sconcat("object ", string(i), " (",o[i][1],") is not a bar."), false]),
    /* Has the object a name? The name is used later to identify associated reactions. */
    name: o[i][2],
    if name = "" then return ([ sconcat("object #", string(i), " has no name."), false]),
    txt: castext_concat(str_bar_pre, sconcat(name, ": ")),
    /* Is object i de-activated */
    if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
    /* Extract forces with matching name*/
    if listp(n[i]) then L: sublist (n[i], lambda ([x], o[x][1]="force" and split(o[x][2],"_")[2] = name )) else L: [],
    /* Check number of forces */
    if L = [] then return ([castext_concat(txt, sconcat(str_no_match_pre, name, str_no_match_post)) , false]),
    /* Single force required */
    if not test2 then (
      R: o[L[1]],
      /* force parallel to bar? */
      if not parallelp(R, o[i]) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_parallel)),false]),
      /* eventually complaining about wrong direction */
      if testT and (abs(angle(R, o[i])) > 0.1) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_tension)), false] ),
      return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_ok)), true] )
    ) else (
      /* Two-force member: exactly one reaction anchored at EACH end, both pointing
         outward along the bar (tension), sharing the bar's own name. */
      if length(L) < 2 then return ([castext_concat(txt, str_fewer_than_two), false]),
      if length(L) > 2 then return ([castext_concat(txt, str_more_than_two), false]),
      R1: o[L[1]], R2: o[L[2]],
      /* The two reactions are the Newton's-third-law pair at the member's two cut ends, so
         they should carry the same (student-chosen) object name - unlike fb_fix12(), which
         requires its two reactions to have DIFFERENT names because those are two distinct
         unknowns. */
      if R1[2] # R2[2] then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}, {@n[L[2]]@}"), str_name_mismatch)),false]),
      if not parallelp(R1, o[i]) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_parallel)),false]),
      if not parallelp(R2, o[i]) then return ([castext_concat(txt, castext_concat(castext("{@n[L[2]]@}"), str_not_parallel)),false]),
      e1: fb_bar_end(o[i], R1), e2: fb_bar_end(o[i], R2),
      if e1 = 0 then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_at_end)), false]),
      if e2 = 0 then return ([castext_concat(txt, castext_concat(castext("{@n[L[2]]@}"), str_not_at_end)), false]),
      if e1 = e2 then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}, {@n[L[2]]@}"), str_same_end)), false]),
      if not fb_bar_tension_ok(o[i], R1, e1) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_tension)), false]),
      if not fb_bar_tension_ok(o[i], R2, e2) then return ([castext_concat(txt, castext_concat(castext("{@n[L[2]]@}"), str_not_tension)), false]),
      return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}, {@n[L[2]]@}"), str_ok)), true])
    )
);

/* https://github.com/mkraska/meclib/wiki/fb_bar_name */
fb_bar_name(%_o, %_n, %_i):=block(
  [%_str,%_R,%_nl,%_OK,%_var, %_bl,
   str_multiletter: fb_lang("Physikalische Gr&ouml;&szlig;en immer nur mit einem Buchstabe und eventuell Index schreiben, z.B. <code>F_1</code>.", "Always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>."),
   str_sensible_names: fb_lang("Sinnvolle Namen für eine Stabkraft sind \\(F\\) (Kraft), \\(N\\) (Normalkraft) oder \\(S\\) (Stabkraft)", "Sensible names for a bar force are \\(F\\) (force), \\(N\\) (normal force), or \\(S\\) (bar force)"),
   str_index_mismatch_pre: fb_lang("Der Index ", "The index "),
   str_index_mismatch_mid: fb_lang(" passt nicht zum Stabname ", " does not match the bar's name ")],
  /* are the values consistent? */
  if length(%_n) # length(%_o) then return(sconcat("length(o)= ",length(%_o), " length(n)=", length(%_n))),
  if length(%_n) < %_i then return(sconcat("length(n)= ",length(%_n), " <", %_i)),
  /* is the object a bar */
  if not member(%_o[%_i][1], ["bar"]) then return ([sconcat("object ", %_i, " is not of type 'bar'"), false]),
  /* Is object i de-activated */ 
  if debug then %_str: sconcat("object ", %_i, " is not deactivated (debug message)" ) else %_str: "",
  if ( last(%_o[%_i]) # "hide") then return ([%_str, false]),
  /* Any reactions found at i? */
  if debug then %_str: sconcat("no reaction found at object ", %_i, " (debug message)" ) else %_str: "",
  if not listp(%_n[%_i]) or %_n[%_i]=[] then return([%_str, false]),
  /* Exactly 1 reaction found? */
  if debug then %_str: sconcat("more than one reaction found ", %_n[%_i], " (debug message)" ) else %_str: "",
  if (length(%_n[%_i]) > 1) then return( [%_str, false]),  
  /* now we know it is a single reaction */ 
  %_R: %_o[%_n[%_i][1]],
  %_var: %_n[%_n[%_i][1]],
  /* Is the reaction a force? */
  if debug then %_str: sconcat("Reaction ", %_R[2], " is not a force (debug message)" ) else	 %_str: "",
  if %_R[1] # "force" then return( [%_str, false]), 
  /* now we have a valid reaction, the remainder is about naming */
  %_str: "",
  %_OK: true,
  /* Extract name parts */
  %_nl: split(%_R[2],"_"),
  /* base name single character? */    
  if slength(%_nl[1]) > 1 then [ %_str, %_OK ]:
    [ castext_concat(castext("<br>{@%_var@}: "), str_multiletter), false ],
  /* base name a sensible character? (F-Kraft, N-Normalkraft, S-Stabkraft)  */
  if not member(charlist(%_nl[1])[1], ["F", "N", "S" ])  then [ %_str, %_OK ]:
    [ castext_concat( %_str, castext_concat(castext("<br>{@%_var@}: "), str_sensible_names) ), false ],
  /* label of the bar */
  %_bl: %_o[%_i][2],
  if %_bl # "" then (
    /* the label is not empty */
    if length(%_nl) = 2 then /* the reaction should have an index */
      if %_bl # %_nl[2] then /* the index and the label don't match */
        [ %_str, %_OK ]:
    [ castext_concat( %_str, castext_concat(castext("<br>"), castext_concat(str_index_mismatch_pre, castext_concat(castext("{@%_nl[2]@}"), castext_concat(str_index_mismatch_mid, castext("{@%_bl@}."))))))
, false ]
  ),
      
  [%_str, %_OK]
);

/* https://github.com/mkraska/meclib/wiki/fb_name */
fb_name(n,i,lon,[opt]):=block([name,txt,%_namestex,%_show,%_lonstr,
  str_or: fb_lang(" oder ", " or "),
  str_no_match_post: fb_lang(" \\) ist kein passender Name.", " \\) is not an acceptable name."),
  str_no_match_list_mid: fb_lang(" \\) ist kein passender Name. Akzeptiert: ", " \\) is not an acceptable name. Accepted: ")],
  /* str_* above are fully static and safe to hoist here. name/%_namestex only get their real
     value further down, so the dynamic part is plain-concatenated at each point of use below
     instead of being embedded inside a castext() call - this keeps every piece of translatable
     text in exactly one place at the top of the function, regardless of when the dynamic value
     becomes available. */
  name: none,
  if listp(n[i]) and  not emptyp(n[i]) then name: n[n[i][1]] else return(["", false]),
  /* the resolved name from the live `names` array may be a CAS symbol (algebraic input) or a
     string, and lon may be written either way too (e.g. ["N_A","A"] or [N_A,A]) - normalize
     both sides to plain strings before comparing, since a symbol and a string of the same
     spelling are never equal to Maxima's member(). */
  %_lonstr: map(lambda([%_x], if stringp(%_x) then %_x else string(%_x)), lon),
  if member(if stringp(name) then name else string(name), %_lonstr) then return( ["",true]),
  %_show: if opt=[] then true else opt[1],
  if not %_show then return([sconcat("\\(", name, str_no_match_post), false]),
  %_namestex: if length(lon)=1 then sconcat("\\(",lon[1],"\\)")
    else sconcat(simplode(map(lambda([%_x], sconcat("\\(",%_x,"\\)")), rest(lon,-1)), ", "), str_or, "\\(", last(lon), "\\)"),
  return([sconcat("\\(", name, str_no_match_list_mid, %_namestex, "."), false])
);

/* https://github.com/mkraska/meclib/wiki/fb_reactions() */
fb_reactions(%_o, %_f, %_m):=block(
  [%_fnum, %_mnum, %_txt, %_OK, %_msgs,
   str_count_ok: fb_lang("Die Zahl der Reaktionen stimmt.", "The number of reactions is correct."),
   str_force_count_wrong: fb_lang("Die Zahl der Reaktionskräfte stimmt nicht.", "The number of reaction forces is incorrect."),
   str_moment_count_wrong: fb_lang("Die Zahl der Reaktionsmomente stimmt nicht.", "The number of reaction moments is incorrect.")],
  %_fnum: length(sublist_indices (%_o, lambda ([x], x[1]="force" and last(x)="active" and  not sposition(" ",x[2])))),
  %_mnum: length(sublist_indices (%_o, lambda ([x], x[1]="moment" and last(x)="active"))),
  if (%_fnum=%_f) and (%_mnum=%_m) then [%_txt, %_OK]: [str_count_ok,true] else (
    %_OK: false, %_msgs: [],
    if %_fnum # %_f then %_msgs: endcons(str_force_count_wrong, %_msgs),
    if %_mnum # %_m then %_msgs: endcons(str_moment_count_wrong, %_msgs),
    %_txt: simplode(%_msgs, "<br>")
  ),
  [%_txt,%_OK]
);

/* https://github.com/mkraska/meclib/wiki/fb_unique_names() */
/* Reactions at different supports (or at one support) must not share a name.
   %_supports: indices of the supports; n[i] lists the objects meclib assigned to support i.
   One message per repeated name, with the supports where it occurs (if they have names). */
fb_unique_names(%_o, %_n, %_supports):=block(
  [%_all: [], %_names, %_where, %_sup, %_msgs: [], %_i, %_k, %_nm,
   str_dup_pre: fb_lang("Der Name \\(", "The name \\("),
   str_dup_mid: fb_lang("\\) wird für mehrere Reaktionen verwendet", "\\) is used for more than one reaction"),
   str_dup_post: fb_lang(". Reaktionen brauchen verschiedene Namen.", ". Reactions need different names.")],
  /* [name, support name] for every reaction found at the given supports */
  for %_i in %_supports do
    if listp(%_n[%_i]) then
      for %_k in %_n[%_i] do
        if strim(" ", %_o[%_k][2]) # "" then %_all: endcons([%_o[%_k][2], %_o[%_i][2]], %_all),
  %_names: unique(map(first, %_all)),
  for %_nm in %_names do (
    %_where: sublist(%_all, lambda([x], x[1] = %_nm)),
    /* the supports by name; unnamed ones (e.g. contacts with "" as label) are not listed */
    %_sup: sublist(unique(map(second, %_where)), lambda([x], stringp(x) and x # "")),
    if length(%_where) > 1 then
      %_msgs: endcons(sconcat(str_dup_pre, %_nm, str_dup_mid,
                        if emptyp(%_sup) then "" else sconcat(" (", simplode(%_sup, ", "), ")"), str_dup_post), %_msgs)
  ),
  if emptyp(%_msgs) then ["", true] else [simplode(%_msgs, "<br>"), false]
);

/* https://github.com/mkraska/meclib/wiki/fb_fbd() */
/* Generic checks of a free-body diagram, everything that does not depend on a single support:
   system boundaries, names of the loads the student drew, number of forces and moments.
   %_options: list of options name = value, each optional (a check without its options is left out):
     sys, env, hint   system boundaries as in fb_system()
     supports         indices of the supports whose reactions must have different names
                      (default: all fix1, fix12, fix123, fix13 and contact objects)
     reserved         further names reactions must not have (e.g. [a, b, h, alpha])
     nameform         true: the name of each drawn load is one letter with an optional index
     forces, moments  expected number of drawn forces and moments (as fb_reactions())
   Drawn loads are the active forces and moments; resultants of line loads (name with a space)
   are left out. Given loads (not active) may share names, but no drawn load may be named like
   one of them. Returns [text, ok, [system ok, names ok, number ok]] (true for checks not done);
   the text lists every problem, or one line naming the checks passed. */
fb_fbd(%_o, %_n, %_options):= block(
  [%_get, %_msgs: [], %_okS: true, %_okN: true, %_okC: true, %_done: [], %_drawn, %_given, %_res,
   %_sup, %_u, %_k, %_nm, %_base, %_fnum, %_mnum,
   str_sys_wrong: fb_lang("Die Systemgrenzen stimmen nicht.", "The system boundaries are incorrect."),
   str_noname: fb_lang("Eine gezeichnete Kraft oder ein Moment hat keinen Namen.", "A force or moment you drew has no name."),
   str_reserved_pre: fb_lang("Der Name \\(", "The name \\("),
   str_reserved_post: fb_lang("\\) ist schon vergeben (vorgegebene Last oder Größe der Aufgabe). Wählen Sie für die Reaktion einen anderen Namen.", "\\) is already taken (a given load or a quantity of the problem). Choose another name for the reaction."),
   str_form_post: fb_lang("\\): Physikalische Größen immer nur mit einem Buchstaben und eventuell Index schreiben, z.B. <code>F_1</code>.", "\\): always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>."),
   str_forces_wrong: fb_lang("Die Zahl der Reaktionskräfte stimmt nicht.", "The number of reaction forces is incorrect."),
   str_moments_wrong: fb_lang("Die Zahl der Reaktionsmomente stimmt nicht.", "The number of reaction moments is incorrect."),
   str_ok_pre: fb_lang("Geprüft und in Ordnung: ", "Checked and correct: "),
   str_ok_sys: fb_lang("Systemgrenzen", "system boundaries"),
   str_ok_names: fb_lang("Namen", "names"),
   str_ok_count: fb_lang("Anzahl der Reaktionen", "number of reactions")],
  /* option value or false; the name may be given as a symbol or a string */
  %_get: lambda([%_key], block([%_v: false],
    for %_e in %_options do if equationp(%_e) and string(lhs(%_e)) = %_key then %_v: rhs(%_e), %_v)),
  /* loads drawn by the student and given loads */
  %_drawn: sublist_indices(%_o, lambda([x], member(x[1], ["force", "moment"]) and last(x) = "active"
    and not sposition(" ", x[2]))),
  %_given: sublist(map(lambda([x], x[2]), sublist(%_o, lambda([x], member(x[1], ["force", "moment"]) and last(x) # "active"))),
    lambda([x], stringp(x) and x # "")),
  /* 1. system boundaries */
  if %_get("sys") # false or %_get("env") # false then (
    %_done: endcons(str_ok_sys, %_done),
    %_okS: second(fb_system(%_n, if listp(%_get("sys")) then %_get("sys") else [],
                                 if listp(%_get("env")) then %_get("env") else [], "")),
    if not %_okS then %_msgs: endcons(
      if stringp(%_get("hint")) and striml(" ", %_get("hint")) # "" then sconcat(str_sys_wrong, " ", striml(" ", %_get("hint"))) else str_sys_wrong,
      %_msgs)),
  /* 2. names: missing, taken (given loads, reserved), form, the same at several supports */
  %_done: endcons(str_ok_names, %_done),
  if some(lambda([k], strim(" ", %_o[k][2]) = ""), %_drawn) then (%_okN: false, %_msgs: endcons(str_noname, %_msgs)),
  %_res: append(%_given, map(lambda([x], if stringp(x) then x else string(x)),
                             if listp(%_get("reserved")) then %_get("reserved") else [])),
  for %_nm in unique(map(lambda([k], %_o[k][2]), %_drawn)) do
    if member(%_nm, %_res) then (%_okN: false, %_msgs: endcons(sconcat(str_reserved_pre, %_nm, str_reserved_post), %_msgs)),
  if %_get("nameform") = true then
    for %_nm in unique(map(lambda([k], %_o[k][2]), %_drawn)) do (
      %_base: if sposition("_", %_nm) # false then substring(%_nm, 1, sposition("_", %_nm)) else %_nm,
      if strim(" ", %_nm) # "" and not (slength(%_base) = 1 and alphacharp(charat(%_base, 1))) then (
        %_okN: false, %_msgs: endcons(sconcat("\\(", %_nm, str_form_post), %_msgs))),
  %_sup: if listp(%_get("supports")) then %_get("supports")
    else sublist_indices(%_o, lambda([x], member(x[1], ["fix1", "fix12", "fix123", "fix13", "contact"]))),
  %_u: fb_unique_names(%_o, %_n, %_sup),
  if not second(%_u) then (%_okN: false, %_msgs: endcons(first(%_u), %_msgs)),
  /* 3. number of drawn forces and moments */
  if %_get("forces") # false or %_get("moments") # false then (
    %_done: endcons(str_ok_count, %_done),
    %_fnum: length(sublist(%_drawn, lambda([k], %_o[k][1] = "force"))),
    %_mnum: length(sublist(%_drawn, lambda([k], %_o[k][1] = "moment"))),
    if integerp(%_get("forces")) and %_fnum # %_get("forces") then (%_okC: false, %_msgs: endcons(str_forces_wrong, %_msgs)),
    if integerp(%_get("moments")) and %_mnum # %_get("moments") then (%_okC: false, %_msgs: endcons(str_moments_wrong, %_msgs))),
  if emptyp(%_msgs) then [sconcat("<br>", str_ok_pre, simplode(%_done, ", "), "."), true, [true, true, true]]
  else [sconcat("<br>", simplode(%_msgs, "<br>")), false, [%_okS, %_okN, %_okC]]
);

/* https://github.com/mkraska/meclib/wiki/fb_EE() */
/* Feedback on one equation of equilibrium: the student's expression %_S (the sum, "= 0" implied)
   against the reference %_T, e.g. sumF() or sumM() of the student's own free-body diagram.
   %_options: list of options name = value, each optional:
     subst = [alpha = atan(2/3), ...]  applied to both sides before comparing (symbols of the
                                       problem that stand for numbers of the sketch)
     kind = "M" or "x", "y", ...       for the hint on a wrong sign of the whole sum: moments
                                       (counterclockwise) or forces in the direction named
     title = "\\Sigma F_x"             LaTeX title put in front of a message
   Needs fb_value.mac (fb_vars()). Returns [text, ok]; the text is empty if the equation is right. */
fb_EE(%_S, %_T, [%_options]):= block(
  [%_get, %_sub, %_kind, %_title, %_z, %_msg,
   str_sign_pre: fb_lang("Zählen Sie Kräfte in positiver \\(", "Count forces in the positive \\("),
   str_sign_post: fb_lang("\\)-Richtung positiv.", "\\) direction as positive."),
   str_sign_M: fb_lang("Zählen Sie Momente gegen den Uhrzeigersinn positiv.", "Count counterclockwise moments as positive."),
   str_sign: fb_lang("Das Vorzeichen der Summe stimmt nicht. Prüfen Sie die Zählrichtung.", "The sign of the sum is wrong. Check the counting direction."),
   str_wrong: fb_lang("Die Gleichung passt nicht zu Ihrem Freischnitt.", "The equation does not match your free-body diagram.")],
  %_options: if %_options = [] then [] else %_options[1],
  %_get: lambda([%_key], block([%_v: false],
    for %_e in %_options do if equationp(%_e) and string(lhs(%_e)) = %_key then %_v: rhs(%_e), %_v)),
  /* one equation per call ([S] and [T] are taken as S and T) */
  if listp(%_S) and length(%_S) = 1 then %_S: %_S[1],
  if listp(%_T) and length(%_T) = 1 then %_T: %_T[1],
  if listp(%_S) or listp(%_T) then return(["fb_EE(): one equation per call", false]),
  %_sub: if listp(%_get("subst")) then %_get("subst") else [],
  %_kind: %_get("kind"), %_title: %_get("title"),
  /* zero after the substitutions? */
  %_z: lambda([%_e], is(ratsimp(trigsimp(ratsimp(subst(%_sub, %_e)))) = 0)),
  if %_z(%_S - %_T) then return(["", true]),
  %_msg: if %_z(%_S + %_T) then (
      if %_kind = "M" then str_sign_M
      else if stringp(%_kind) and %_kind # "" then castext_concat(castext_concat(str_sign_pre, %_kind), str_sign_post)
      else str_sign)
    else block([%_v: fb_vars(ratsimp(subst(%_sub, %_S)), ratsimp(subst(%_sub, %_T)), listofvars(subst(%_sub, %_T)))],
      if %_v = "" then str_wrong else %_v),
  /* castext_concat, not sconcat: fb_vars() returns castext (a ["%root", ...] list) when its text
     contains values ({@...@}); sconcat would print that list literally. For plain strings
     castext_concat is sconcat. */
  [castext_concat(sconcat("<br>", if stringp(%_title) then sconcat("\\(", %_title, "\\): ") else ""), %_msg), false]
);

/* https://github.com/mkraska/meclib/wiki/fb_force() */
/* General-purpose feedback check for a single active force that is not tied to any particular
   contact/support index (use fb_contact()/fb_bar() for those instead) - e.g. a weight force or
   a resultant the student places freely via forceGen:
     %_name   - the expected object name, as a string, or a list of strings if several names
                would be equally acceptable (e.g. "G" or "F_G")
     %_point  - a point the force's line of action must pass through
     %_dir    - the expected direction, either a number (angle in degrees, standard math
                convention: 0 = +x axis, 90 = +y axis) or a direction vector [dx, dy]
     %_toldeg  - direction tolerance in degrees
     %_toldist - tolerance for the line of action's distance from %_point, either a bare number
                 (compared directly against the sketch's own coordinate units, as the deviation
                 from moment_of_force() naturally comes out) or a [tol, "unit"] list (e.g.
                 [0.01,"mm"]) - in that case the sketch-unit deviation is converted using the
                 grid object's [fx,fy] scaling factor (see the "grid" wiki page; object 1 must
                 be the grid, and fx must equal fy - any geometry sketch must be scaled equally
                 in x and y, so a mismatch is reported as a question-authoring/developer error,
                 not student feedback) and the deviation is reported together with that unit
     %_description - text prefix for the feedback, as elsewhere
   On a direction or distance mismatch, the actual deviation is reported as a rounded value, the
   same way fb_unit() reports a numeric deviation as a rounded percentage. */
/* a number for plain text (outside \( \)) with the question's decimal separator: STACK's
   stackfltsep (",": decimal comma) applies to the TeX output of floats only, string() always
   writes a point */
fb_numtext(%_x) := block([%_s: if stringp(%_x) then %_x else string(%_x)],
  if is(stackfltsep = ",") then ssubst(",", ".", %_s) else %_s)$

fb_force(%_o, %_name, %_point, %_dir, %_toldeg, %_toldist, %_description):=block(
  [%_txt: %_description, %_names, %_namestex, %_idx, %_i, %_dref, %_devDeg, %_devDist, %_mn,
   %_toldistval, %_tolunit, %_fx, %_fy,
   str_or: fb_lang(" oder ", " or "),
   str_notfound_pre: fb_lang("Keine Kraft ", "No force "),
   str_ambiguous_pre: fb_lang("Mehr als eine Kraft ", "More than one force "),
   str_notfound_post: fb_lang(" gefunden.", " found."),
   str_wrong_direction_mid: fb_lang("\\) hat nicht die richtige Richtung. Richtungsabweichung: ", "\\) does not have the correct direction. Direction deviation: "),
   str_wrong_line_pre: fb_lang("Die Wirkungslinie von \\(", "The line of action of \\("),
   str_wrong_line_mid: fb_lang("\\) geht am richtigen Angriffspunkt vorbei. Abstand: ", "\\) misses the correct point of application. Distance: "),
   str_found_post: fb_lang("\\) gefunden.", "\\) found.")],
  %_names: if listp(%_name) then %_name else [%_name],
  /* %_names holds variable names (e.g. "G", "F_G") - these must render as LaTeX math, like %_mn
     further down, not as plain text (which loses the subscript and looks inconsistent). */
  %_namestex: simplode(map(lambda([%_x], sconcat("\\(", %_x, "\\)")), %_names), str_or),
  %_idx: sublist_indices(%_o, lambda([%_x], %_x[1]="force" and member(%_x[2],%_names) and last(%_x)="active")),
  /* All str_* above are fully static and safe to hoist at the top. The remaining messages below
     each reference a local variable (%_namestex, %_mn, %_devDeg, %_devDist, %_tolunit) that only
     gets its real value here in the body - that dynamic part is plain-concatenated at the point
     of use instead of being embedded inside a castext() call, so every piece of translatable
     text still lives in exactly one place at the top of the function. */
  if length(%_idx) = 0 then return([castext_concat(%_txt, sconcat(str_notfound_pre, %_namestex, str_notfound_post)), false]),
  if length(%_idx) > 1 then return([castext_concat(%_txt, sconcat(str_ambiguous_pre, %_namestex, str_notfound_post)), false]),
  %_i: first(%_idx),
  %_mn: %_o[%_i][2],
  %_dref: if listp(%_dir) then ["force", 1, [0,0], %_dir]
          else ["force", 1, [0,0], [cos(%_dir*%pi/180), sin(%_dir*%pi/180)]],
  /* correct direction? report the deviation itself, rounded, rather than just pass/fail. */
  %_devDeg: ev(round(angle(%_dref, %_o[%_i])*180/%pi*10)/10.0, simp),
  if abs(%_devDeg) > %_toldeg then
    return([castext_concat(%_txt, sconcat("\\(", %_mn, str_wrong_direction_mid, fb_numtext(%_devDeg), "°.")), false]),
  /* correct line of action (through %_point)? moment_of_force() with a force magnitude of 1 is
     exactly the signed perpendicular distance from %_point to the line of action, so it can be
     rounded and reported directly, the same way as %_devDeg above. */
  %_devDist: ev(round(moment_of_force(%_point, %_o[%_i], 1, 1)*10)/10.0, simp),
  if listp(%_toldist) then (
    if %_o[1][1] # "grid" then
      return([sconcat("fb_force(): object 1 is not a \"grid\" - cannot determine the scaling factor for a unit-tagged toldist."), false]),
    [%_fx, %_fy]: %_o[1][9],
    if %_fx # %_fy then
      return([sconcat("fb_force(): grid scaling factors fx (", string(%_fx), ") and fy (", string(%_fy), ") differ - a unit-tagged toldist requires equal x/y scaling."), false]),
    %_toldistval: %_toldist[1], %_tolunit: %_toldist[2],
    %_devDist: ev(round(%_devDist*%_fx*10)/10.0, simp),
    if abs(%_devDist) > %_toldistval then
      return([castext_concat(%_txt, sconcat(str_wrong_line_pre, %_mn, str_wrong_line_mid, fb_numtext(%_devDist), " ", %_tolunit, ".")), false])
  ) else (
    if abs(%_devDist) > %_toldist then
      return([castext_concat(%_txt, sconcat(str_wrong_line_pre, %_mn, str_wrong_line_mid, fb_numtext(%_devDist), ".")), false])
  ),
  [castext_concat(%_txt, sconcat("\\(", %_mn, str_found_post)), true]
);

/* https://github.com/mkraska/meclib/wiki/fb_system() */
/* %_names[%_i] is either a state string ("show"/"hide"/"SHOW"/"HIDE") or, once loads have been
   matched to the object, a list of load indices - stringp() guards sdowncase() against the latter.
   The system elements (%_sys) must be shown ("show"/"SHOW"); entries that are no state at all
   (e.g. the name of a node or point) are not checked. The environment elements (%_env) must not
   be shown: "hide"/"HIDE", a list of matched loads, or the legacy "locked".
   As the other feedback functions, the text starts with <br>; the hint is appended after one
   space (leading spaces of the hint are dropped). */
fb_system(%_names, %_sys, %_env, %_hint):=block(
  [%_i, %_s, %_OK: true,
   %_str_ok: sconcat("<br>", fb_lang("Die Systemgrenzen stimmen.", "The system boundaries are correct.")),
   %_str_wrong: sconcat("<br>", fb_lang("Die Systemgrenzen stimmen nicht.", "The system boundaries are incorrect."))],
  for %_i in %_env do if (stringp(%_names[%_i]) and sdowncase(%_names[%_i]) = "show") then %_OK: false,
  for %_i in %_sys do (
    %_s: %_names[%_i],
    if listp(%_s) or (stringp(%_s) and sdowncase(%_s) = "hide") then %_OK: false),
  if %_OK then return([%_str_ok, true]),
  %_hint: striml(" ", %_hint),
  return([if %_hint = "" then %_str_wrong else sconcat(%_str_wrong, " ", %_hint), false])
);

/* https://github.com/mkraska/meclib/wiki/MatchByParallel%28%29 */
matchByParallel(o,n):=block([res, llist],res: [],
    /* for all objects */
    for i:1 thru length(o) do (
        /* if names entry is not a list, copy it to result */
        if (not listp(n[i])) then res: endcons(n[i], res) else (
            /* either a nondirectional item or parallel to the force */
            llist: sublist(n[i], 
                lambda([x], 
                    member(o[i][1], [ "fix12, fix123", "circle"]) or
                    parallelp(o[i], o[x] )
                )
            ),
            res: endcons(llist, res)
        )
    ),
    return(res)
);
