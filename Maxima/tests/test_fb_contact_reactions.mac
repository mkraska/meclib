/* ============================================================================
   Tests for fb_contact_reactions(). Names as in STACK's names input (symbols).
   ============================================================================ */

/* same names and, for the friction direction, the same vector (within 1e-9) */
cr_same(r, e):= is(r[1] = e[1] and r[2] = e[2] and
  (if e[3] = false then r[3] = false else listp(r[3]) and lmax(abs(r[3] - e[3])) < 1e-9))$
cr_check(r, e, label):= fb_check(["", cr_same(r, e)], true, "", "", label)$

/* contact at B with normal [1,1]; normal force N, friction R along [-1,1], weight G elsewhere */
o_cr: [["contact","",[0,2],[1,1],"Stufe","hide"],
       ["force","N",[-1,1],[0,2],"active"],
       ["force","R",[0,2],[-1,3],"active"],
       ["force","G",[2,1],[2,0],"active"]];
cr_check(fb_contact_reactions(o_cr, [[2,3], N, R, G], 1), [N, R, float([-1,1]/sqrt(2))],
  "fb_contact_reactions normal and friction");

/* order of the loads does not matter */
cr_check(fb_contact_reactions(o_cr, [[3,2], N, R, G], 1), [N, R, float([-1,1]/sqrt(2))],
  "fb_contact_reactions order");

/* only a normal force; an oblique force is neither */
o_cr3: [["contact","",[0,2],[1,1],"Stufe","hide"],
        ["force","N_B",[0,2],[1,3],"active"],
        ["force","F",[0,2],[1,2],"active"]];
cr_check(fb_contact_reactions(o_cr3, [[2,3], N_B, F], 1), [N_B, false, false], "fb_contact_reactions no friction");

/* nothing matched yet (contact not deactivated) */
cr_check(fb_contact_reactions(o_cr, [false, N, R, G], 1), [false, false, false], "fb_contact_reactions nothing");

/* a moment at the point is ignored */
o_cr4: [["contact","",[0,0],[0,1],"Boden","hide"],
        ["moment","M",[0,0],[1,0],[0,1],"active"],
        ["force","N_A",[0,-1],[0,0],"active"]];
cr_check(fb_contact_reactions(o_cr4, [[2,3], M, N_A], 1), [N_A, false, false], "fb_contact_reactions moment ignored");
