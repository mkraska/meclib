/* ============================================================================
   Tests for sum_xyM(): sums of forces and moments from the free-body diagram,
   with and without the options contacts and at.
   ============================================================================ */

/* bar on a smooth floor (contact A at [3,0]) and a rough edge (contact B at [0,2], normal [-2,-3]);
   N_B drawn only roughly along the normal ([0.7,1] instead of [2,3]), R_B along the tangent,
   weight G at [1.1,1.7] */
o_sx: [["contact","",[3,0],[0,-1],"Boden","hide"],
       ["contact","",[0,2],[-2,-3],"Stufe","hide"],
       ["force","N_A",[3,-1],[3,0],"active"],
       ["force","N_B",[-0.7,1.0],[0,2],"active"],
       ["force","R_B",[0,2],[-0.9,2.6],"active"],
       ["force","G",[1.1,1.7],[1.1,0.5],5]];
n_sx: [[3], [4,5], N_A, N_B, R_B, G];

/* exact directions of the contacts, symbolic point of G */
GG_sx: sum_xyM(o_sx, n_sx, [3,0], a, [contacts = [1,2], at = [[6, [xg, yg]]]]);
fb_check_val(GG_sx[1], (2*N_B - 3*R_B)/sqrt(13), "sum_xyM contacts: x");
fb_check_val(GG_sx[2], N_A + (3*N_B + 2*R_B)/sqrt(13) - G, "sum_xyM contacts: y");
fb_check_val(GG_sx[3], -sqrt(13)*a*N_B - G*(xg - 3*a), "sum_xyM contacts, at: moment about A");

/* the same as sin(alpha), cos(alpha) with tan(alpha) = 2/3 */
fb_check_val(subst(alpha = atan(2/3), N_B*sin(alpha) - R_B*cos(alpha)) - GG_sx[1], 0, "sum_xyM contacts: x as in the question");

/* without options: directions of the arrows (rounded to 0.1), points of the sketch */
GG_old: sum_xyM(o_sx, n_sx, [3,0], a);
fb_check_val(GG_old[1], 7*N_B/sqrt(149) - 3*R_B/sqrt(13), "sum_xyM without options: x");
fb_check_val(GG_old[2], N_A + 10*N_B/sqrt(149) + 2*R_B/sqrt(13) - G, "sum_xyM without options: y");

/* only one contact listed: the other force keeps its drawn direction */
GG_one: sum_xyM(o_sx, n_sx, [3,0], a, [contacts = [1]]);
fb_check_val(GG_one[1], 7*N_B/sqrt(149) - 3*R_B/sqrt(13), "sum_xyM contact A only: x");

/* sumF() and sumM(): the same sums one by one; direction from a "dir" object */
fb_check_val(sumF(o_sx, n_sx, [1,0], [contacts = [1,2]]), GG_sx[1], "sumF x");
fb_check_val(sumF(o_sx, n_sx, [0,2], [contacts = [1,2]]), GG_sx[2], "sumF y (direction not normalized)");
fb_check_val(sumM(o_sx, n_sx, [3,0], a, [contacts = [1,2], at = [[6, [xg, yg]]]]), GG_sx[3], "sumM about A");
o_sxd: append(o_sx, [["dir", "\\xi", [0,0], 90]]);
fb_check_val(sumF(o_sxd, append(n_sx, [xi]), 7, [contacts = [1,2]]), GG_sx[2], "sumF along a dir object");
/* about B: N_B and R_B have no moment, N_A has */
fb_check_val(sumM(o_sx, n_sx, [0,2], a, [contacts = [1,2], at = [[6, [xg, yg]]]]),
  3*a*N_A - G*xg, "sumM about B");
/* legacy without options unchanged */
fb_check_val(sumF(o_sx, n_sx, [1,0]), GG_old[1], "sumF without options = sum_xyM");
