/* ============================================================================
   Offline test harness for meclib's Maxima feedback functions
   (../fb_fbd.mac, ../fb_value.mac).

   This provides castext() - a renderer for the castext2 blocks the feedback
   functions use - and a small, faithful reimplementation of STACK's own
   [[lang code='...']] selection rule
   (see https://docs.stack-assessment.org/en/Authoring/Languages/), so a
   test case can check the EXACT text a student would see in either
   language, not just whether the function returned true/false. That is
   the point of this suite: catching missing/spurious spaces, commas,
   periods, or line breaks in the rendered feedback before they ever
   reach Moodle.

   Naming follows the test convention used by STACK's own Maxima library
   (s_test_fails/s_test_success, see
   stack/maxima/maximasrccompiled_tests.mac in maths/moodle-qtype_stack),
   so this stays recognisable to anyone familiar with that convention.
   The single entry point here, fb_check(), differs from STACK's own
   s_exec_test() in one way: on failure it prints the exact mismatched
   field (flag / de text / en text) with a got/expected diff, since a
   bare pass/fail is not enough to spot a one-character formatting glitch.
   ============================================================================ */

/* ---- relation to STACK ----
   run_tests.mac loads STACK's own Maxima library first (required), so
   castext_concat(), ct2_latex(), stack_disp...(), real_numberp() and the
   answer tests are the real ones. Only castext() itself is provided here
   (below): STACK's PHP compiler turns each castext("...") literal into Maxima
   code at question compile time, so there is no castext() function in the
   library to load. The renderer below produces the same text as that
   compiled code: {@expr@} goes through the library's own ct2_latex(), exactly
   as compiled castext does. */
if not(?boundp('meclib_real_stack_loaded)) or meclib_real_stack_loaded # true then
  error("harness.mac needs STACK's Maxima library - load the suite via run_tests.mac")$

/* fb_bar_name() reads the question-level `debug` flag to decide whether a handful of its
   early pre-checks show a diagnostic message or stay silent; STACK questions that don't set
   it themselves get it false from stack_options, so default it the same way here - without
   this, referencing an entirely unbound `debug` would error instead of acting as false. */
if not(?boundp('debug)) then debug: false$

/* ---- castext2 templating stub: {@expr@}, [[define]], [[foreach]], [[if]]/[[else]] ----
   The real castext() is generated per-question by STACK's PHP compiler, so there is
   nothing to "load" for it even when the real stack/maxima library is present (see the
   comment block above). What it actually resolves CAS-side has to be reimplemented here
   instead of just stubbed as an identity, so that fb_bar()/fb_bar_name()/fb_q()/fb_dir()
   (via fb_strip_list()) - every function in this codebase using {@expr@} or
   [[foreach]]/[[define]]/[[if]] - can be exercised offline at all, not just the
   already-i18n-converted "split-parts" functions that only ever use [[lang]].

   {@expr@} evaluates `expr` as a Maxima expression IN THE CALLER'S OWN ENVIRONMENT: a
   block-local of the function that called castext() (e.g. fb_q's own `ir`/`n`) is visible
   here because Maxima's block-local variables are dynamically (not lexically) bound, so
   any function called during that block's execution sees them - confirmed empirically
   with a throwaway probe script before writing this. ev(parse_string(expr), eval) is the
   idiom that forces that second-level evaluation; plain ev(parse_string(expr)) alone does
   NOT re-evaluate a parsed bare symbol (also confirmed empirically) - the explicit `eval`
   flag is required.

   [[define name='expr'/]] and [[foreach var='listexpr']] bind a *global* variable (via
   the "::"-by-name-assignment operator) rather than a true block-local - adequate here
   since every known template using them (fb_strip_list()) is self-contained and never
   nested inside another running [[foreach]], but it does mean these two constructs,
   unlike {@...@}, don't need any special scope trick of their own.

   [[lang code='...']]...[[/lang]] is NOT handled here - that selection happens later, in
   resolve_lang() below, when a test calls fb_check(). A string can freely mix both systems
   (an {@...@} placeholder inside a [[lang]] block, as a bilingual function will do) because
   this renderer only recognizes "[[define", "[[foreach", "[[if" and "{@" as its own tags;
   "[[lang"/"[[/lang]]" is just ordinary text to it and passes through untouched, to be
   resolved by the separate, later pass. */
fb_tmpl_eval_expr(%_src):= ev(parse_string(%_src), eval)$
/* {@expr@} -> text, exactly as STACK does it: compiled castext calls the library's
   ct2_latex(value, "i", simp), which gives ["smlt", "\\({{S}_{10}}\\)"] for a CAS value and
   ["smlt", "17"] for a string (castext2 latex block, stack/maxima/stackstrings.mac); the
   smlt payload is what the student sees. */
fb_tmpl_smlt_text(%_r):= if stringp(%_r) then %_r
  elseif listp(%_r) and length(%_r) > 0 and %_r[1] = "smlt" then %_r[2]
  elseif listp(%_r) and length(%_r) > 0 and %_r[1] = "%root" then simplode(map(fb_tmpl_smlt_text, rest(%_r)), "")
  else string(%_r)$
fb_tmpl_tostring(%_v):= fb_tmpl_smlt_text(ct2_latex(%_v, if fb_tmpl_md then "im" else "i", simp))$
/* Inside math mode STACK compiles {@expr@} without its own delimiters (latex block,
   mathmode=true -> ct2_latex mode ""): "{...}" instead of "\\({...}\\)". */
fb_tmpl_tostring_math(%_v):= fb_tmpl_smlt_text(ct2_latex(%_v, if fb_tmpl_md then "m" else "", simp))$
/* In Markdown text (fb_tmpl_md: true) the modes are "im" and "m": the same, escaped for
   Markdown with str_to_md(), so that Markdown turns it back into LaTeX. */

/* Math mode after scanning str, starting from state mm (true/false), following STACK's
   castext2 math_paint() (stack/cas/castext2/utils.php). HTML: \\( and \\[ switch it on,
   \\) and \\] off, as do \\begin{...}/\\end{...} of the math environments (align,
   equation, ...); a doubled backslash is a literal one. In Markdown text (fb_tmpl_md: true),
   which still passes through Markdown's backslash escapes, the delimiters count only after
   three backslashes and begin/end after two - the same state machine as STACK's. */
/* All parameters and locals of the castext renderer below carry the prefix %ct_: Maxima
   binds them dynamically, so {@...@} expressions and the functions they call (e.g. fb_unit,
   which uses the unit symbols s, m, t, ... and meclib's own %_ locals) must not see them. */
fb_tmpl_md: false$
fb_tmpl_mathscan(%ct_mm, %ct_str):= block([%ct_k: 1, %ct_i, %ct_j, %ct_c, %ct_n: slength(%ct_str), %ct_last, %ct_dbl, %ct_tri, %ct_delim, %ct_env,
    %ct_envs: ["align","align*","alignat","alignat*","eqnarray","eqnarray*","equation","equation*",
           "gather","gather*","multline","multline*"]],
  while %ct_k <= %ct_n do (
    %ct_i: ssearch("\\", %ct_str, %ct_k),
    if %ct_i = false then %ct_k: %ct_n + 1
    else (
      %ct_j: %ct_i, %ct_last: false, %ct_dbl: false, %ct_tri: false,
      while %ct_j <= %ct_n and charat(%ct_str, %ct_j) = "\\" do (
        if not fb_tmpl_md then %ct_last: not %ct_last
        elseif %ct_dbl then (%ct_last: not %ct_last, %ct_dbl: false, %ct_tri: true)
        elseif %ct_last then (%ct_last: false, %ct_dbl: true)
        elseif not %ct_tri then %ct_last: true,
        %ct_j: %ct_j + 1
      ),
      if %ct_j <= %ct_n then (
        %ct_c: charat(%ct_str, %ct_j),
        %ct_delim: if fb_tmpl_md then %ct_tri else %ct_last,
        %ct_env: if fb_tmpl_md then %ct_dbl else %ct_last,
        if %ct_delim and (%ct_c = "(" or %ct_c = "[") then %ct_mm: true
        elseif %ct_delim and (%ct_c = ")" or %ct_c = "]") then %ct_mm: false
        elseif %ct_env and %ct_c = "b" and some(lambda([%ct_e], is(ssearch(sconcat("begin{", %ct_e, "}"), %ct_str, %ct_j) = %ct_j)
               or (fb_tmpl_md and is(ssearch(sconcat("begin\\{", %ct_e), %ct_str, %ct_j) = %ct_j))), %ct_envs) then %ct_mm: true
        elseif %ct_env and %ct_c = "e" and some(lambda([%ct_e], is(ssearch(sconcat("end{", %ct_e, "}"), %ct_str, %ct_j) = %ct_j)
               or (fb_tmpl_md and is(ssearch(sconcat("end\\{", %ct_e), %ct_str, %ct_j) = %ct_j))), %ct_envs) then %ct_mm: false
      ),
      %ct_k: %ct_j + 1
    )
  ),
  %ct_mm
)$

fb_tmpl_find_next(%ct_s, %ct_pos, %ct_taglist):= block([%ct_best: false, %ct_besttag: false, %ct_p, %ct_t],
  for %ct_t in %ct_taglist do (
    %ct_p: ssearch(%ct_t, %ct_s, %ct_pos),
    if %ct_p # false and (%ct_best = false or %ct_p < %ct_best) then (%ct_best: %ct_p, %ct_besttag: %ct_t)
  ),
  [%ct_best, %ct_besttag]
)$

fb_tmpl_trim(%ct_s):= block([%ct_a:1, %ct_b: slength(%ct_s)+1],
  if slength(%ct_s)>0 and charat(%ct_s,1)=" " then %ct_a:2,
  if slength(%ct_s)>=%ct_a and charat(%ct_s,%ct_b-1)=" " then %ct_b: %ct_b-1,
  substring(%ct_s,%ct_a,%ct_b)
)$

/* Positions of the quotes around an attribute value starting after position eq: the
   value may be in single quotes (as in meclib's own castext) or double quotes (as STACK's
   editor writes them into question texts, e.g. [[if test="a > 0"]]). */
fb_tmpl_quoted(%ct_s, %ct_eq):= block([%ct_q1: false, %ct_ch],
  for %ct_i: %ct_eq+1 thru slength(%ct_s) while %ct_q1 = false do
    if charat(%ct_s, %ct_i) = "'" or charat(%ct_s, %ct_i) = "\"" then %ct_q1: %ct_i,
  %ct_ch: charat(%ct_s, %ct_q1),
  [%ct_q1, ssearch(%ct_ch, %ct_s, %ct_q1+1)]
)$

/* [[define name='expr'/]] (self-closing) starting at pos. Returns the position right
   after the tag; sets the named global variable as a side effect. */
fb_tmpl_do_define(%ct_s, %ct_pos):= block([%ct_eq, %ct_q1, %ct_q2, %ct_name, %ct_exprsrc],
  %ct_eq: ssearch("=", %ct_s, %ct_pos),
  %ct_name: fb_tmpl_trim(substring(%ct_s, %ct_pos+slength("[[define"), %ct_eq)),
  [%ct_q1, %ct_q2]: fb_tmpl_quoted(%ct_s, %ct_eq),
  %ct_exprsrc: substring(%ct_s, %ct_q1+1, %ct_q2),
  parse_string(%ct_name) :: fb_tmpl_eval_expr(%ct_exprsrc),
  ssearch("]]", %ct_s, %ct_q2+1) + 2
)$

/* [[foreach var='expr']] or [[if test='expr']] open tag (NOT self-closing) starting at
   pos. Returns [name, exprsrc, posAfterOpenTag]. */
fb_tmpl_parse_open1(%ct_s, %ct_pos, %ct_prefix):= block([%ct_eq, %ct_q1, %ct_q2, %ct_name, %ct_exprsrc, %ct_tagend],
  %ct_eq: ssearch("=", %ct_s, %ct_pos),
  %ct_name: fb_tmpl_trim(substring(%ct_s, %ct_pos+slength(%ct_prefix), %ct_eq)),
  [%ct_q1, %ct_q2]: fb_tmpl_quoted(%ct_s, %ct_eq),
  %ct_exprsrc: substring(%ct_s, %ct_q1+1, %ct_q2),
  %ct_tagend: ssearch("]]", %ct_s, %ct_q2+1) + 2,
  [%ct_name, %ct_exprsrc, %ct_tagend]
)$

/* Depth-aware scan from pos (just after a [[foreach ...]] open tag) to its matching
   [[/foreach]], so a nested [[if]]/[[foreach]] inside the body isn't mistaken for the
   end (not exercised by any current template, but cheap to get right). Returns
   [rawBody, posAfterCloseTag]. */
fb_tmpl_find_foreach_end(%ct_s, %ct_pos):= block([%ct_bodystart: %ct_pos, %ct_depth: 0, %ct_p, %ct_best, %ct_tag,
    %ct_cands: ["[[if","[[foreach","[[/if]]","[[/foreach]]"], %ct_endpos: false],
  while %ct_endpos = false do (
    [%ct_best, %ct_tag]: fb_tmpl_find_next(%ct_s, %ct_pos, %ct_cands),
    if %ct_best = false then %ct_endpos: slength(%ct_s)+1
    elseif %ct_tag = "[[if" or %ct_tag = "[[foreach" then (%ct_depth: %ct_depth+1, %ct_pos: %ct_best+slength(%ct_tag))
    elseif %ct_depth = 0 then %ct_endpos: %ct_best
    else (%ct_depth: %ct_depth-1, %ct_pos: %ct_best+slength(%ct_tag))
  ),
  [substring(%ct_s, %ct_bodystart, %ct_endpos), %ct_endpos + slength("[[/foreach]]")]
)$

/* Depth-aware split of an [[if]] body into its raw (unevaluated) then/else parts.
   Evaluation happens afterwards, on only the chosen branch, so a side effect in the
   untaken branch never fires and the test is evaluated exactly once, before either
   branch runs. Returns [thenraw, elseraw, posAfterEndifTag]. */
fb_tmpl_split_if_body(%ct_s, %ct_p):= block([%ct_pos: %ct_p, %ct_depth: 0, %ct_elsepos: false, %ct_endpos: false,
    %ct_cands: ["[[if","[[foreach","[[/if]]","[[/foreach]]","[[else]]"], %ct_best, %ct_tag],
  while %ct_endpos = false do (
    [%ct_best, %ct_tag]: fb_tmpl_find_next(%ct_s, %ct_pos, %ct_cands),
    if %ct_best = false then %ct_endpos: slength(%ct_s)+1
    elseif %ct_tag = "[[if" or %ct_tag = "[[foreach" then (%ct_depth: %ct_depth+1, %ct_pos: %ct_best+slength(%ct_tag))
    elseif %ct_tag = "[[else]]" then (
      if %ct_depth = 0 and %ct_elsepos = false then (%ct_elsepos: %ct_best, %ct_pos: %ct_best+slength(%ct_tag))
      else %ct_pos: %ct_best+slength(%ct_tag)
    )
    elseif %ct_depth = 0 then %ct_endpos: %ct_best
    else (%ct_depth: %ct_depth-1, %ct_pos: %ct_best+slength(%ct_tag))
  ),
  if %ct_elsepos = false then
    [substring(%ct_s,%ct_p,%ct_endpos), "", %ct_endpos+slength("[[/if]]")]
  else
    [substring(%ct_s,%ct_p,%ct_elsepos), substring(%ct_s,%ct_elsepos+slength("[[else]]"),%ct_endpos), %ct_endpos+slength("[[/if]]")]
)$

/* Core renderer: walks s left to right, evaluating {@...@}, {#...#}, [[define]],
   [[foreach]], [[if]]/[[else]] and dropping [[comment]]...[[/comment]] (everything else -
   including [[lang]]/[[/lang]] - passes through as plain text, see the comment above this
   block). {#expr#} is STACK's raw output, string(expr): for a string that is a quoted
   literal, which is how e.g. {#init#} becomes a JavaScript string in a [[jsxgraph]] block. */
fb_tmpl_render(%ct_s):= block(
  [%ct_out: "", %ct_pos: 1, %ct_len: slength(%ct_s), %ct_cands: ["[[define","[[foreach","[[if","{@","{#","[[comment]]","[[htmlformat]]"],
   %ct_p, %ct_tag, %ct_inner, %ct_closepos, %ct_val, %ct_var, %ct_exprsrc, %ct_bodyinfo, %ct_rawbody, %ct_listval, %ct_iterout,
   %ct_ifbody, %ct_testval, %ct_mm: false],
  while true do (
    [%ct_p, %ct_tag]: fb_tmpl_find_next(%ct_s, %ct_pos, %ct_cands),
    if %ct_p = false then (
      %ct_out: sconcat(%ct_out, substring(%ct_s, %ct_pos, %ct_len+1)),
      return(%ct_out)
    ),
    %ct_out: sconcat(%ct_out, substring(%ct_s, %ct_pos, %ct_p)),
    %ct_mm: fb_tmpl_mathscan(%ct_mm, substring(%ct_s, %ct_pos, %ct_p)),
    if %ct_tag = "{@" then (
      %ct_closepos: ssearch("@}", %ct_s, %ct_p+2),
      %ct_inner: substring(%ct_s, %ct_p+2, %ct_closepos),
      %ct_val: fb_tmpl_eval_expr(%ct_inner),
      %ct_out: sconcat(%ct_out, if %ct_mm then fb_tmpl_tostring_math(%ct_val) else fb_tmpl_tostring(%ct_val)),
      %ct_pos: %ct_closepos+2
    ) elseif %ct_tag = "{#" then (
      %ct_closepos: ssearch("#}", %ct_s, %ct_p+2),
      %ct_inner: substring(%ct_s, %ct_p+2, %ct_closepos),
      %ct_val: fb_tmpl_eval_expr(%ct_inner),
      %ct_out: sconcat(%ct_out, string(%ct_val)),
      %ct_pos: %ct_closepos+2
    ) elseif %ct_tag = "[[comment]]" then (
      %ct_closepos: ssearch("[[/comment]]", %ct_s, %ct_p),
      %ct_pos: if %ct_closepos = false then %ct_len+1 else %ct_closepos+slength("[[/comment]]")
    ) elseif %ct_tag = "[[htmlformat]]" then (
      /* raw HTML inside Markdown text (the workbench marks Markdown's HTML blocks this way):
         plain LaTeX output and single-backslash math delimiters, as STACK does */
      %ct_closepos: ssearch("[[/htmlformat]]", %ct_s, %ct_p),
      if %ct_closepos = false then %ct_closepos: %ct_len + 1,
      %ct_out: sconcat(%ct_out, block([fb_tmpl_md: false], fb_tmpl_render(substring(%ct_s, %ct_p + slength("[[htmlformat]]"), %ct_closepos)))),
      %ct_pos: min(%ct_len + 1, %ct_closepos + slength("[[/htmlformat]]"))
    ) elseif %ct_tag = "[[define" then (
      %ct_pos: fb_tmpl_do_define(%ct_s, %ct_p)
    ) elseif %ct_tag = "[[foreach" then (
      [%ct_var, %ct_exprsrc, %ct_pos]: fb_tmpl_parse_open1(%ct_s, %ct_p, "[[foreach"),
      [%ct_rawbody, %ct_pos]: fb_tmpl_find_foreach_end(%ct_s, %ct_pos),
      %ct_listval: fb_tmpl_eval_expr(%ct_exprsrc),
      %ct_iterout: "",
      for %ct_item in %ct_listval do (
        parse_string(%ct_var) :: %ct_item,
        %ct_iterout: sconcat(%ct_iterout, fb_tmpl_render(%ct_rawbody))
      ),
      %ct_out: sconcat(%ct_out, %ct_iterout)
    ) elseif %ct_tag = "[[if" then (
      [%ct_var, %ct_exprsrc, %ct_pos]: fb_tmpl_parse_open1(%ct_s, %ct_p, "[[if"),
      [%ct_ifbody, %ct_bodyinfo, %ct_pos]: fb_tmpl_split_if_body(%ct_s, %ct_pos),
      %ct_testval: fb_tmpl_eval_expr(%ct_exprsrc),
      %ct_out: sconcat(%ct_out, fb_tmpl_render(if %ct_testval then %ct_ifbody else %ct_bodyinfo))
    )
  )
)$

castext(%ct_s) := fb_tmpl_render(%ct_s)$

/* ---- STACK's [[lang code='...']] selection rule, reimplemented ----
   Walks s left to right. Outside any [[lang]]...[[/lang]] block, text
   passes through unchanged (e.g. plain HTML markup, object names).

   Every translatable fragment in this codebase is written as exactly
   two ADJACENT blocks - one for 'de', one for the 'en,other' fallback -
   with no plain text between them. The selection has to be done across
   that pair at once, not block-by-block: picking "the first block
   whose code list contains `lang`, OR contains 'other'" independently
   per block would wrongly also keep the 'en,other' fallback block even
   when the preceding 'de' block already matched.

   Two DIFFERENT fragments can also sit directly adjacent to each other
   with no plain text in between (e.g. two hoisted str_* variables
   concatenated back to back) - so grouping has to stop at exactly 2
   blocks per decision, never swallow a longer run of adjacent blocks,
   or two separate fragments get merged into one and only one survives. */
fb_test_split_csv(s) := block([parts: [], start: 1, p, len: slength(s)],
  for p: 1 thru len do
    if charat(s, p) = "," then (parts: endcons(substring(s, start, p), parts), start: p + 1),
  parts: endcons(substring(s, start, len + 1), parts),
  parts
)$

/* Parses one [[lang code='...']]...[[/lang]] block starting exactly at
   position `start`. Returns [codes, body, nextpos]. */
fb_test_parse_lang_block(s, start) := block(
  [tagend, codestart, codeend, codes, bodyend, body, q],
  tagend: ssearch("]]", s, start),
  q: fb_tmpl_quoted(s, ssearch("=", s, start)),
  codestart: q[1] + 1,
  codeend: q[2],
  codes: fb_test_split_csv(substring(s, codestart, codeend)),
  bodyend: ssearch("[[/lang]]", s, tagend),
  body: substring(s, tagend + 2, bodyend),
  [codes, body, bodyend + slength("[[/lang]]")]
)$

/* True if s starting at `pos` begins with the literal text `prefix`. */
fb_test_starts_with(s, pos, prefix) := block([plen: slength(prefix)],
  if pos + plen - 1 > slength(s) then false else substring(s, pos, pos + plen) = prefix
)$

/* STACK's own rule, used by the workbench's question preview: STACK picks ONE language per
   question (stack_multilang::pick_lang() - the user's language if the question text uses it,
   else "other", else the first one used) and compiles every [[lang code='...']] block to
   is_lang(...) checks, so a block is shown exactly if that code is among its codes. code ""
   (question text without any [[lang]] block, so no language is set) shows no block at all,
   as in Moodle. resolve_lang() below is the per-pair variant the offline tests use; for
   meclib's own [[lang code='de']]/[[lang code='en,other']] pairs both give the same text. */
stack_resolve_lang(s, code) := block([out: "", pos: 1, len: slength(s), tagstart, parsed],
  if not stringp(s) then return(s),
  while pos <= len do (
    tagstart: ssearch("[[lang", s, pos),
    if tagstart = false then (out: sconcat(out, substring(s, pos, len + 1)), pos: len + 1)
    else (
      out: sconcat(out, substring(s, pos, tagstart)),
      parsed: fb_test_parse_lang_block(s, tagstart),
      if member(code, map(lambda([c], ssubst("_", "-", sdowncase(c))), parsed[1])) then
        out: sconcat(out, parsed[2]),
      pos: parsed[3]
    )
  ),
  out
)$

resolve_lang(s, lang) := block(
  [out: "", pos: 1, len: slength(s), tagstart, cur, parsed,
   group_codes, group_bodies, chosen, found, i],
  if not stringp(s) then return(s),
  while pos <= len do (
    tagstart: ssearch("[[lang", s, pos),
    if tagstart = false then (
      out: sconcat(out, substring(s, pos, len + 1)),
      pos: len + 1
    ) else (
      out: sconcat(out, substring(s, pos, tagstart)),
      /* collect exactly one pair of adjacent [[lang]] blocks (see note
         above on why this must not swallow more than 2) */
      group_codes: [], group_bodies: [],
      cur: tagstart,
      parsed: fb_test_parse_lang_block(s, cur),
      group_codes: endcons(parsed[1], group_codes),
      group_bodies: endcons(parsed[2], group_bodies),
      cur: parsed[3],
      if fb_test_starts_with(s, cur, "[[lang") then (
        parsed: fb_test_parse_lang_block(s, cur),
        group_codes: endcons(parsed[1], group_codes),
        group_bodies: endcons(parsed[2], group_bodies),
        cur: parsed[3]
      ),
      /* choose: exact match first, "other" fallback otherwise */
      chosen: "", found: false,
      for i: 1 thru length(group_codes) do
        if not found and member(lang, group_codes[i]) then (chosen: group_bodies[i], found: true),
      if not found then
        for i: 1 thru length(group_codes) do
          if not found and member("other", group_codes[i]) then (chosen: group_bodies[i], found: true),
      out: sconcat(out, chosen),
      pos: cur
    )
  ),
  out
)$

/* ---- tiny test runner ---- */
s_test_fails: 0$
s_test_success: 0$

/* fb_check(result, expected_ok, expected_de, expected_en, label)
   result: the raw [text, flag] a feedback function returned.
   Renders `text` for "de" and for "en" via resolve_lang() and compares
   each, plus the flag, against the expected values with EXACT string
   equality (deliberately strict - a missing space or period is a
   failure here, not something to eyeball away). Prints a precise diff
   per mismatched field and updates the pass/fail counters. Returns
   true/false so a test file can also assert on it directly if useful. */
fb_check(result, expected_ok, expected_de, expected_en, label) := block(
  [text: result[1], ok: result[2], de, en, pass: true],
  de: resolve_lang(text, "de"),
  en: resolve_lang(text, "en"),
  if ok # expected_ok then (
    pass: false,
    print(sconcat("FAIL [", label, "] flag: got ", string(ok), ", expected ", string(expected_ok)))
  ),
  if de # expected_de then (
    pass: false,
    print(sconcat("FAIL [", label, "] de:   got <<", de, ">>")),
    print(sconcat("              expected <<", expected_de, ">>"))
  ),
  if en # expected_en then (
    pass: false,
    print(sconcat("FAIL [", label, "] en:   got <<", en, ">>")),
    print(sconcat("              expected <<", expected_en, ">>"))
  ),
  if pass then s_test_success: s_test_success + 1 else s_test_fails: s_test_fails + 1,
  pass
)$

/* fb_check_str(result, expected_de, expected_en, label)
   For functions that return a bare castext2 STRING directly (fb_vars(), fb_unit(),
   fb_number()), not the [text, flag] pair fb_check() expects - there is no separate
   ok/not-ok flag to compare; "" is itself the "ok, say nothing" result, same as any
   other exact expected string. */
fb_check_str(result, expected_de, expected_en, label) := block(
  [de: resolve_lang(result, "de"), en: resolve_lang(result, "en"), pass: true],
  if de # expected_de then (
    pass: false,
    print(sconcat("FAIL [", label, "] de:   got <<", de, ">>")),
    print(sconcat("              expected <<", expected_de, ">>"))
  ),
  if en # expected_en then (
    pass: false,
    print(sconcat("FAIL [", label, "] en:   got <<", en, ">>")),
    print(sconcat("              expected <<", expected_en, ">>"))
  ),
  if pass then s_test_success: s_test_success + 1 else s_test_fails: s_test_fails + 1,
  pass
)$

/* fb_check_val(actual, expected, label)
   For functions that return a plain CAS value rather than feedback text
   (fb_dim(), deg2rad()). Compares via ratsimp of the difference, so two
   algebraically equal but differently-formed expressions still match. */
fb_check_val(actual, expected, label) := block([pass: is(ratsimp(actual - expected) = 0)],
  if pass then s_test_success: s_test_success + 1
  else (
    s_test_fails: s_test_fails + 1,
    print(sconcat("FAIL [", label, "] got <<", string(actual), ">> expected <<", string(expected), ">>"))
  ),
  pass
)$

s_test_summary() := print(sconcat(string(s_test_success), " passed, ", string(s_test_fails), " failed"))$
