/* ============================================================================
   Tests for fb_unique_names().
   ============================================================================ */

/* two contacts A, B and a fixed support C; G is no reaction */
o_un: [["contact","A",[0,0],[0,1],"hide"],
       ["contact","B",[4,2],[-1,0],"hide"],
       ["fix12","C",[8,0],0,"hide"],
       ["force","N",[0,0],[0,1],"active"],
       ["force","N_B",[4,2],[3,2],"active"],
       ["force","C_x",[8,0],[9,0],"active"],
       ["force","C_y",[8,0],[8,1],"active"],
       ["force","G",[4,1],[4,0],"active"]];
n_un: [[4], [5], [6,7], "N", "N_B", "C_x", "C_y", "G"];
fb_check(fb_unique_names(o_un, n_un, [1,2,3]), true, "", "", "fb_unique_names all different");

/* same name at two supports */
o_un2: copylist(o_un);
o_un2[5]: ["force","N",[4,2],[3,2],"active"];
fb_check(fb_unique_names(o_un2, n_un, [1,2,3]), false,
  "Der Name \\(N\\) wird für mehrere Reaktionen verwendet (A, B). Reaktionen brauchen verschiedene Namen.",
  "The name \\(N\\) is used for more than one reaction (A, B). Reactions need different names.",
  "fb_unique_names same name at two supports");

/* only the listed supports are compared */
fb_check(fb_unique_names(o_un2, n_un, [1,3]), true, "", "", "fb_unique_names support not listed");

/* same name at one support, and a second repeated name */
o_un3: copylist(o_un2);
o_un3[7]: ["force","C_x",[8,0],[8,1],"active"];
fb_check(fb_unique_names(o_un3, n_un, [1,2,3]), false,
  "Der Name \\(C_x\\) wird für mehrere Reaktionen verwendet (C). Reaktionen brauchen verschiedene Namen.<br>Der Name \\(N\\) wird für mehrere Reaktionen verwendet (A, B). Reaktionen brauchen verschiedene Namen.",
  "The name \\(C_x\\) is used for more than one reaction (C). Reactions need different names.<br>The name \\(N\\) is used for more than one reaction (A, B). Reactions need different names.",
  "fb_unique_names two repeated names");

/* a reaction named like a load elsewhere is not checked (loads are not in n[support]) */
o_un4: copylist(o_un);
o_un4[4]: ["force","G",[0,0],[0,1],"active"];
fb_check(fb_unique_names(o_un4, n_un, [1,2,3]), true, "", "", "fb_unique_names load not compared");

/* support without reactions */
n_un5: [[], [5], [6,7], "N", "N_B", "C_x", "C_y", "G"];
fb_check(fb_unique_names(o_un, n_un5, [1,2,3]), true, "", "", "fb_unique_names empty support");

/* unnamed supports (contacts with "" as label): no list in brackets */
o_un6: [["contact","",[0,0],[0,1],"Boden","hide"],
        ["contact","",[4,2],[-1,0],"Stufe","hide"],
        ["force","N",[0,-1],[0,0],"active"],
        ["force","N",[3,2],[4,2],"active"]];
fb_check(fb_unique_names(o_un6, [[3], [4], "N", "N"], [1,2]), false,
  "Der Name \\(N\\) wird für mehrere Reaktionen verwendet. Reaktionen brauchen verschiedene Namen.",
  "The name \\(N\\) is used for more than one reaction. Reactions need different names.",
  "fb_unique_names unnamed supports");
