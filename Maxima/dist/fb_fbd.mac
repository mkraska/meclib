str_is_not_deactivated: castext("[[lang code='de']] ist nicht deaktiviert.[[/lang]][[lang code='en,other']] is not deactivated.[[/lang]]"),
str_are_not_deactivated: castext("[[lang code='de']] sind nicht deaktiviert.[[/lang]][[lang code='en,other']] are not deactivated.[[/lang]]"),
str_no_reaction: castext("[[lang code='de']]Keine Reaktion gefunden.[[/lang]][[lang code='en,other']]No reaction found.[[/lang]]"),
str_more_than_one: castext("[[lang code='de']]Mehr als eine Reaktion gefunden.[[/lang]][[lang code='en,other']]More than one reaction found.[[/lang]]"),
str_must_be_force: castext("[[lang code='de']]Die Reaktion muss eine Kraft sein.[[/lang]][[lang code='en,other']]The reaction must be a force.[[/lang]]"),
str_wrong_direction_pre: castext("[[lang code='de']]Die Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
str_wrong_direction_post: castext("[[lang code='de']]\\) hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]\\) does not have the correct direction.[[/lang]]"),
str_must_be_compressive_pre: castext("[[lang code='de']]Die Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
str_must_be_compressive_post: castext("[[lang code='de']]\\) muss eine Druckkraft sein.[[/lang]][[lang code='en,other']]\\) must be a compressive force.[[/lang]]"),
str_found_pre: castext("[[lang code='de']]Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
str_found_post: castext("[[lang code='de']]\\) gefunden.[[/lang]][[lang code='en,other']]\\) found.[[/lang]]")],
if ( %_o[%_i][1] # "contact" ) then return ([sconcat(%_txt, "object ", string(%_i), " is not a contact."), false]),
%_ref: %_o[%_i][5],
%_j: fb_resolve_ref(%_o, %_ref),
if %_j = false then return ([sconcat(%_txt, "fb_contact(): referenced object '",
if stringp(%_ref) then %_ref else string(%_ref), "' not found or ambiguous."), false]),
%_jlist: if listp(%_j) then %_j else [%_j],
%_pending: sublist(%_jlist, lambda([%_k], last(%_o[%_k]) # "hide")),
if %_pending # [] then (
%_names: map(lambda([%_k], if %_o[%_k][2] = "" then str_environment else %_o[%_k][2]), %_pending),
return ([castext_concat(%_txt, castext_concat(simplode(%_names, str_and),
if length(%_pending) = 1 then str_is_not_deactivated else str_are_not_deactivated)), false])
),
if not (%_opt = [] or (length(%_opt) = 1 and member(%_opt[1], ["", "smooth"])))
then return(fb_contact_rough(%_o, %_n, %_i, %_txt, %_opt)),
if not listp(%_n[%_i]) or %_n[%_i]=[] then return([castext_concat(%_txt, str_no_reaction), false]),
if (length(%_n[%_i]) > 1) then return( [castext_concat(%_txt, str_more_than_one), false]),
if ( %_o[%_n[%_i][1]][1] # "force" ) then return ([castext_concat(%_txt, str_must_be_force), false]),
%_R: %_o[%_n[%_i][1]],
%_mn: %_n[%_n[%_i][1]],
if not parallelp(%_R, %_o[%_i]) then return ([castext_concat(%_txt, sconcat(str_wrong_direction_pre, %_mn, str_wrong_direction_post)),false]),
%_dR: direction(%_R), %_dC: direction(%_o[%_i]),
if is(%_dR[1]*%_dC[1] + %_dR[2]*%_dC[2] >= 0) then
return ([castext_concat(%_txt, sconcat(str_must_be_compressive_pre, %_mn, str_must_be_compressive_post)),false]),
return([castext_concat(%_txt, sconcat(str_found_pre, %_mn, str_found_post)),true])
);
