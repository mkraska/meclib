fb_objects(%_objects):= block([simp: true, %_st: [[]], %_mode: 0, %_buf: [], %_esc: false, %_u: 0, %_hex: [], %_c, %_top, %_lit: []],
if not stringp(%_objects) then return(%_objects),
if sposition("{", %_objects) # false then return(stackjson_parse(%_objects)),
for %_c in append(charlist(%_objects), [" "]) do (
if %_mode = 1 then (
if %_u > 0 then (%_hex: cons(%_c, %_hex), %_u: %_u - 1,
if %_u = 0 then %_buf: cons(unicode(stack_string_hex_to_num(simplode(reverse(%_hex)))), %_buf))
else if %_esc then (%_esc: false,
if %_c = "u" then (%_u: 4, %_hex: [])
else %_buf: cons(if %_c = "n" then ascii(10) else if %_c = "t" then ascii(9) else if %_c = "r" then ascii(13)
else if %_c = "b" then ascii(8) else if %_c = "f" then ascii(12) else %_c, %_buf))
else if %_c = "\\" then %_esc: true
else if %_c = "\"" then (%_st: cons(cons(simplode(reverse(%_buf)), first(%_st)), rest(%_st)), %_mode: 0)
else %_buf: cons(%_c, %_buf))
else (
if %_mode = 2 and sposition(%_c, "0123456789.eE+-") = false then (
%_st: cons(cons(stack_string_parse_number(simplode(reverse(%_buf))), first(%_st)), rest(%_st)), %_mode: 0),
if %_mode = 3 and not alphacharp(%_c) then (
%_lit: simplode(reverse(%_buf)),
%_st: cons(cons(if %_lit = "true" then true else if %_lit = "false" then false else und, first(%_st)), rest(%_st)),
%_mode: 0),
if %_mode = 2 or %_mode = 3 then %_buf: cons(%_c, %_buf)
else if %_c = "[" then %_st: cons([], %_st)
else if %_c = "]" then (%_top: reverse(first(%_st)), %_st: rest(%_st), %_st: cons(cons(%_top, first(%_st)), rest(%_st)))
else if %_c = "\"" then (%_mode: 1, %_buf: [])
else if %_c = "-" or digitcharp(%_c) then (%_mode: 2, %_buf: [%_c])
else if alphacharp(%_c) then (%_mode: 3, %_buf: [%_c]))),
if length(%_st) # 1 or length(first(%_st)) # 1 then return(stackjson_parse(%_objects)),
first(first(%_st))
);
direction(o):=block([%_v, a0, le, r1, r2, a1],
if member(o[1], ["bar", "force", "dashpot", "springt", "springc"]) then return(o[4]-o[3]),
if member(o[1], ["fix1"]) then return([-sin(o[4]*%pi/180), cos(o[4]*%pi/180)]),
if member(o[1], ["fix13", "dir", "disp"]) then return([cos(o[4]*%pi/180), sin(o[4]*%pi/180)]),
if member(o[1], ["contact"]) then return(o[4]),
if member(o[1], ["q"]) then (
%_v: o[5]-o[4], le: cabs(%_v[1]+%i*%_v[2]), a0: carg(%_v[1]+%i*%_v[2]),
return([cos(a0+o[8]*pi/180), sin(a0+o[8]*pi/180)])
),
if member(o[1], ["rope"]) then (
%_v: o[5]-o[3], le: cabs(%_v[1]+%i*%_v[2]), a0: carg(%_v[1]+%i*%_v[2]),
r1: o[4], r2: o[6], a1: acos((r1-r2)/le),
return(float(%_v+[(r2-r1)*cos(a0-a1), (r2-r1)*sin(a0-a1)]))
)
);
angle(a,b):= block([da,db],
da: direction(a), db: direction(b),
if listp(da) and listp(db) then
return(-carg(da[1]+%i*da[2])+carg(db[1]+%i*db[2]) )
);
moment_of_force(p, f, fname, rname):=block([vf,vr],
vf: (f[4]-f[3]),
vf: vf/sqrt(vf[1]^2+vf[2]^2)*fname,
vr: (f[3]-p)*rname,
vr[1]*vf[2]-vr[2]*vf[1]
);
unitvec(l):=block( [v] , v:round((l[4]-l[3])*10),ratexpand(v/sqrt(v[1]^2+v[2]^2)));
msign(l):=block( [v1,v2] , v1:l[4]-l[3],v2:l[5]-l[3],round(signum(v1[1]*v2[2]-v1[2]*v2[1])));
moment(p, f, fname, rname):=block([vf,vr],
vf: unitvec(f)*fname,
vr: round((f[3]-p)*10)/10*rname,
vr[1]*vf[2]-vr[2]*vf[1]);
fb_sum_prep(o, n, %_options):= block([%_get, %_dir, %_pt, %_u, %_uf, %_t, %_d, %_c, %_k, %_e],
%_get: lambda([%_key], block([%_v: false],
for %_e in %_options do if equationp(%_e) and string(lhs(%_e)) = %_key then %_v: rhs(%_e), %_v)),
%_dir: makelist(false, length(o)), %_pt: makelist(false, length(o)),
if listp(%_get("contacts")) then for %_c in %_get("contacts") do if listp(n[%_c]) then (
%_u: o[%_c][4], %_u: ratsimp(%_u/sqrt(%_u . %_u)), %_uf: float(%_u), %_t: [-%_u[2], %_u[1]],
for %_k in n[%_c] do if o[%_k][1] = "force" then (
%_d: float(o[%_k][4] - o[%_k][3]), %_d: %_d/sqrt(%_d . %_d),
if abs(%_d[1]*%_uf[2] - %_d[2]*%_uf[1]) < 0.05 then %_dir[%_k]: signum(%_d . %_uf)*%_u
else if abs(%_d . %_uf) < 0.05 then %_dir[%_k]: signum(%_d . float(%_t))*%_t,
if %_dir[%_k] # false then %_pt[%_k]: ["grid", o[%_c][3]])),
if listp(%_get("at")) then for %_e in %_get("at") do %_pt[%_e[1]]: ["len", %_e[2]],
[%_dir, %_pt]
);
sumF(o, n, d, [%_options]):= block([%_pd, %_f: 0, %_v, i],
if integerp(d) then d: direction(o[d]),
d: ratsimp(d/sqrt(d . d)),
%_pd: fb_sum_prep(o, n, if %_options = [] then [] else %_options[1]),
for i: 1 thru length(o) do if o[i][1] = "force" then (
%_v: if %_pd[1][i] # false then %_pd[1][i] else unitvec(o[i]),
%_f: %_f + n[i]*(%_v . d)),
ratsimp(%_f)
);
sumM(o, n, p, lu, [%_options]):= block([%_pd, %_m: 0, %_v, %_r, i],
%_pd: fb_sum_prep(o, n, if %_options = [] then [] else %_options[1]),
for i: 1 thru length(o) do (
if o[i][1] = "force" then (
%_v: if %_pd[1][i] # false then %_pd[1][i] else unitvec(o[i]),
if %_pd[2][i] = false then %_m: %_m + moment(p, o[i], n[i], lu)
else (
%_r: if %_pd[2][i][1] = "len" then %_pd[2][i][2] - p*lu else (%_pd[2][i][2] - p)*lu,
%_m: %_m + n[i]*(%_r[1]*%_v[2] - %_r[2]*%_v[1]))),
if o[i][1] = "moment" then %_m: %_m + n[i]*msign(o[i])),
%_m
);
sum_xyM(o, n, p, lu, [%_options]):= block([%_op: if %_options = [] then [] else %_options[1]],
[sumF(o, n, [1,0], %_op), sumF(o, n, [0,1], %_op), sumM(o, n, p, lu, %_op)]
);
sum_dir(o,n,d):=block([f: 0, v, u],
for i:1 thru length(o) do (
if (o[i][1]="force") then (
v: o[i][4]-o[i][3],
u: v/sqrt(v[1]^2+v[2]^2),
f: f+n[i]*(u[1]*d[1]+u[2]*d[2])
)
),
f
);
parallelp(a,b):= block([da,db],
da: direction(a), db: direction(b),
if listp(da) and listp(db) then
return(is (abs(da[1]*db[2]-da[2]*db[1])<0.05) )
);
perpendicularp(a,b):= block([da,db],
da: direction(a), db: direction(b),
if listp(da) and listp(db) then
return(is (abs(da[1]*db[1]+da[2]*db[2])<0.05) )
);
contributor(o, n, i_dir, tol):= block([d: direction(o[i_dir]), v, u, result: []],
for i: 1 thru length(o) do (
if o[i][1] = "force" then (
v: o[i][4]-o[i][3],
u: v/sqrt(v[1]^2+v[2]^2),
if abs(u[1]*d[1]+u[2]*d[2]) > tol then result: cons(n[i], result)
)
),
reverse(result)
);
fb_dir(%_o, %_n, %_dirs, %_tol):= block([%_ok: true, %_parts: [], %_contrib, %_i, %_desc, %_sentence, %_text, %_k,
str_parallel: castext("[[lang code='de']]Die gewählten Richtungen sind parallel. Damit liefern die beiden Gleichgewichtsbedingungen keine voneinander unabhängigen Gleichungen.[[/lang]][[lang code='en,other']]The chosen directions are parallel. The two equilibrium conditions would then not provide independent equations.[[/lang]]"),
str_none_pre: castext("[[lang code='de']]Keine Kraft hat Anteile [[/lang]][[lang code='en,other']]No force has components [[/lang]]"),
str_has_mid: castext("[[lang code='de']] hat Anteile [[/lang]][[lang code='en,other']] has components [[/lang]]"),
str_have_mid: castext("[[lang code='de']] haben Anteile [[/lang]][[lang code='en,other']] have components [[/lang]]")],
if length(%_dirs) = 2 and parallelp(%_o[%_dirs[1][1]], %_o[%_dirs[2][1]]) then (
%_ok: false,
%_parts: cons(str_parallel, %_parts)
),
for %_pair in %_dirs do (
%_i: %_pair[1], %_desc: %_pair[2],
%_contrib: contributor(%_o, %_n, %_i, %_tol),
%_sentence: if %_contrib = [] then
castext_concat(str_none_pre, castext_concat(%_desc, "."))
elseif length(%_contrib) = 1 then
castext_concat(castext_concat(fb_strip_list(%_contrib), str_has_mid), castext_concat(%_desc, "."))
else
castext_concat(castext_concat(fb_strip_list(%_contrib), str_have_mid), castext_concat(%_desc, ".")),
%_parts: cons(%_sentence, %_parts)
),
%_parts: reverse(%_parts),
%_text: %_parts[1],
for %_k: 2 thru length(%_parts) do %_text: castext_concat(%_text, castext_concat("<br>", %_parts[%_k])),
[%_text, %_ok]
);
fb_force_hvxy(o,i):=block([dir, name, nl, base, idx,
str_multiletter: castext("[[lang code='de']]\\): Physikalische Gr&ouml;&szlig;en immer nur mit einem Buchstabe und eventuell Index schreiben, z.B. <code>F_1</code>.[[/lang]][[lang code='en,other']]\\): always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>.[[/lang]]"),
str_noindex: castext("[[lang code='de']]\\) sollte einen Richtungsindex (x, y, h, v) haben.[[/lang]][[lang code='en,other']]\\) should have a direction index (x, y, h, v).[[/lang]]"),
str_idxlong: castext("[[lang code='de']]\\): Ein Buchstabe sollte für den Index reichen.[[/lang]][[lang code='en,other']]\\): a single letter should be enough for the index.[[/lang]]"),
str_idxunknown: castext("[[lang code='de']]\\): Der Richtungsindex sollte h, v, x oder y sein[[/lang]][[lang code='en,other']]\\): the direction index should be h, v, x or y[[/lang]]"),
str_should_h: castext("[[lang code='de']]\\) m&uuml;sste eine horizontale Kraft bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a horizontal force.[[/lang]]"),
str_should_v: castext("[[lang code='de']]\\) m&uuml;sste eine vertikale Kraft bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a vertical force.[[/lang]]"),
str_should_x: castext("[[lang code='de']]\\) m&uuml;sste eine Kraft in positive x-Richtung (nach rechts) bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a force in the positive x direction (to the right).[[/lang]]"),
str_should_y: castext("[[lang code='de']]\\) m&uuml;sste eine Kraft in positive y-Richtung (nach oben) bezeichnen.[[/lang]][[lang code='en,other']]\\) should denote a force in the positive y direction (upward).[[/lang]]")],
name: o[i][2], nl: split(name,"_"),
if slength(first(nl)) > 1
then return([sconcat("\\(", name, str_multiletter), false]),
if length(nl) # 2
then return([sconcat("\\(", name, str_noindex), false]),
idx: last(nl),
if slength(idx) > 1
then return([sconcat("\\(", name, str_idxlong), false]),
if not member(sdowncase(idx), ["h","v","x","y"])
then return([sconcat("\\(", name, str_idxunknown), false]),
dir: direction(o[i]),
if (sdowncase(idx)="h" and abs(dir[2]) > 0.01) then
return([sconcat("\\(", name, str_should_h), false]),
if (sdowncase(idx)="v" and abs(dir[1]) > 0.01) then
return([sconcat("\\(", name, str_should_v), false]),
if (sdowncase(idx)="x" and (abs(dir[2]) > 0.01 or dir[1] <0) ) then
return([sconcat("\\(", name, str_should_x), false]),
if (sdowncase(idx)="y" and (abs(dir[1]) > 0.01 or dir[2] <0) ) then
return([sconcat("\\(", name, str_should_y), false]),
return(["",true])
);
fb_fix1(%_o, %_n, %_i, %_description):=block(
[%_txt: sconcat("<br>",%_description), %_R,
str_not_deactivated: castext("[[lang code='de']]ist nicht deaktiviert.[[/lang]][[lang code='en,other']]is not deactivated.[[/lang]]"),
str_no_reaction: castext("[[lang code='de']]Keine Reaktion gefunden.[[/lang]][[lang code='en,other']]No reaction found.[[/lang]]"),
str_more_than_one: castext("[[lang code='de']]Mehr als eine Reaktion gefunden.[[/lang]][[lang code='en,other']]More than one reaction found.[[/lang]]"),
str_must_be_force: castext("[[lang code='de']]Die Reaktion muss eine Kraft sein.[[/lang]][[lang code='en,other']]The reaction must be a force.[[/lang]]"),
str_wrong_direction_pre: castext("[[lang code='de']]Die Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
str_wrong_direction_post: castext("[[lang code='de']]\\) hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]\\) does not have the correct direction.[[/lang]]"),
str_found_pre: castext("[[lang code='de']]Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
str_found_post: castext("[[lang code='de']]\\) gefunden.[[/lang]][[lang code='en,other']]\\) found.[[/lang]]")],
if ( %_o[%_i][1] # "fix1" ) then return ([sconcat(%_txt, "object ", string(%_i), " is not a fixed support (fix1)"), false]),
if ( %_o[%_i][length(%_o[%_i])] # "hide") then return ([castext_concat(%_txt, str_not_deactivated), false]),
if not listp(%_n[%_i]) or %_n[%_i]=[] then return([castext_concat(%_txt, str_no_reaction), false]),
if (length(%_n[%_i]) > 1) then return( [castext_concat(%_txt, str_more_than_one), false]),
if ( %_o[%_n[%_i][1]][1] # "force" ) then return ([castext_concat(%_txt, str_must_be_force), false]),
%_R: %_o[%_n[%_i][1]],
if not parallelp(%_R, %_o[%_i]) then return ([castext_concat(%_txt, sconcat(str_wrong_direction_pre, %_R[2], str_wrong_direction_post)),false]),
return([castext_concat(%_txt, sconcat(str_found_pre, %_R[2], str_found_post)),true])
);
fb_fix1_name(%_o, %_n, %_i):=block(
[%_R,
str_single_letter: castext("[[lang code='de']]<br>Ein einzelner Buchstabe sollte f&uuml;r die Bezeichnung der Kraft ausreichen.[[/lang]][[lang code='en,other']]<br>A single letter should be enough to name the force.[[/lang]]"),
str_name_mismatch: castext("[[lang code='de']]<br>Der Name der Reaktionskraft sollte zum Namen des Lagerpunkts passen.[[/lang]][[lang code='en,other']]<br>The reaction force's name should match the name of the support point.[[/lang]]")],
if not listp(%_n[%_i]) then return(["",false]),
%_R: %_o[%_n[%_i][1]],
if slength(%_R[2]) # 1 then return([str_single_letter,false]),
if %_R[2] # %_o[%_i][2] then return([str_name_mismatch, false]),
return(["",true])
);
fb_fix12(o, n, i, description):=block(
[L1, L2, R1, R2,
str_not_deactivated: castext("[[lang code='de']]ist nicht deaktiviert.[[/lang]][[lang code='en,other']]is not deactivated.[[/lang]]"),
str_no_reaction: castext("[[lang code='de']]Keine Reaktion gefunden.[[/lang]][[lang code='en,other']]No reaction found.[[/lang]]"),
str_more_than_two: castext("[[lang code='de']]Mehr als 2 Reaktionen gefunden.[[/lang]][[lang code='en,other']]More than 2 reactions found.[[/lang]]"),
str_less_than_two: castext("[[lang code='de']]Weniger als 2 Reaktionen gefunden.[[/lang]][[lang code='en,other']]Fewer than 2 reactions found.[[/lang]]"),
str_different_names: castext("[[lang code='de']]Die Reaktionen müssen verschiedene Namen haben.[[/lang]][[lang code='en,other']]The reactions must have different names.[[/lang]]"),
str_must_be_force_pre: castext("[[lang code='de']]Die Reaktion \\([[/lang]][[lang code='en,other']]Reaction \\([[/lang]]"),
str_must_be_force_post: castext("[[lang code='de']]\\) muss eine Kraft sein.[[/lang]][[lang code='en,other']]\\) must be a force.[[/lang]]"),
str_parallel_pre: castext("[[lang code='de']]Die Reaktionen \\([[/lang]][[lang code='en,other']]Reactions \\([[/lang]]"),
str_parallel_post: castext("[[lang code='de']]\\) sind parallel.[[/lang]][[lang code='en,other']]\\) are parallel.[[/lang]]"),
str_fix12_found_pre: castext("[[lang code='de']]Reaktionen \\([[/lang]][[lang code='en,other']]Reactions \\([[/lang]]"),
str_fix12_found_post: castext("[[lang code='de']]\\) gefunden. [[/lang]][[lang code='en,other']]\\) found. [[/lang]]")],
txt: sconcat("<br>",description),
if not member(o[i][1], ["fix12"])
then return ([sconcat(txt, "object ", string(i), " (", o[i][1], ") is not a fixed support."), false]),
if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
if (length(n[i]) > 2) then return( [castext_concat(txt, str_more_than_two), false]),
if (length(n[i]) < 2) then return( [castext_concat(txt, str_less_than_two), false]),
R1: o[n[i][1]], R2: o[n[i][2]],
if ( o[n[i][1]][1] # "force" )
then return ([castext_concat(txt, sconcat(str_must_be_force_pre, R1[2], str_must_be_force_post)),false]),
if ( o[n[i][2]][1] # "force" )
then return ([castext_concat(txt, sconcat(str_must_be_force_pre, R2[2], str_must_be_force_post)),false]),
if (R1[2] = R2[2]) then return ([castext_concat(txt, str_different_names),false]),
if parallelp(R1, R2) then return ([castext_concat(txt, sconcat(str_parallel_pre, R1[2], ",", R2[2], str_parallel_post)),false]),
return([castext_concat(txt, sconcat(str_fix12_found_pre, R1[2], ",", R2[2], str_fix12_found_post)),true])
);
fb_fix12_name(o, n, i):=block(
[dir, idx, nl, L, R, txt: "", flag:false,
str_multiletter: castext("[[lang code='de']]\\): Physikalische Gr&ouml;&szlig;en immer nur mit einem Buchstabe und eventuell Index schreiben, z.B. <code>F_1</code>.[[/lang]][[lang code='en,other']]\\): always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>.[[/lang]]"),
