str_found_one_pre: castext("[[lang code='de']]Reaktion [[/lang]][[lang code='en,other']]Reaction [[/lang]]"),
str_found_two_pre: castext("[[lang code='de']]Reaktionen [[/lang]][[lang code='en,other']]Reactions [[/lang]]"),
str_found_post: castext("[[lang code='de']] gefunden.[[/lang]][[lang code='en,other']] found.[[/lang]]")],
%_str: lambda([%_x], if stringp(%_x) then %_x else string(%_x)),
%_tex: lambda([%_x], sconcat("\\(", %_str(%_x), "\\)")),
%_texlist: lambda([%_l], if length(%_l) = 1 then %_tex(%_l[1])
else sconcat(simplode(map(%_tex, rest(%_l, -1)), ", "), str_or, %_tex(last(%_l)))),
%_nm: lambda([%_k], %_str(%_n[%_k])),
%_fr: %_opt[1],
if %_fr = "smooth" then %_fr: "",
%_nn: if length(%_opt) >= 2 then (if listp(%_opt[2]) then map(%_str, %_opt[2]) else [%_str(%_opt[2])]) else [],
%_tn: if length(%_opt) >= 3 then (if listp(%_opt[3]) then map(%_str, %_opt[3]) else [%_str(%_opt[3])]) else [],
%_ig: if length(%_opt) >= 4 then (if listp(%_opt[4]) then map(%_str, %_opt[4]) else [%_str(%_opt[4])]) else [],
%_named: is(%_nn # []),
if %_fr = "static" then (
str_no_friction: str_no_friction_s, str_no_friction_named_pre: str_no_friction_named_pre_s,
str_more_friction: str_more_friction_s, str_not_tangential_pre: str_not_tangential_pre_s,
str_expected_friction: str_expected_friction_s),
%_c: float(direction(%_o[%_i])),
%_u: %_c/sqrt(%_c . %_c), %_t: [-%_u[2], %_u[1]],
%_dn: lambda([%_k], block([%_e: float(direction(%_o[%_k]))],
float(acos(min(1, abs(%_e . %_u)/sqrt(%_e . %_e)))*180/%pi))),
%_deg: lambda([%_x], string(round(%_x))),
if listp(%_fr) then %_v: float(%_fr)
else if stringp(%_fr) and not member(%_fr, ["", "static"]) then (
%_idx: sublist_indices(%_o, lambda([%_x], %_x[1] = "disp" and %_x[2] = %_fr)),
if length(%_idx) # 1 then return([sconcat(%_txt, "fb_contact(): disp object '", %_fr, "' not found or ambiguous."), false]),
%_v: float(direction(%_o[%_idx[1]])), %_vname: %_fr)
else if not stringp(%_fr) then return([sconcat(%_txt, "fb_contact(): invalid friction argument ", string(%_fr), "."), false]),
if listp(%_v) and abs(%_v . %_t) < 1e-6*sqrt(%_v . %_v) then
return([sconcat(%_txt, "fb_contact(): the velocity has no tangential component."), false]),
if %_fr # "" and %_named and %_tn = [] then
return([sconcat(%_txt, "fb_contact(): names of the friction force missing."), false]),
%_L: if listp(%_n[%_i]) then %_n[%_i] else [],
if %_named then (
%_LN: sublist(%_L, lambda([%_k], member(%_nm(%_k), %_nn))),
%_LT: sublist(%_L, lambda([%_k], member(%_nm(%_k), %_tn))),
for %_k in append(%_LN, %_LT) do if %_o[%_k][1] # "force" then
%_msgs: endcons(sconcat(str_must_be_force_pre, %_tex(%_nm(%_k)), str_must_be_force_post), %_msgs),
if %_msgs # [] then return([castext_concat(%_txt, simplode(%_msgs, " ")), false]),
%_LF: sublist(%_L, lambda([%_k], not member(%_nm(%_k), append(%_nn, %_tn, %_ig)))),
for %_k in %_LF do (
if %_o[%_k][1] # "force" then
%_fmsgs: endcons(sconcat(str_must_be_force_pre, %_tex(%_nm(%_k)), str_must_be_force_post), %_fmsgs)
else if sin(%_dn(%_k)*%pi/180) < 0.05 then (
%_hintN: true,
%_fmsgs: endcons(sconcat(str_force_pre, %_tex(%_nm(%_k)), str_acts_normal, str_expected_normal, %_texlist(%_nn), "."), %_fmsgs))
else if cos(%_dn(%_k)*%pi/180) < 0.05 then (
if %_fr = "" then
%_fmsgs: endcons(sconcat(str_force_pre, %_tex(%_nm(%_k)), str_acts_tangential, str_contact_smooth), %_fmsgs)
else (%_hintT: true,
%_fmsgs: endcons(sconcat(str_force_pre, %_tex(%_nm(%_k)), str_acts_tangential, str_expected_friction, %_texlist(%_tn), "."), %_fmsgs)))
else
%_fmsgs: endcons(sconcat(str_force_pre, %_tex(%_nm(%_k)), str_dev_mid,
if %_dn(%_k) <= 45 then sconcat(%_deg(%_dn(%_k)), str_from_normal) else sconcat(%_deg(90 - %_dn(%_k)), str_from_tangent),
if %_fr = "" then sconcat(str_expected_reaction, %_texlist(%_nn), str_normal_paren, ".")
else sconcat(str_expected_reactions, %_texlist(%_nn), str_normal_paren, ", ", %_texlist(%_tn), str_tangential_paren, ".")),
%_fmsgs)))
else (
for %_k in %_L do (
if %_o[%_k][1] # "force" then
%_msgs: endcons(sconcat(str_must_be_force_pre, %_tex(%_nm(%_k)), str_must_be_force_post), %_msgs)
else (
%_d: float(direction(%_o[%_k])), %_d: %_d/sqrt(%_d . %_d),
if abs(%_d[1]*%_u[2] - %_d[2]*%_u[1]) < 0.05 then %_LN: endcons(%_k, %_LN)
else if abs(%_d . %_u) < 0.05 then (
if %_fr = "" then %_msgs: endcons(sconcat(str_smooth_pre, %_tex(%_nm(%_k)), str_smooth_post), %_msgs)
else %_LT: endcons(%_k, %_LT))
else %_msgs: endcons(sconcat(str_wrong_direction_pre, %_tex(%_nm(%_k)), str_dev_mid,
if %_dn(%_k) <= 45 then sconcat(%_deg(%_dn(%_k)), str_from_normal) else sconcat(%_deg(90 - %_dn(%_k)), str_from_tangent)), %_msgs))),
if %_msgs # [] then return([castext_concat(%_txt, simplode(%_msgs, " ")), false])
),
if %_LN = [] then (if not %_hintN then %_msgs: endcons(
if %_named then sconcat(str_no_normal_named_pre, %_texlist(%_nn), str_no_normal_named_post) else str_no_normal, %_msgs))
else if length(%_LN) > 1 then %_msgs: endcons(str_more_normal, %_msgs)
else (
%_k: %_LN[1], %_d: float(direction(%_o[%_k])), %_d: %_d/sqrt(%_d . %_d),
if abs(%_d[1]*%_u[2] - %_d[2]*%_u[1]) >= 0.05 then
%_msgs: endcons(sconcat(str_not_normal_pre, %_tex(%_nm(%_k)), str_dev_mid, %_deg(%_dn(%_k)), str_from_normal), %_msgs)
else if %_d . %_u >= 0 then
%_msgs: endcons(sconcat(str_compressive_pre, %_tex(%_nm(%_k)), str_compressive_post), %_msgs)
else %_found: endcons(%_nm(%_k), %_found)),
if %_fr # "" then (
if %_LT = [] then (if not %_hintT then %_msgs: endcons(
if %_named then sconcat(str_no_friction_named_pre, %_texlist(%_tn), str_no_friction_named_post) else str_no_friction, %_msgs))
else if length(%_LT) > 1 then %_msgs: endcons(str_more_friction, %_msgs)
else (
%_k: %_LT[1], %_d: float(direction(%_o[%_k])), %_d: %_d/sqrt(%_d . %_d),
if abs(%_d . %_u) >= 0.05 then
%_msgs: endcons(sconcat(str_not_tangential_pre, %_tex(%_nm(%_k)), str_dev_mid, %_deg(90 - %_dn(%_k)), str_from_tangent), %_msgs)
else if listp(%_v) and %_d . %_v >= 0 then
%_msgs: endcons(if %_vname # "" then sconcat(str_against_pre, %_tex(%_nm(%_k)), str_against_mid, %_tex(%_vname), str_against_post)
else sconcat(str_against_pre, %_tex(%_nm(%_k)), str_against_sliding), %_msgs)
else %_found: endcons(%_nm(%_k), %_found))),
%_msgs: append(%_msgs, %_fmsgs),
if %_msgs # [] then return([castext_concat(%_txt, simplode(%_msgs, " ")), false]),
[castext_concat(%_txt, sconcat(if length(%_found) = 1 then str_found_one_pre else str_found_two_pre,
simplode(map(%_tex, %_found), str_and), str_found_post)), true]
);
fb_reaction_name(%_o, %_n, %_i, %_default):= block([],
if not listp(%_n[%_i]) or length(%_n[%_i]) # 1 then return(%_default),
if %_o[%_n[%_i][1]][1] # "force" then return(%_default),
%_n[%_n[%_i][1]]
);
fb_contact_reactions(%_o, %_n, %_i):= block([%_c, %_u, %_d, %_k, %_nn: false, %_tn: false, %_td: false],
if not listp(%_n[%_i]) then return([false, false, false]),
%_c: float(direction(%_o[%_i])), %_u: %_c/sqrt(%_c . %_c),
for %_k in %_n[%_i] do
if %_o[%_k][1] = "force" then (
%_d: float(direction(%_o[%_k])), %_d: %_d/sqrt(%_d . %_d),
if abs(%_d[1]*%_u[2] - %_d[2]*%_u[1]) < 0.05 then (if %_nn = false then %_nn: %_n[%_k])
else if abs(%_d . %_u) < 0.05 and %_tn = false then (%_tn: %_n[%_k], %_td: %_d)),
[%_nn, %_tn, %_td]
);
fb_q(o, n, i, description,q1,q2,le):=block(
[varcheck, txt: description, %_v, ir, ir1, ir2, %_R, mag, a0, xref, Rref, lm,
str_not_deactivated: castext("[[lang code='de']]ist nicht deaktiviert.[[/lang]][[lang code='en,other']]is not deactivated.[[/lang]]"),
str_no_reaction: castext("[[lang code='de']]Keine Resultierende gefunden.[[/lang]][[lang code='en,other']]No resultant found.[[/lang]]"),
str_not_a_force: castext("[[lang code='de']] ist keine Kraft.[[/lang]][[lang code='en,other']] is not a force.[[/lang]]"),
str_too_many_pre: castext("[[lang code='de']]Höchstens zwei Resultierende sind sinnvoll. Gefunden wurden mehr:<br>[[/lang]][[lang code='en,other']]At most two resultants make sense. More were found:<br>[[/lang]]"),
str_constant_load: castext("[[lang code='de']]Bei konstanter Streckenlast sollte eine Resultierende ausreichen.[[/lang]][[lang code='en,other']]For a constant line load, one resultant should be sufficient.[[/lang]]"),
str_triangular_load: castext("[[lang code='de']]Bei einer Dreiecks-Streckenlast sollte eine Resultierende ausreichen.[[/lang]][[lang code='en,other']]For a triangular line load, one resultant should be sufficient.[[/lang]]"),
str_ok: castext("[[lang code='de']]Resultierende OK[[/lang]][[lang code='en,other']]Resultant OK[[/lang]]")],
if not member(o[i][1], ["q"])
then return ([sconcat(txt, "object ", string(i), " (",o[i][1],") is not a line load."), false]),
%_v: o[i][5]-o[i][4],
mag: (cabs(%_v[1]+%i*%_v[2]))*le*(q1+q2)/2, a0: carg(%_v[1]+%i*%_v[2]),
xref: (o[i][4]*(2/3*q1+q2/3)+o[i][5]*(q1/3+2/3*q2))/(q1+q2),
Rref: [ "force", mag, xref, xref+[-sin(a0+o[i][8]*pi/180), -cos(a0+o[i][8]*pi/180)] ],
if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
if not listp(n[i]) or n[i]=[] then return([castext_concat(txt, str_no_reaction), false]),
lm: sublist(n[i], lambda ([x], o[x][1]="moment")),
if ( length(lm) # 0 ) then (
for ir in lm do txt: castext_concat(txt, castext("{@n[ir]@}") ),
return ([castext_concat(txt, str_not_a_force),false])
),
if (length(n[i]) =1) then (
ir: n[i][1],
if abs(angle(Rref, o[ir]))>0.01 then
return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not have the correct direction.[[/lang]]") ) ,false]),
varcheck: fb_vars(n[ir], mag, []),
if varcheck # "" then return( [
castext_concat( castext_concat( txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} hat nicht den richtigen Betrag. [[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not have the correct magnitude. [[/lang]]") ), varcheck),
false]),
if abs((mag-n[ir])/mag)>0.01 then
return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} hat nicht den richtigen Betrag.[[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not have the correct magnitude.[[/lang]]") ) ,false]),
if abs(moment_of_force(xref, o[ir], 1, 1) ) > 0.01 then
return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir]@} geht nicht durch den Schwerpunkt.[[/lang]][[lang code='en,other']]Resultant {@n[ir]@} does not pass through the centroid.[[/lang]]") ) ,false])
) else (
if (length(n[i]) >2) then (
%_R: fb_strip_list(makelist(n[n[i][ir]], ir, 1, length(n[i]) ) ),
return([lreduce(castext_concat, [txt, str_too_many_pre, %_R ] ), false])
),
if q1 = q2 then return([castext_concat(txt, str_constant_load) ,false]),
if q1*q2 =0 then return([castext_concat(txt, str_triangular_load) ,false]),
ir1: n[i][1], ir2: n[i][2],
if abs(angle(Rref, o[ir1]))>0.01 then
return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir1]@} hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]Resultant {@n[ir1]@} does not have the correct direction.[[/lang]]") ) ,false]),
if abs(angle(Rref, o[ir2]))>0.01 then
return([castext_concat(txt, castext("[[lang code='de']]Die Resultierende {@n[ir2]@} hat nicht die richtige Richtung.[[/lang]][[lang code='en,other']]Resultant {@n[ir2]@} does not have the correct direction.[[/lang]]") ) ,false]),
varcheck: fb_vars(n[ir1], mag, []),
if varcheck # "" then return([ castext_concat( castext_concat( txt, castext("[[lang code='de']]Die Resultierende {@n[ir1]@} kann nicht stimmen. [[/lang]][[lang code='en,other']]Resultant {@n[ir1]@} cannot be correct. [[/lang]]") ), varcheck) ,false]),
varcheck: fb_vars(n[ir2], mag, []),
if varcheck # "" then return([ castext_concat( castext_concat( txt, castext("[[lang code='de']]Die Resultierende {@n[ir2]@} kann nicht stimmen. [[/lang]][[lang code='en,other']]Resultant {@n[ir2]@} cannot be correct. [[/lang]]") ), varcheck) ,false]),
if abs((mag-n[ir1]-n[ir2])/mag)>0.01 then
return([castext_concat(txt, castext("[[lang code='de']]Die Summe der Resultierenden {@n[ir1]+n[ir2]@} hat nicht den richtigen Wert. [[/lang]][[lang code='en,other']]The sum of the resultants {@n[ir1]+n[ir2]@} does not have the correct value. [[/lang]]") ) ,false]),
if abs((moment_of_force(xref, o[ir1], n[ir1], 1) + moment_of_force(xref, o[ir2], n[ir2], 1))/mag ) > 0.01 then
return( [castext_concat(txt, castext("[[lang code='de']]Pr&uuml;fen Sie die Lage der Resultierenden. Der gemeinsame Schwerpunkt entspricht nicht der Streckenlast. <br>{@n[ir1]@}, {@n[ir2]@}[[/lang]][[lang code='en,other']]Check the position of the resultants. Their common centroid does not match the line load. <br>{@n[ir1]@}, {@n[ir2]@}[[/lang]]") ) ,false])
),
[castext_concat(txt, str_ok) ,true]
);
fb_bar_end(%_bar, %_R):= block([%_p3: %_bar[3], %_p4: %_bar[4], %_rp: %_R[3], %_tol: 0.1],
if sqrt((%_rp[1]-%_p3[1])^2+(%_rp[2]-%_p3[2])^2) < %_tol then 1
elseif sqrt((%_rp[1]-%_p4[1])^2+(%_rp[2]-%_p4[2])^2) < %_tol then 2
else 0
);
fb_bar_tension_ok(%_bar, %_R, %_end):= block([%_bd: direction(%_bar), %_rd: direction(%_R), %_ref],
%_ref: if %_end=1 then -%_bd else %_bd,
is(%_rd[1]*%_ref[1]+%_rd[2]*%_ref[2] > 0)
);
fb_bar(o, n, i, [opt]):=block(
[txt, R, R1, R2, name, testT, test2, L, e1, e2,
str_bar_pre: castext("[[lang code='de']]Stab [[/lang]][[lang code='en,other']]Bar [[/lang]]"),
str_not_deactivated: castext("[[lang code='de']]Nicht deaktiviert.[[/lang]][[lang code='en,other']]Not deactivated.[[/lang]]"),
str_no_match_pre: castext("[[lang code='de']]Keine Stabkraft mit passendem Namen (mit Index [[/lang]][[lang code='en,other']]No bar force with a matching name (with index [[/lang]]"),
str_no_match_post: castext("[[lang code='de']]) gefunden.[[/lang]][[lang code='en,other']]) found.[[/lang]]"),
str_not_parallel: castext("[[lang code='de']] ist nicht parallel zum Stab.[[/lang]][[lang code='en,other']] is not parallel to the bar.[[/lang]]"),
str_not_tension: castext("[[lang code='de']] ist nicht als Zugkraft definiert.[[/lang]][[lang code='en,other']] is not defined as a tensile force.[[/lang]]"),
str_ok: castext("[[lang code='de']] OK.[[/lang]][[lang code='en,other']] OK.[[/lang]]"),
str_fewer_than_two: castext("[[lang code='de']]Weniger als zwei Stabkräfte mit passendem Namen gefunden.[[/lang]][[lang code='en,other']]Fewer than two bar forces with a matching name found.[[/lang]]"),
str_more_than_two: castext("[[lang code='de']]Mehr als zwei Stabkräfte mit passendem Namen gefunden.[[/lang]][[lang code='en,other']]More than two bar forces with a matching name found.[[/lang]]"),
str_not_at_end: castext("[[lang code='de']] greift an keinem Stabende an.[[/lang]][[lang code='en,other']] does not act at either end of the bar.[[/lang]]"),
str_same_end: castext("[[lang code='de']] greifen beide am selben Stabende an. An jedem Stabende sollte eine Stabkraft angreifen.[[/lang]][[lang code='en,other']] both act at the same end of the bar. One bar force should act at each end.[[/lang]]"),
str_name_mismatch: castext("[[lang code='de']] haben unterschiedliche Namen. Als Freischnitt desselben Stabes sollten beide denselben Namen tragen.[[/lang]][[lang code='en,other']] have different names. As the free-body cut of the same bar, both should carry the same name.[[/lang]]")],
if length(opt) = 1 then opt: string(opt[1]) else opt: "",
testT: member("T", charlist(opt)),
test2: member("2", charlist(opt)),
if o[i][1]  # "bar" then return ([sconcat("object ", string(i), " (",o[i][1],") is not a bar."), false]),
name: o[i][2],
if name = "" then return ([ sconcat("object #", string(i), " has no name."), false]),
txt: castext_concat(str_bar_pre, sconcat(name, ": ")),
if ( last(o[i]) # "hide") then return ([castext_concat(txt, str_not_deactivated), false]),
if listp(n[i]) then L: sublist (n[i], lambda ([x], o[x][1]="force" and split(o[x][2],"_")[2] = name )) else L: [],
if L = [] then return ([castext_concat(txt, sconcat(str_no_match_pre, name, str_no_match_post)) , false]),
if not test2 then (
R: o[L[1]],
if not parallelp(R, o[i]) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_parallel)),false]),
if testT and (abs(angle(R, o[i])) > 0.1) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_tension)), false] ),
return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_ok)), true] )
) else (
if length(L) < 2 then return ([castext_concat(txt, str_fewer_than_two), false]),
if length(L) > 2 then return ([castext_concat(txt, str_more_than_two), false]),
R1: o[L[1]], R2: o[L[2]],
if R1[2] # R2[2] then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}, {@n[L[2]]@}"), str_name_mismatch)),false]),
if not parallelp(R1, o[i]) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_parallel)),false]),
if not parallelp(R2, o[i]) then return ([castext_concat(txt, castext_concat(castext("{@n[L[2]]@}"), str_not_parallel)),false]),
e1: fb_bar_end(o[i], R1), e2: fb_bar_end(o[i], R2),
if e1 = 0 then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_at_end)), false]),
if e2 = 0 then return ([castext_concat(txt, castext_concat(castext("{@n[L[2]]@}"), str_not_at_end)), false]),
if e1 = e2 then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}, {@n[L[2]]@}"), str_same_end)), false]),
if not fb_bar_tension_ok(o[i], R1, e1) then return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}"), str_not_tension)), false]),
if not fb_bar_tension_ok(o[i], R2, e2) then return ([castext_concat(txt, castext_concat(castext("{@n[L[2]]@}"), str_not_tension)), false]),
return ([castext_concat(txt, castext_concat(castext("{@n[L[1]]@}, {@n[L[2]]@}"), str_ok)), true])
)
);
fb_bar_name(%_o, %_n, %_i):=block(
[%_str,%_R,%_nl,%_OK,%_var, %_bl,
str_multiletter: castext("[[lang code='de']]Physikalische Gr&ouml;&szlig;en immer nur mit einem Buchstabe und eventuell Index schreiben, z.B. <code>F_1</code>.[[/lang]][[lang code='en,other']]Always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>.[[/lang]]"),
str_sensible_names: castext("[[lang code='de']]Sinnvolle Namen für eine Stabkraft sind \\(F\\) (Kraft), \\(N\\) (Normalkraft) oder \\(S\\) (Stabkraft)[[/lang]][[lang code='en,other']]Sensible names for a bar force are \\(F\\) (force), \\(N\\) (normal force), or \\(S\\) (bar force)[[/lang]]"),
str_index_mismatch_pre: castext("[[lang code='de']]Der Index [[/lang]][[lang code='en,other']]The index [[/lang]]"),
str_index_mismatch_mid: castext("[[lang code='de']] passt nicht zum Stabname [[/lang]][[lang code='en,other']] does not match the bar's name [[/lang]]")],
if length(%_n) # length(%_o) then return(sconcat("length(o)= ",length(%_o), " length(n)=", length(%_n))),
if length(%_n) < %_i then return(sconcat("length(n)= ",length(%_n), " <", %_i)),
if not member(%_o[%_i][1], ["bar"]) then return ([sconcat("object ", %_i, " is not of type 'bar'"), false]),
if debug then %_str: sconcat("object ", %_i, " is not deactivated (debug message)" ) else %_str: "",
if ( last(%_o[%_i]) # "hide") then return ([%_str, false]),
if debug then %_str: sconcat("no reaction found at object ", %_i, " (debug message)" ) else %_str: "",
if not listp(%_n[%_i]) or %_n[%_i]=[] then return([%_str, false]),
if debug then %_str: sconcat("more than one reaction found ", %_n[%_i], " (debug message)" ) else %_str: "",
if (length(%_n[%_i]) > 1) then return( [%_str, false]),
%_R: %_o[%_n[%_i][1]],
%_var: %_n[%_n[%_i][1]],
if debug then %_str: sconcat("Reaction ", %_R[2], " is not a force (debug message)" ) else	 %_str: "",
if %_R[1] # "force" then return( [%_str, false]),
%_str: "",
%_OK: true,
%_nl: split(%_R[2],"_"),
if slength(%_nl[1]) > 1 then [ %_str, %_OK ]:
[ castext_concat(castext("<br>{@%_var@}: "), str_multiletter), false ],
if not member(charlist(%_nl[1])[1], ["F", "N", "S" ])  then [ %_str, %_OK ]:
[ castext_concat( %_str, castext_concat(castext("<br>{@%_var@}: "), str_sensible_names) ), false ],
%_bl: %_o[%_i][2],
if %_bl # "" then (
if length(%_nl) = 2 then
if %_bl # %_nl[2] then
[ %_str, %_OK ]:
[ castext_concat( %_str, castext_concat(castext("<br>"), castext_concat(str_index_mismatch_pre, castext_concat(castext("{@%_nl[2]@}"), castext_concat(str_index_mismatch_mid, castext("{@%_bl@}."))))))
, false ]
),
[%_str, %_OK]
);
fb_name(n,i,lon,[opt]):=block([name,txt,%_namestex,%_show,%_lonstr,
str_or: castext("[[lang code='de']] oder [[/lang]][[lang code='en,other']] or [[/lang]]"),
str_no_match_post: castext("[[lang code='de']] \\) ist kein passender Name.[[/lang]][[lang code='en,other']] \\) is not an acceptable name.[[/lang]]"),
str_no_match_list_mid: castext("[[lang code='de']] \\) ist kein passender Name. Akzeptiert: [[/lang]][[lang code='en,other']] \\) is not an acceptable name. Accepted: [[/lang]]")],
name: none,
if listp(n[i]) and  not emptyp(n[i]) then name: n[n[i][1]] else return(["", false]),
%_lonstr: map(lambda([%_x], if stringp(%_x) then %_x else string(%_x)), lon),
if member(if stringp(name) then name else string(name), %_lonstr) then return( ["",true]),
%_show: if opt=[] then true else opt[1],
if not %_show then return([sconcat("\\(", name, str_no_match_post), false]),
%_namestex: if length(lon)=1 then sconcat("\\(",lon[1],"\\)")
else sconcat(simplode(map(lambda([%_x], sconcat("\\(",%_x,"\\)")), rest(lon,-1)), ", "), str_or, "\\(", last(lon), "\\)"),
return([sconcat("\\(", name, str_no_match_list_mid, %_namestex, "."), false])
);
fb_reactions(%_o, %_f, %_m):=block(
[%_fnum, %_mnum, %_txt, %_OK, %_msgs,
str_count_ok: castext("[[lang code='de']]Die Zahl der Reaktionen stimmt.[[/lang]][[lang code='en,other']]The number of reactions is correct.[[/lang]]"),
str_force_count_wrong: castext("[[lang code='de']]Die Zahl der Reaktionskräfte stimmt nicht.[[/lang]][[lang code='en,other']]The number of reaction forces is incorrect.[[/lang]]"),
str_moment_count_wrong: castext("[[lang code='de']]Die Zahl der Reaktionsmomente stimmt nicht.[[/lang]][[lang code='en,other']]The number of reaction moments is incorrect.[[/lang]]")],
%_fnum: length(sublist_indices (%_o, lambda ([x], x[1]="force" and last(x)="active" and  not sposition(" ",x[2])))),
%_mnum: length(sublist_indices (%_o, lambda ([x], x[1]="moment" and last(x)="active"))),
if (%_fnum=%_f) and (%_mnum=%_m) then [%_txt, %_OK]: [str_count_ok,true] else (
%_OK: false, %_msgs: [],
if %_fnum # %_f then %_msgs: endcons(str_force_count_wrong, %_msgs),
if %_mnum # %_m then %_msgs: endcons(str_moment_count_wrong, %_msgs),
%_txt: simplode(%_msgs, "<br>")
),
[%_txt,%_OK]
);
fb_unique_names(%_o, %_n, %_supports):=block(
[%_all: [], %_names, %_where, %_sup, %_msgs: [], %_i, %_k, %_nm,
str_dup_pre: castext("[[lang code='de']]Der Name \\([[/lang]][[lang code='en,other']]The name \\([[/lang]]"),
str_dup_mid: castext("[[lang code='de']]\\) wird für mehrere Reaktionen verwendet[[/lang]][[lang code='en,other']]\\) is used for more than one reaction[[/lang]]"),
str_dup_post: castext("[[lang code='de']]. Reaktionen brauchen verschiedene Namen.[[/lang]][[lang code='en,other']]. Reactions need different names.[[/lang]]")],
for %_i in %_supports do
if listp(%_n[%_i]) then
for %_k in %_n[%_i] do
if strim(" ", %_o[%_k][2]) # "" then %_all: endcons([%_o[%_k][2], %_o[%_i][2]], %_all),
%_names: unique(map(first, %_all)),
for %_nm in %_names do (
%_where: sublist(%_all, lambda([x], x[1] = %_nm)),
%_sup: sublist(unique(map(second, %_where)), lambda([x], stringp(x) and x # "")),
if length(%_where) > 1 then
%_msgs: endcons(sconcat(str_dup_pre, %_nm, str_dup_mid,
if emptyp(%_sup) then "" else sconcat(" (", simplode(%_sup, ", "), ")"), str_dup_post), %_msgs)
),
if emptyp(%_msgs) then ["", true] else [simplode(%_msgs, "<br>"), false]
);
fb_fbd(%_o, %_n, %_options):= block(
[%_get, %_msgs: [], %_okS: true, %_okN: true, %_okC: true, %_done: [], %_drawn, %_given, %_res,
%_sup, %_u, %_k, %_nm, %_base, %_fnum, %_mnum,
str_sys_wrong: castext("[[lang code='de']]Die Systemgrenzen stimmen nicht.[[/lang]][[lang code='en,other']]The system boundaries are incorrect.[[/lang]]"),
str_noname: castext("[[lang code='de']]Eine gezeichnete Kraft oder ein Moment hat keinen Namen.[[/lang]][[lang code='en,other']]A force or moment you drew has no name.[[/lang]]"),
str_reserved_pre: castext("[[lang code='de']]Der Name \\([[/lang]][[lang code='en,other']]The name \\([[/lang]]"),
str_reserved_post: castext("[[lang code='de']]\\) ist schon vergeben (vorgegebene Last oder Größe der Aufgabe). Wählen Sie für die Reaktion einen anderen Namen.[[/lang]][[lang code='en,other']]\\) is already taken (a given load or a quantity of the problem). Choose another name for the reaction.[[/lang]]"),
str_form_post: castext("[[lang code='de']]\\): Physikalische Größen immer nur mit einem Buchstaben und eventuell Index schreiben, z.B. <code>F_1</code>.[[/lang]][[lang code='en,other']]\\): always name physical quantities with a single letter and, if needed, an index, e.g. <code>F_1</code>.[[/lang]]"),
str_forces_wrong: castext("[[lang code='de']]Die Zahl der Reaktionskräfte stimmt nicht.[[/lang]][[lang code='en,other']]The number of reaction forces is incorrect.[[/lang]]"),
str_moments_wrong: castext("[[lang code='de']]Die Zahl der Reaktionsmomente stimmt nicht.[[/lang]][[lang code='en,other']]The number of reaction moments is incorrect.[[/lang]]"),
str_ok_pre: castext("[[lang code='de']]Geprüft und in Ordnung: [[/lang]][[lang code='en,other']]Checked and correct: [[/lang]]"),
str_ok_sys: castext("[[lang code='de']]Systemgrenzen[[/lang]][[lang code='en,other']]system boundaries[[/lang]]"),
str_ok_names: castext("[[lang code='de']]Namen[[/lang]][[lang code='en,other']]names[[/lang]]"),
str_ok_count: castext("[[lang code='de']]Anzahl der Reaktionen[[/lang]][[lang code='en,other']]number of reactions[[/lang]]")],
%_get: lambda([%_key], block([%_v: false],
for %_e in %_options do if equationp(%_e) and string(lhs(%_e)) = %_key then %_v: rhs(%_e), %_v)),
%_drawn: sublist_indices(%_o, lambda([x], member(x[1], ["force", "moment"]) and last(x) = "active"
and not sposition(" ", x[2]))),
%_given: sublist(map(lambda([x], x[2]), sublist(%_o, lambda([x], member(x[1], ["force", "moment"]) and last(x) # "active"))),
lambda([x], stringp(x) and x # "")),
if %_get("sys") # false or %_get("env") # false then (
%_done: endcons(str_ok_sys, %_done),
%_okS: second(fb_system(%_n, if listp(%_get("sys")) then %_get("sys") else [],
if listp(%_get("env")) then %_get("env") else [], "")),
if not %_okS then %_msgs: endcons(
if stringp(%_get("hint")) and striml(" ", %_get("hint")) # "" then sconcat(str_sys_wrong, " ", striml(" ", %_get("hint"))) else str_sys_wrong,
%_msgs)),
%_done: endcons(str_ok_names, %_done),
if some(lambda([k], strim(" ", %_o[k][2]) = ""), %_drawn) then (%_okN: false, %_msgs: endcons(str_noname, %_msgs)),
%_res: append(%_given, map(lambda([x], if stringp(x) then x else string(x)),
if listp(%_get("reserved")) then %_get("reserved") else [])),
for %_nm in unique(map(lambda([k], %_o[k][2]), %_drawn)) do
if member(%_nm, %_res) then (%_okN: false, %_msgs: endcons(sconcat(str_reserved_pre, %_nm, str_reserved_post), %_msgs)),
if %_get("nameform") = true then
for %_nm in unique(map(lambda([k], %_o[k][2]), %_drawn)) do (
%_base: if sposition("_", %_nm) # false then substring(%_nm, 1, sposition("_", %_nm)) else %_nm,
if strim(" ", %_nm) # "" and not (slength(%_base) = 1 and alphacharp(charat(%_base, 1))) then (
%_okN: false, %_msgs: endcons(sconcat("\\(", %_nm, str_form_post), %_msgs))),
%_sup: if listp(%_get("supports")) then %_get("supports")
else sublist_indices(%_o, lambda([x], member(x[1], ["fix1", "fix12", "fix123", "fix13", "contact"]))),
%_u: fb_unique_names(%_o, %_n, %_sup),
if not second(%_u) then (%_okN: false, %_msgs: endcons(first(%_u), %_msgs)),
if %_get("forces") # false or %_get("moments") # false then (
%_done: endcons(str_ok_count, %_done),
%_fnum: length(sublist(%_drawn, lambda([k], %_o[k][1] = "force"))),
%_mnum: length(sublist(%_drawn, lambda([k], %_o[k][1] = "moment"))),
if integerp(%_get("forces")) and %_fnum # %_get("forces") then (%_okC: false, %_msgs: endcons(str_forces_wrong, %_msgs)),
if integerp(%_get("moments")) and %_mnum # %_get("moments") then (%_okC: false, %_msgs: endcons(str_moments_wrong, %_msgs))),
if emptyp(%_msgs) then [sconcat("<br>", str_ok_pre, simplode(%_done, ", "), "."), true, [true, true, true]]
else [sconcat("<br>", simplode(%_msgs, "<br>")), false, [%_okS, %_okN, %_okC]]
);
fb_EE(%_S, %_T, [%_options]):= block(
[%_get, %_sub, %_kind, %_title, %_z, %_msg,
str_sign_pre: castext("[[lang code='de']]Zählen Sie Kräfte in positiver \\([[/lang]][[lang code='en,other']]Count forces in the positive \\([[/lang]]"),
str_sign_post: castext("[[lang code='de']]\\)-Richtung positiv.[[/lang]][[lang code='en,other']]\\) direction as positive.[[/lang]]"),
str_sign_M: castext("[[lang code='de']]Zählen Sie Momente gegen den Uhrzeigersinn positiv.[[/lang]][[lang code='en,other']]Count counterclockwise moments as positive.[[/lang]]"),
str_sign: castext("[[lang code='de']]Das Vorzeichen der Summe stimmt nicht. Prüfen Sie die Zählrichtung.[[/lang]][[lang code='en,other']]The sign of the sum is wrong. Check the counting direction.[[/lang]]"),
str_wrong: castext("[[lang code='de']]Die Gleichung passt nicht zu Ihrem Freischnitt.[[/lang]][[lang code='en,other']]The equation does not match your free-body diagram.[[/lang]]")],
%_options: if %_options = [] then [] else %_options[1],
%_get: lambda([%_key], block([%_v: false],
for %_e in %_options do if equationp(%_e) and string(lhs(%_e)) = %_key then %_v: rhs(%_e), %_v)),
if listp(%_S) and length(%_S) = 1 then %_S: %_S[1],
if listp(%_T) and length(%_T) = 1 then %_T: %_T[1],
if listp(%_S) or listp(%_T) then return(["fb_EE(): one equation per call", false]),
%_sub: if listp(%_get("subst")) then %_get("subst") else [],
%_kind: %_get("kind"), %_title: %_get("title"),
%_z: lambda([%_e], is(ratsimp(trigsimp(ratsimp(subst(%_sub, %_e)))) = 0)),
if %_z(%_S - %_T) then return(["", true]),
%_msg: if %_z(%_S + %_T) then (
if %_kind = "M" then str_sign_M
else if stringp(%_kind) and %_kind # "" then castext_concat(castext_concat(str_sign_pre, %_kind), str_sign_post)
else str_sign)
else block([%_v: fb_vars(ratsimp(subst(%_sub, %_S)), ratsimp(subst(%_sub, %_T)), listofvars(subst(%_sub, %_T)))],
if %_v = "" then str_wrong else %_v),
[castext_concat(sconcat("<br>", if stringp(%_title) then sconcat("\\(", %_title, "\\): ") else ""), %_msg), false]
);
fb_force(%_o, %_name, %_point, %_dir, %_toldeg, %_toldist, %_description):=block(
[%_txt: %_description, %_names, %_namestex, %_idx, %_i, %_dref, %_devDeg, %_devDist, %_mn,
%_toldistval, %_tolunit, %_fx, %_fy,
str_or: castext("[[lang code='de']] oder [[/lang]][[lang code='en,other']] or [[/lang]]"),
str_notfound_pre: castext("[[lang code='de']]Keine Kraft [[/lang]][[lang code='en,other']]No force [[/lang]]"),
str_ambiguous_pre: castext("[[lang code='de']]Mehr als eine Kraft [[/lang]][[lang code='en,other']]More than one force [[/lang]]"),
str_notfound_post: castext("[[lang code='de']] gefunden.[[/lang]][[lang code='en,other']] found.[[/lang]]"),
str_wrong_direction_mid: castext("[[lang code='de']]\\) hat nicht die richtige Richtung. Richtungsabweichung: [[/lang]][[lang code='en,other']]\\) does not have the correct direction. Direction deviation: [[/lang]]"),
str_wrong_line_pre: castext("[[lang code='de']]Die Wirkungslinie von \\([[/lang]][[lang code='en,other']]The line of action of \\([[/lang]]"),
str_wrong_line_mid: castext("[[lang code='de']]\\) geht am richtigen Angriffspunkt vorbei. Abstand: [[/lang]][[lang code='en,other']]\\) misses the correct point of application. Distance: [[/lang]]"),
str_found_post: castext("[[lang code='de']]\\) gefunden.[[/lang]][[lang code='en,other']]\\) found.[[/lang]]")],
%_names: if listp(%_name) then %_name else [%_name],
%_namestex: simplode(map(lambda([%_x], sconcat("\\(", %_x, "\\)")), %_names), str_or),
%_idx: sublist_indices(%_o, lambda([%_x], %_x[1]="force" and member(%_x[2],%_names) and last(%_x)="active")),
if length(%_idx) = 0 then return([castext_concat(%_txt, sconcat(str_notfound_pre, %_namestex, str_notfound_post)), false]),
if length(%_idx) > 1 then return([castext_concat(%_txt, sconcat(str_ambiguous_pre, %_namestex, str_notfound_post)), false]),
%_i: first(%_idx),
%_mn: %_o[%_i][2],
%_dref: if listp(%_dir) then ["force", 1, [0,0], %_dir]
else ["force", 1, [0,0], [cos(%_dir*%pi/180), sin(%_dir*%pi/180)]],
%_devDeg: ev(round(angle(%_dref, %_o[%_i])*180/%pi*10)/10.0, simp),
if abs(%_devDeg) > %_toldeg then
return([castext_concat(%_txt, sconcat("\\(", %_mn, str_wrong_direction_mid, %_devDeg, "°.")), false]),
%_devDist: ev(round(moment_of_force(%_point, %_o[%_i], 1, 1)*10)/10.0, simp),
if listp(%_toldist) then (
if %_o[1][1] # "grid" then
return([sconcat("fb_force(): object 1 is not a \"grid\" - cannot determine the scaling factor for a unit-tagged toldist."), false]),
[%_fx, %_fy]: %_o[1][9],
if %_fx # %_fy then
return([sconcat("fb_force(): grid scaling factors fx (", string(%_fx), ") and fy (", string(%_fy), ") differ - a unit-tagged toldist requires equal x/y scaling."), false]),
%_toldistval: %_toldist[1], %_tolunit: %_toldist[2],
%_devDist: ev(round(%_devDist*%_fx*10)/10.0, simp),
if abs(%_devDist) > %_toldistval then
return([castext_concat(%_txt, sconcat(str_wrong_line_pre, %_mn, str_wrong_line_mid, %_devDist, " ", %_tolunit, ".")), false])
) else (
if abs(%_devDist) > %_toldist then
return([castext_concat(%_txt, sconcat(str_wrong_line_pre, %_mn, str_wrong_line_mid, %_devDist, ".")), false])
),
[castext_concat(%_txt, sconcat("\\(", %_mn, str_found_post)), true]
);
fb_system(%_names, %_sys, %_env, %_hint):=block(
[%_i, %_s, %_OK: true,
%_str_ok: castext("<br>[[lang code='de']]Die Systemgrenzen stimmen.[[/lang]][[lang code='en,other']]The system boundaries are correct.[[/lang]]"),
%_str_wrong: castext("<br>[[lang code='de']]Die Systemgrenzen stimmen nicht.[[/lang]][[lang code='en,other']]The system boundaries are incorrect.[[/lang]]")],
for %_i in %_env do if (stringp(%_names[%_i]) and sdowncase(%_names[%_i]) = "show") then %_OK: false,
for %_i in %_sys do (
%_s: %_names[%_i],
if listp(%_s) or (stringp(%_s) and sdowncase(%_s) = "hide") then %_OK: false),
if %_OK then return([%_str_ok, true]),
%_hint: striml(" ", %_hint),
return([if %_hint = "" then %_str_wrong else sconcat(%_str_wrong, " ", %_hint), false])
);
matchByParallel(o,n):=block([res, llist],res: [],
for i:1 thru length(o) do (
if (not listp(n[i])) then res: endcons(n[i], res) else (
llist: sublist(n[i],
lambda([x],
member(o[i][1], [ "fix12, fix123", "circle"]) or
parallelp(o[i], o[x] )
)
),
res: endcons(llist, res)
)
),
return(res)
);
