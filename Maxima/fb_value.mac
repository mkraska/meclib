/* https://github.com/mkraska/meclib/wiki/Feedback-Overview */ 
fb_value_version: "2026 10 11";

/* https://github.com/mkraska/meclib/wiki/deg2rad */
/* Substitutes any use of the "deg" marker in expr with its numeric value (pi/180), for use right
   before a numeric comparison (fb_coeffs, fb_unit, etc.) - never bind deg globally in
   questionvariables, or every other display of it (questiontext, tans, generalfeedback, and the
   student's own input-validation echo) loses its nice degree-symbol rendering and shows a raw
   decimal instead. deg itself is left untouched everywhere except inside this call, e.g.
   fb_coeffs(deg2rad(S_GG1), GG1, tol, ""). A no-op if deg is not present in expr.
   Deliberately does NOT also handle the literal degree-sign character (U+00B0) here: this file is
   fetched by stack_include() over HTTP and loaded by a Maxima reader that fails with "Lexer side
   error" on a raw non-ASCII byte, and the only workaround found (building the symbol at runtime
   via unicode()/parse_string()) fails too, since parse_string is on STACK's forbidden-function
   list ("Verbotene Funktion: parse_string"). A literal degree-sign character typed directly into
   a question's own questionvariables (not fetched via stack_include) does not hit either problem,
   so a question that wants to accept that character as input can add its own local substitution
   before calling deg2rad(), substituting the degree-sign character for deg first, then wrapping
   the result in deg2rad() as usual: fb_coeffs(deg2rad(subst(<degree-sign>=deg, S_GG1)), GG1, tol, "") */
deg2rad(expr):= subst(deg=%pi/180, expr);

/* https://github.com/mkraska/meclib/wiki/fb_vars */
fb_strip_list(_list_of_things):= castext("[[define _first='true'/]][[foreach _thing='_list_of_things']][[if test='not _first']], [[else]][[define _first='false'/]][[/if]]{@_thing@}[[/foreach]]"); 
/* fb_strip_list function proposed by Matti Harjula 2022 04 10 */

fb_vars(%_sans,%_tans, [%_opt] ) := block(
  [%_vars, %_label, %_tol, %_tansvar,%_sansvar,%_extras, %_missing, simp, %_txt, %_L,
    str_unexpected_variable: castext("[[lang code='de']]&nbsp;Unerwartete Variable [[/lang]][[lang code='en,other']]&nbsp;Unexpected variable [[/lang]]"),
    str_missing_variable: castext("[[lang code='de']]&nbsp;Fehlende Variable [[/lang]][[lang code='en,other']]&nbsp;Missing variable [[/lang]]"),
    str_check_term: castext("[[lang code='de']]&nbsp;Pr&uuml;fen Sie den Term mit [[/lang]][[lang code='en,other']]&nbsp;Check the term with [[/lang]]"),
    str_check_terms: castext("[[lang code='de']]&nbsp;Pr&uuml;fen Sie die Terme mit [[/lang]][[lang code='en,other']]&nbsp;Check the terms with [[/lang]]")
  ],
  simp: true, /* Extract vars with simp:true does mean that "x/x+y" -> [y] */
  if length(%_opt)>0 then %_vars: %_opt[1] else %_vars: [],
  if length(%_opt)>1 then %_label: %_opt[2] else %_label: "",
  if length(%_opt)>2 then %_tol: %_opt[3] else %_tol: 0,
  %_txt: %_label,
  %_sansvar: setify(listofvars(%_sans)),
  %_tansvar: setify(listofvars(%_tans)),
  /* With a positive tolerance, ignore variables whose (linear) coefficient does not exceed it
     in absolute value - protects against spurious extra/missing-variable complaints caused by
     pure floating-point noise (e.g. a coefficient that should be exactly zero coming out as
     1e-13 instead). Only meaningful for a variable that appears linearly; one that only appears
     nonlinearly should be passed to fb_vars/fb_coeffs as its own sub-expression instead (e.g.
     a^2, sin(alpha)), see wiki. */
  /* float() forces a numeric comparison even when %_sans/%_tans still contain an exact
     (non-floated) irrational subexpression, e.g. cos(%pi/18) from an angle given in exact
     degrees - without it, abs(...) > %_tol can fail to resolve to true/false at all. */
  if %_tol > 0 then (
    %_sansvar: subset(%_sansvar, lambda([%_v], is(abs(float(coeff(%_sans, %_v, 1))) > %_tol))),
    %_tansvar: subset(%_tansvar, lambda([%_v], is(abs(float(coeff(%_tans, %_v, 1))) > %_tol)))
  ),
  /* Say nothing if tans is free of vars and is zero) */
  if (emptyp(%_tansvar) and %_tans=0) then return(""),
  /* Check for spurious (extra) vars */
  %_extras: setdifference(%_sansvar, %_tansvar),
  if length(%_extras) > 0 then (
    %_txt: castext_concat(%_txt, str_unexpected_variable),
    %_txt: castext_concat(%_txt, fb_strip_list(listify(%_extras)) ),
    %_txt: castext_concat(%_txt, "."  ) ),
  /* Check for missing vars */
  %_missing: setdifference(%_tansvar, %_sansvar),
  if length(%_missing) > 0 then  (
    %_txt: castext_concat(%_txt, str_missing_variable ),
    %_txt: castext_concat(%_txt, fb_strip_list(listify(%_missing)) ),
    %_txt: castext_concat(%_txt,  castext(" (<code>{@stack_disp_comma_separate(listify(%_missing))@}</code>)." ))),
  if %_txt # %_label then return(%_txt),
  /* if set of vars is ok, then check for the terms with vars from given list (%_vars). */ 
  %_L: sublist (%_vars, lambda ([x], diff(%_sans-%_tans, x)#0)),
  if length(%_L)=0 then return(""),
  if length(%_L)=1 then (
    %_txt: castext_concat( %_txt, str_check_term ),
    return( castext_concat (%_txt, castext("{@%_L[1]@}.") ) )
  ),
  %_txt: castext_concat( %_txt, str_check_terms ), 
  %_txt: castext_concat( %_txt, fb_strip_list(%_L) ), 
  castext_concat(%_txt, "." ) 
);	
/* this should return true if the check passes, false otherwise */
fb_varsOK(%_sans,%_tans, [%_opt] ):= block([%_res],
  if length(%_opt)=0 then %_res: fb_vars(%_sans,%_tans ),
  if length(%_opt)=1 then %_res: fb_vars(%_sans,%_tans, %_opt[1] ),
  if length(%_opt)=2 then %_res: fb_vars(%_sans,%_tans, %_opt[1], %_opt[2] ),
  if length(%_opt)=3 then %_res: fb_vars(%_sans,%_tans, %_opt[1], %_opt[2], %_opt[3] ),
  stringp(%_res));


/* https://github.com/mkraska/meclib/wiki/fb_unit */
fb_unit(%_sans, %_tans, %_tol) := block([%_snum, %_tnum, %_sunit, %_tunit, %_oom, %_mnt, %_d, %_d0, simp, debug1,
  str_unexpected_base_unit: castext("[[lang code='de']]&nbsp;Unerwartete Basiseinheit [[/lang]][[lang code='en,other']]&nbsp;Unexpected base unit [[/lang]]"),
  str_not_dimensionless: castext("[[lang code='de']]&nbsp;Der Wert sollte nicht dimensionslos sein.[[/lang]][[lang code='en,other']]&nbsp;The value should not be dimensionless.[[/lang]]"),
  str_deviation: castext("[[lang code='de']]&nbsp;Abweichung: [[/lang]][[lang code='en,other']]&nbsp;Deviation: [[/lang]]"),
  str_value_too_large: castext("[[lang code='de']]&nbsp;Der Wert ist betragsm&auml;&szlig;ig zu gro&szlig;.[[/lang]][[lang code='en,other']]&nbsp;The absolute value is too large.[[/lang]]"),
  str_value_too_small: castext("[[lang code='de']]&nbsp;Der Wert ist betragsm&auml;&szlig;ig zu klein.[[/lang]][[lang code='en,other']]&nbsp;The absolute value is too small.[[/lang]]"),
  str_sign: castext("[[lang code='de']]&nbsp;Pr&uuml;fen Sie das Vorzeichen.[[/lang]][[lang code='en,other']]&nbsp;Check the sign.[[/lang]]"),
  str_mantissa: castext("[[lang code='de']]&nbsp;Die Mantisse stimmt, die Zehnerpotenz weicht aber um mindestens eine Gr&ouml;&szlig;enordnung ab. Pr&uuml;fen Sie Ihre Einheitenumrechnung. [[/lang]][[lang code='en,other']]&nbsp;The mantissa is correct but the value is off by at least one order of magnitude. Check your unit conversion.[[/lang]]"),
  str_small_1: castext("[[lang code='de']]&nbsp;Der Betrag ist um mindestens [[/lang]][[lang code='en,other']]&nbsp;The value is too small by at least [[/lang]]"),
  str_small_2: castext("[[lang code='de']]% zu klein.[[/lang]][[lang code='en,other']]%.[[/lang]]"),
  str_large_1: castext("[[lang code='de']]&nbsp;Der Betrag ist um mindestens [[/lang]][[lang code='en,other']]&nbsp;The value is too large by at least [[/lang]]"),
  str_large_2: castext("[[lang code='de']]% zu gro&szlig;.[[/lang]][[lang code='en,other']]%.[[/lang]]")
  ],
 simp:true,
  /* Debug strings */
  if debug then debug1: "tnum=0 and snum=0 (because debug=true. Would be empty otherwise.)" else debug1:"",
  /* Only touch the units system if some question variable has already turned it on itself
     (via stack_unit_si_declare(true)) - member('units, features) is the same check STACK's
     own stackunits.mac uses internally (listofunits, stackunits_make, ...) to decide whether
     to lazily auto-activate units. Calling stack_unit_si_to_si_base()/stackunits_make() is
     what triggers that lazy activation - it fires the FIRST time ANY unit-touching function
     runs in the whole render, globally and permanently for every other PRT and the general
     feedback in the same render, declaring a large table of single/double-letter symbols
     (m, A, F, ...) as units and giving them upright \mathrm{...} rendering everywhere they
     appear from then on - including as perfectly ordinary variable names that happen to
     collide with an SI unit letter (e.g. a reaction force named A). fb_coeffs() calls this
     function once per coefficient it checks, so without this guard, merely using fb_coeffs()
     (e.g. for an equilibrium-equation PRT) was enough to silently turn units on question-wide,
     even though coefficients never carry units. With the guard, fb_unit()/fb_coeffs()/
     fb_number() never activate units on their own - a question that genuinely wants unit
     support (e.g. comparing a plain student number against a teacher answer like FG*N) must
     call stack_unit_si_declare(true) itself, explicitly, so the side effect is opt-in and
     happens exactly where the question author expects it. */
  if member('units, features) then (
    /* extract numbers and units */
    %_snum: float(simplify(stack_units_nums(stack_unit_si_to_si_base(%_sans)))),
    if %_snum = NULLNUM then %_snum:1.0,
    %_tnum: float(simplify(stack_units_nums(stack_unit_si_to_si_base(%_tans)))),
    if %_tnum = NULLNUM then %_tnum:1.0,
    %_sunit: stack_units_units(stack_unit_si_to_si_base(%_sans)),
    if %_sunit = NULLUNITS then %_sunit:0,  /* display as 0 if not correct */
    %_tunit: stack_units_units(stack_unit_si_to_si_base(%_tans)),
    if %_tunit = NULLUNITS then %_tunit:0,  /* display as 0 if not correct */
    /* complain if units don't match */
    if (%_sunit # %_tunit) and (%_sunit # 0) then return(
      castext_concat(str_unexpected_base_unit, castext("{@(stack_disp_fractions(\"i\"),%_sunit)@}")  ) ),
    if (%_sunit # %_tunit) and (%_sunit = 0) and (%_snum # 0.0) then return(str_not_dimensionless)
  ) else (
    /* units never activated by the question - treat both sides as plain numbers, exactly
       like fb_number was always meant to behave. */
    %_snum: float(%_sans),
    %_tnum: float(%_tans),
    /* A non-numeric result here (units still off) means something is misconfigured - a
       reference expression that never fully evaluated, a forgotten deg2rad(), a name
       mismatch reaching this far - not a normal student mistake to render feedback for.
       Fail loudly instead of letting the sign/tolerance logic below misbehave silently or
       crash with a cryptic error. error() is on STACK's forbidden-function list and cannot
       be called from a stack_include()'d file like this one (same restriction documented
       above for parse_string), so this returns plain, unlocalized diagnostic text through
       the normal feedback path instead - [[lang]] tags would not be processed here anyway. */
    if not real_numberp(%_snum) then
      return(sconcat("fb_unit: sans is not a real number (and the units feature is not declared): ", string(%_sans))),
    if not real_numberp(%_tnum) then
      return(sconcat("fb_unit: tans is not a real number (and the units feature is not declared): ", string(%_tans))),
    %_sunit: 0,
    %_tunit: 0
  ),
  /* if tol=0 just indicate deviation */
  if (%_tol=0 or %_tol=0.0) and %_tnum # 0.0 then return( 
    castext_concat(str_deviation,castext("{@ev( round((%_snum-%_tnum)/abs(%_tnum)*1000.0)/10.0, simp)@}%")) ), 
  /* special feedback if teacher's answer is zero */
  if %_tnum = 0.0  and %_snum  # 0.0 then return(str_value_too_large),
  if %_tnum = 0.0  then return(debug1), 
  if %_snum = 0.0 then return(str_value_too_small),
  /* check of the sign */
  if ev(%_snum/%_tnum, simp) <0 then return(str_sign),
  /* go back if error is less than tolerance */ 
  if ev(abs((%_snum-%_tnum)/%_tnum),simp) < %_tol then (
    if debug then return(castext_concat(str_deviation, castext("{@ev( round((%_snum-%_tnum)/abs(%_tnum)*1000.0)/10.0, simp)@}% (display because debug=true. Would be empty otherwise.)"))) 
    else return("") 
  ),
  /* OoM and mantissa error */
  %_oom: ev(log(abs(%_snum/%_tnum))/log(10.0), simp),
  %_mnt: ev(10.0^( %_oom - round(%_oom)),simp),
  /* Mantissa check */
  if ev(abs(1.0-%_mnt), simp) <%_tol and ev(abs(%_oom), simp)>0.1 then 
    return(str_mantissa) 
  /* general hint on precision */
  else(
    %_d0: ev(abs((1.0-abs(%_snum)/abs(%_tnum)))*100.0, simp),  /* % Abweichung */
    %_oom: ev(10.0^round(log(%_d0)/log(10.)-0.5), simp),
    %_d: ev(round(floor(%_d0/%_oom))*%_oom, simp),
    if %_d>=1 then %_d: ev(round(%_d),simp),
    if ev(abs(%_snum)<abs(%_tnum), simp) then        
        return(sconcat(str_small_1, %_d , str_small_2)) else
        return(sconcat(str_large_1, %_d , str_large_2))
 ), 
[%_snum,%_tnum, %_oom, %_d, %_mnt, %_d0] );

/* this should return true if the check passes, false otherwise */
fb_unitOK(%_sans, %_tans, %_tol):=stringp(fb_unit(%_sans, %_tans, %_tol));

/* https://github.com/mkraska/meclib/wiki/fb_coeffs */
/* Numeric coefficient comparison for symbolic expressions whose coefficients are floating-point
   numbers (so fb_vars' own symbolic term check, and AlgEquiv, are not suitable). First checks
   the variable set with fb_vars(), then compares the coefficient of each variable in %_tans
   numerically with fb_unit(), appending its (percentage-deviation) feedback per mismatching
   variable. Returns [text, boolean] like fb_fix1/fb_contact/fb_unidir.
   Does not currently handle a bare constant term (a part of the expression not multiplying
   any variable) - left out for now, see wiki. */
fb_coeffs(%_sans, %_tans, %_tol, %_description):=block(
  [%_txt: %_description, %_vcheck, %_vars, %_v, %_cs, %_ct, %_cres, simp: true,
    str_coeff_at: castext("[[lang code='de']]&nbsp;Koeffizient bei [[/lang]][[lang code='en,other']]&nbsp;Coefficient of [[/lang]]"),
    str_equation_ok: castext("[[lang code='de']]&nbsp;Die Gleichung stimmt.[[/lang]][[lang code='en,other']]&nbsp;The equation is correct.[[/lang]]")
  ],
  %_vcheck: fb_vars(%_sans, %_tans, [], "", %_tol),
  if %_vcheck # "" then return([castext_concat(%_txt, %_vcheck), false]),
  %_vars: listofvars(%_tans),
  /* Same tolerance as fb_vars just used for the variable-set check: skip a variable here too
     if its coefficient in %_tans does not exceed the tolerance - it isn't really "in" the
     equation, just floating-point noise, so it should not be coefficient-compared either. */
  if %_tol > 0 then %_vars: sublist(%_vars, lambda([%_v], is(abs(float(coeff(%_tans, %_v, 1))) > %_tol))),
  for %_v in %_vars do (
    %_cs: coeff(%_sans, %_v),
    %_ct: coeff(%_tans, %_v),
    %_cres: fb_unit(%_cs, %_ct, %_tol),
    /* The variable name must be interpolated via a literal {@...@} placeholder inside a
       castext() call written directly here in the source (as fb_fbd.mac does throughout,
       e.g. castext("{@n[L[1]]@} ...")) - NOT built at runtime with sconcat() and then
       wrapped in castext(), which is what produced the literal "castext(...)" text bug
       (castext()'s [[lang]]/{@..@} handling only happens for a string literal the loader
       sees at load time; a runtime-built string never gets that treatment, so castext()
       is left as a plain, undefined function call that Maxima can't reduce). */
    if %_cres # "" then
      %_txt: castext_concat(%_txt, castext_concat(castext_concat(str_coeff_at, castext("{@string(%_v)@}:")), %_cres))
  ),
  if %_txt # %_description then return([%_txt, false]),
  return([castext_concat(%_txt, str_equation_ok), true])
);

/* https://github.com/mkraska/meclib/wiki/fb_floats */
/* Symbolic answers with decimal coefficients (rounded values of exact coefficients such as
   3*sqrt(5)-6), of any structure (products, powers, roots, functions). Both answers are
   normalised with expand(float(...)): exact constants become decimal numbers, integer exponents
   stay integers; products of roots are combined first (rootscontract), so that sqrt(2)*sqrt(x)
   and sqrt(2*x) agree. Both are split into summands, each a number (coefficient with sign) times a
   variable part; the summands are paired by their variable parts (decimal numbers inside it
   replaced by a placeholder), and the numbers of each pair are compared one by one with fb_unit()
   and the relative tolerance %_tol. Extra summands of the answer are underlined in the evaluated
   form, with fb_vars() against the summands of the model answer without a partner and, if
   fb_dims declares the units of the variables, a unit check; a summand of the model answer left
   over is reported as missing. Without any pair, the whole answer gets the unit check, fb_vars()
   or a general hint. Returns [text, ok]; the text is empty if everything matches. */
/* the decimal numbers of an expression replaced by %_N, collected in fb_floats_nums
   (block variable of fb_floats, dynamically bound); simp:false keeps the order of the parts,
   inflag:true walks the internal form, where the sign of a term is part of its number
   (g - 0.3*x is g + (-0.3)*x), so that a wrong sign is a wrong number, not another skeleton */
fb_floats_walk(%_x) := if floatnump(%_x) then (fb_floats_nums: endcons(%_x, fb_floats_nums), '%_N)
  else if atom(%_x) then %_x
  else block([simp: false, inflag: true], apply(op(%_x), map(fb_floats_walk, args(%_x))));
/* normal form: rootscontract() (sqrt(2)*sqrt(x) -> sqrt(2*x), also sqrt(a)*sqrt(...) as Maxima
   splits sqrt(a*(...)) for a positive a), then expand(float(...)). The decimal numbers are hidden
   behind subscripted symbols %_P[i] during rootscontract(), which would turn them into fractions. */
fb_floats_hide(%_x) := if floatnump(%_x) then (fb_floats_nums: endcons(%_x, fb_floats_nums), %_P[length(fb_floats_nums)])
  else if atom(%_x) then %_x
  else block([simp: false, inflag: true], apply(op(%_x), map(fb_floats_hide, args(%_x))));
fb_floats_norm(%_e) := block([fb_floats_nums: [], %_h, %_i],
  %_h: rootscontract(ev(fb_floats_hide(%_e), simp)),
  for %_i thru length(fb_floats_nums) do %_h: subst(%_P[%_i] = fb_floats_nums[%_i], %_h),
  expand(float(%_h)));
/* display of the evaluated answer: numbers with 4 significant figures, the deviating ones (their
   positions in fb_floats_bad, counted as by fb_floats_walk) underlined by fb_floats_mark() */
/* underlined, not coloured: \color needs MathJax's color extension, which Moodle's MathJax 3
   may fail to load ("Extension color failed to load" instead of the whole formula) */
/* the TeX functions are named functions, not lambdas in texput(): test_security.mac checks the
   definitions of named functions for what STACK forbids */
fb_floats_mark_tex(%_e) := sconcat("{\\underline{", tex1(first(%_e)), "}}");
texput(fb_floats_mark, fb_floats_mark_tex);
fb_floats_show(%_x) := if floatnump(%_x) and abs(%_x - float(%e)) < 1e-12 then %e
  else if floatnump(%_x) then block([%_v],
    fb_floats_k: fb_floats_k + 1, %_v: significantfigures(%_x, 4),
    if member(fb_floats_k, fb_floats_bad) then (if %_v < 0 then -fb_floats_mark(-%_v) else fb_floats_mark(%_v)) else %_v)
  else if atom(%_x) then %_x
  else block([inflag: true], apply(op(%_x), map(fb_floats_show, args(%_x))));
/* numbers of a display with 4 significant figures; float(%e) (the base of exp after float())
   shown as e */
fb_floats_round(%_x) := if floatnump(%_x) and abs(%_x - float(%e)) < 1e-12 then %e
  else if floatnump(%_x) then significantfigures(%_x, 4)
  else if atom(%_x) then %_x
  else block([inflag: true], apply(op(%_x), map(fb_floats_round, args(%_x))));
/* the summands of a normalised expression, each as [key, numbers, coefficient, rest]: coefficient
   is the numeric factor of the summand (with its sign, 1 if there is none), rest the product of
   the other factors, key the rest with its decimal numbers replaced by %_N, numbers the
   coefficient followed by the decimal numbers of rest. Summands with the same key are the
   same term of the answer, up to their numbers. */
fb_floats_terms(%_e) := block([inflag: true, %_L],
  %_L: if not atom(%_e) and op(%_e) = "+" then args(%_e) else [%_e],
  map(lambda([%_x], block([%_c: 1, %_r: [], %_k, %_rest],
      if numberp(%_x) then %_c: %_x
      else if not atom(%_x) and op(%_x) = "*" then
        (for %_f in args(%_x) do if numberp(%_f) then %_c: %_c*%_f else %_r: endcons(%_f, %_r))
      else %_r: [%_x],
      %_rest: apply("*", %_r),
      fb_floats_nums: [], %_k: fb_floats_walk(%_rest),
      [%_k, cons(%_c, fb_floats_nums), %_c, %_rest])), %_L));
/* display of a summand: all of it marked (%_whole), or the numbers at the positions %_pos
   (1 = coefficient), a minus sign outside of the mark */
fb_floats_tshow(%_T, %_whole, %_pos) := block([%_c: fb_floats_round(%_T[3]), %_v, fb_floats_k: 1, fb_floats_bad: %_pos],
  if %_whole then (%_v: fb_floats_round(%_T[3]*%_T[4]),
    return(if is(%_c < 0) then -fb_floats_mark(-%_v) else fb_floats_mark(%_v))),
  if member(1, %_pos) then %_c: (if is(%_c < 0) then -fb_floats_mark(-%_c) else fb_floats_mark(%_c)),
  %_c*fb_floats_show(%_T[4]));

/* https://github.com/mkraska/meclib/wiki/fb_floats (section Units) */
/* Physical dimensions. The question declares the units of its variables as strings, e.g.
   fb_dims: [a = "m", c = "N/m", m = "kg", g = "m/s^2"]; the names on the left may be strings, too
   (needed for a name that has a value). The strings are read by the parser below, not by Maxima,
   so a unit such as m (metre) never meets a variable m (mass). A dimension is a product of powers
   of %_dL (length), %_dM (mass), %_dT (time), %_dI (current), %_dK (temperature), %_dN (amount);
   1 is dimensionless. Special values: %_dunk (an undeclared variable or an unknown unit: no
   check), %_dsum (a sum of different dimensions), %_dfun (a function or exponent whose argument
   has a dimension). */
fb_dims_unittab() := ["m" = %_dL, "g" = %_dM, "s" = %_dT, "A" = %_dI, "K" = %_dK, "mol" = %_dN,
  "N" = %_dM*%_dL/%_dT^2, "J" = %_dM*%_dL^2/%_dT^2, "W" = %_dM*%_dL^2/%_dT^3, "Pa" = %_dM/(%_dL*%_dT^2),
  "bar" = %_dM/(%_dL*%_dT^2), "Hz" = 1/%_dT, "C" = %_dI*%_dT, "V" = %_dM*%_dL^2/(%_dT^3*%_dI),
  "Ohm" = %_dM*%_dL^2/(%_dT^3*%_dI^2), "min" = %_dT, "h" = %_dT, "d" = %_dT, "t" = %_dM,
  "l" = %_dL^3, "L" = %_dL^3, "rad" = 1, "deg" = 1, "rpm" = 1/%_dT];
fb_dims_name(%_n) := block([%_a: assoc(%_n, fb_dims_unittab())],
  if %_a = false and slength(%_n) > 1 and member(charat(%_n, 1), ["p", "n", "u", "m", "c", "d", "h", "k", "M", "G", "T"]) then
    %_a: assoc(substring(%_n, 2), fb_dims_unittab()),
  if %_a = false then '%_dunk else %_a);
/* a unit string: names, products (*, blank, ·), quotients (/), powers (^2, ^-1, ^(1/2)) and
   parentheses, e.g. "kg*m/s^2", "N/m", "kg/(m s^2)". Tokens: ["u", name], ["n", integer] or one
   of the characters * / ^ ( ) - */
fb_dims_tokens(%_s) := block([%_t: [], %_w: "", %_n: -1, %_ch],
  for %_ch in endcons(" ", charlist(%_s)) do (
    if alphacharp(%_ch) then (if %_n >= 0 then (%_t: endcons(["n", %_n], %_t), %_n: -1), %_w: sconcat(%_w, %_ch))
    else if digitcharp(%_ch) and %_w = "" then %_n: max(%_n, 0)*10 + cint(%_ch) - cint("0")
    else (
      if %_w # "" then (%_t: endcons(["u", %_w], %_t), %_w: ""),
      if %_n >= 0 then (%_t: endcons(["n", %_n], %_t), %_n: -1),
      if member(%_ch, ["*", "/", "^", "(", ")", "-"]) then %_t: endcons(%_ch, %_t)
      else if %_ch = "·" or %_ch = "." then %_t: endcons("*", %_t)
      else if %_ch # " " then %_t: endcons("?", %_t))),
  %_t);
/* recursive descent over the tokens %_P from position %_k (bound in fb_dims_unit) */
fb_dims_tok() := if %_k <= length(%_P) then %_P[%_k] else "";
fb_dims_pexpr() := block([%_v: fb_dims_pfac(), %_t],
  while (%_t: fb_dims_tok(), %_t = "*" or %_t = "/" or %_t = "(" or listp(%_t)) do (
    if %_t = "*" or %_t = "/" then %_k: %_k + 1,
    if %_t = "/" then %_v: %_v/fb_dims_pfac() else %_v: %_v*fb_dims_pfac()),
  %_v);
fb_dims_pfac() := block([%_v: fb_dims_pprim(), %_p: false, %_s: 1, %_n: 1, %_d: 1, %_t],
  if fb_dims_tok() = "^" then (
    %_k: %_k + 1,
    if fb_dims_tok() = "(" then (%_p: true, %_k: %_k + 1),
    if fb_dims_tok() = "-" then (%_s: -1, %_k: %_k + 1),
    %_t: fb_dims_tok(),
    if listp(%_t) and %_t[1] = "n" then (%_n: %_t[2], %_k: %_k + 1) else %_fail: true,
    if %_p and fb_dims_tok() = "/" then (%_k: %_k + 1, %_t: fb_dims_tok(),
      if listp(%_t) and %_t[1] = "n" and %_t[2] > 0 then (%_d: %_t[2], %_k: %_k + 1) else %_fail: true),
    if %_p then (if fb_dims_tok() = ")" then %_k: %_k + 1 else %_fail: true),
    if not %_fail then %_v: %_v^(%_s*%_n/%_d)),
  %_v);
fb_dims_pprim() := block([%_t: fb_dims_tok(), %_v],
  if listp(%_t) then (%_k: %_k + 1, if %_t[1] = "u" then fb_dims_name(%_t[2]) else 1)
  else if %_t = "(" then (%_k: %_k + 1, %_v: fb_dims_pexpr(),
    if fb_dims_tok() = ")" then %_k: %_k + 1 else %_fail: true, %_v)
  else (%_fail: true, %_k: length(%_P) + 1, 1));
fb_dims_unit(%_s) := block([simp: true, %_P: fb_dims_tokens(%_s), %_k: 1, %_fail: false, %_v],
  %_v: fb_dims_pexpr(),
  if %_fail or %_k <= length(%_P) or not freeof('%_dunk, %_v) then '%_dunk else %_v);
/* the table [name = dimension] of fb_dims, [] if fb_dims is not a list */
fb_dims_table() := if not listp(fb_dims) then []
  else map(lambda([%_e], (if stringp(lhs(%_e)) then lhs(%_e) else string(lhs(%_e))) =
    (if stringp(rhs(%_e)) then fb_dims_unit(rhs(%_e)) else if numberp(rhs(%_e)) then 1 else '%_dunk)), fb_dims);
/* a decimal exponent (sqrt() is ^0.5 after float()) as a fraction with a small denominator */
fb_dims_q(%_x) := block([%_d],
  if not floatnump(%_x) then return(%_x),
  for %_d thru 12 do if abs(%_x*%_d - round(%_x*%_d)) < 1e-9 then return(round(%_x*%_d)/%_d),
  %_x);
fb_dims_bad(%_d) := member(%_d, ['%_dunk, '%_dsum, '%_dfun]);
/* the dimension of an expression with the table %_tab */
fb_dims_of(%_x, %_tab) := block([simp: true, inflag: true, radexpand: all, %_o, %_a, %_d, %_e],
  if numberp(%_x) or constantp(%_x) then return(1),
  if symbolp(%_x) or subvarp(%_x) then
    (%_a: assoc(string(%_x), %_tab), return(if %_a = false then '%_dunk else %_a)),
  if atom(%_x) then return('%_dunk),
  %_o: op(%_x), %_a: args(%_x),
  %_d: map(lambda([%_y], fb_dims_of(%_y, %_tab)), %_a),
  if member('%_dunk, %_d) then return('%_dunk),
  %_e: sublist(%_d, lambda([%_y], %_y = '%_dsum or %_y = '%_dfun)),
  if %_e # [] then return(first(%_e)),
  if %_o = "+" then return(if every(lambda([%_y], is(%_y = first(%_d))), %_d) then first(%_d) else '%_dsum),
  if %_o = "*" then return(apply("*", %_d)),
  if %_o = "^" then (
    if %_d[2] # 1 then return('%_dfun),
    if %_d[1] = 1 then return(1),
    return(if numberp(%_a[2]) then %_d[1]^fb_dims_q(%_a[2]) else '%_dfun)),
  if %_o = abs then return(%_d[1]),
  if every(lambda([%_y], is(%_y = 1)), %_d) then 1 else '%_dfun);
/* a dimension written in SI base units, for the feedback */
texput(%_um, "\\mathrm{m}")$ texput(%_ukg, "\\mathrm{kg}")$ texput(%_us, "\\mathrm{s}")$
texput(%_uA, "\\mathrm{A}")$ texput(%_uK, "\\mathrm{K}")$ texput(%_umol, "\\mathrm{mol}")$
fb_dims_show(%_d) := subst(['%_dL = '%_um, '%_dM = '%_ukg, '%_dT = '%_us, '%_dI = '%_uA, '%_dK = '%_uK, '%_dN = '%_umol], %_d);
/* feedback on the dimension of a whole answer, "" if it is right or cannot be checked */
fb_dimension(%_sans, %_tans) := block([simp: true, %_tab: fb_dims_table(), %_ds, %_dt, %_du, %_tu],
  if %_tab = [] then return(""),
  %_dt: fb_dims_of(float(%_tans), %_tab), %_ds: fb_dims_of(float(%_sans), %_tab),
  if fb_dims_bad(%_dt) or %_ds = '%_dunk or is(%_ds = %_dt) then return(""),
  if %_ds = '%_dsum then return(castext("[[lang code='de']]&nbsp;In Ihrem Ergebnis werden Gr&ouml;&szlig;en verschiedener Einheiten addiert.[[/lang]][[lang code='en,other']]&nbsp;Your result adds quantities of different units.[[/lang]]")),
  if %_ds = '%_dfun then return(castext("[[lang code='de']]&nbsp;In Ihrem Ergebnis hat eine Funktion (z.&nbsp;B. sin, exp, ln) oder ein Exponent ein Argument mit Einheit.[[/lang]][[lang code='en,other']]&nbsp;In your result, a function (e.g. sin, exp, ln) or an exponent has an argument with a unit.[[/lang]]")),
  %_du: fb_dims_show(%_ds), %_tu: fb_dims_show(%_dt),
  castext("[[lang code='de']]&nbsp;Ihr Ergebnis hat die Einheit {@%_du@} statt {@%_tu@}.[[/lang]][[lang code='en,other']]&nbsp;Your result has the unit {@%_du@} instead of {@%_tu@}.[[/lang]]"));

/* https://github.com/mkraska/meclib/wiki/fb_floats (section Function arguments) */
/* Calls of functions with one argument: trigonometric, inverse and hyperbolic functions, log,
   exp (Maxima's %e^x) and roots (powers with an exponent that is not an integer, e.g. sqrt(x) =
   x^(1/2)); float() turns %e into 2.718..., so a float base e is exp, too. fb_floats_call()
   returns [key, argument] or false; the key is the function, "exp" or ["root", exponent]. */
fb_floats_funs() := [sin, cos, tan, cot, sec, csc, asin, acos, atan, acot, sinh, cosh, tanh, coth, asinh, acosh, atanh, log];
fb_floats_call(%_x) := if atom(%_x) then false else block([inflag: true, %_o, %_a],
  %_o: op(%_x), %_a: args(%_x),     /* after inflag is bound: sqrt(x) is x^(1/2) */
  if member(%_o, fb_floats_funs()) and length(%_a) = 1 then [%_o, first(%_a)]
  else if %_o = "^" and (first(%_a) = %e or (floatnump(first(%_a)) and abs(first(%_a) - float(%e)) < 1e-12)) then ["exp", second(%_a)]
  else if %_o = "^" and numberp(second(%_a)) and not integerp(second(%_a))
          and not (floatnump(second(%_a)) and second(%_a) = round(second(%_a))) then [["root", float(second(%_a))], first(%_a)]
  else false);
/* a call with only its function marked (its argument is right): fb_floats_fmark(f, argument),
   shown as the function name underlined; roots and exp are marked as a whole */
/* f(a) for a function name f: funmake() is forbidden in STACK questions, subst() is not */
fb_floats_call1(%_f, %_a) := subst(%_f, fb_floats_f, fb_floats_f(%_a));
fb_floats_fmark_tex(%_e) := block([%_h: tex1(fb_floats_call1(first(%_e), 'x)), %_k],
  %_k: ssearch("\\left(", %_h),
  if integerp(%_k) then sconcat("{\\underline{", substring(%_h, 1, %_k), "}}\\left( ", tex1(second(%_e)), " \\right)")
  else sconcat("{\\underline{", tex1(fb_floats_call1(first(%_e), second(%_e))), "}}"));
texput(fb_floats_fmark, fb_floats_fmark_tex);
fb_floats_fmark_of(%_c) := block([inflag: true],
  if symbolp(op(%_c)) and member(op(%_c), fb_floats_funs()) then fb_floats_fmark(op(%_c), first(args(%_c)))
  else fb_floats_mark(%_c));
/* true if the expression contains none of the calls %_L */
fb_floats_nofcall(%_x, %_L) := every(lambda([%_c], freeof(%_c, %_x)), %_L);
/* the outermost calls of an expression, in the order of fb_floats_repl() */
fb_floats_calls(%_x) := if fb_floats_call(%_x) # false then [%_x] else if atom(%_x) then []
  else block([inflag: true], apply(append, map(fb_floats_calls, args(%_x))));
/* the expression with the k-th outermost call replaced by fb_floats_rnew[k] (false: kept);
   fb_floats_rk counts the calls (both bound in fb_floats) */
fb_floats_repl(%_x) := if fb_floats_call(%_x) # false then block([%_r],
    fb_floats_rk: fb_floats_rk + 1, %_r: fb_floats_rnew[fb_floats_rk], if %_r = false then %_x else %_r)
  else if atom(%_x) then %_x
  else block([inflag: true], apply(op(%_x), map(fb_floats_repl, args(%_x))));

fb_floats(%_sans, %_tans, %_tol) := fb_floats_main(%_sans, %_tans, %_tol, false);
/* %_inner: the arguments of a call (recursion); their evaluated form is shown for deviating
   numbers if it has more than one summand, since the student typed the argument in another form */
fb_floats_main(%_sans, %_tans, %_tol, %_inner) := block([simp: true, %_s, %_t, %_sT, %_tT, %_used, %_pairs: [], %_us, %_ut: [],
    %_bad: [], %_txt: "", %_r, %_i, %_j, %_p, %_disp, %_tab, %_dt, %_ds, %_du, %_tu, %_v, %_dimtxt: "", %_vt: "", %_nd: [],
    %_s0, %_sc, %_tc, %_tu2, %_argtxt: "", %_back: [], %_lone: [], %_fcalls: [], %_fraw: [], %_others, fb_floats_nums, fb_floats_rnew, fb_floats_rk,
    str_value: castext("[[lang code='de']]&nbsp;Zahlenwert [[/lang]][[lang code='en,other']]&nbsp;Number [[/lang]]"),
    str_marked: castext("[[lang code='de']]&nbsp;Markierter Zahlenwert [[/lang]][[lang code='en,other']]&nbsp;Marked number [[/lang]]"),
    str_structure: castext("[[lang code='de']]&nbsp;Tut mir leid, leider habe ich keine konkreteren Hinweise.[[/lang]][[lang code='en,other']]&nbsp;Sorry, I have no more specific hints.[[/lang]]"),
    str_term: castext("[[lang code='de']]&nbsp;Pr&uuml;fen Sie den markierten Term.[[/lang]][[lang code='en,other']]&nbsp;Check the marked term.[[/lang]]"),
    str_terms: castext("[[lang code='de']]&nbsp;Pr&uuml;fen Sie die markierten Terme.[[/lang]][[lang code='en,other']]&nbsp;Check the marked terms.[[/lang]]"),
    str_missing: castext("[[lang code='de']]&nbsp;Ihr Ergebnis ist bis auf einen fehlenden Term richtig.[[/lang]][[lang code='en,other']]&nbsp;Your result is right except for a missing term.[[/lang]]"),
    str_missings: castext("[[lang code='de']]&nbsp;Ihr Ergebnis ist bis auf fehlende Terme richtig.[[/lang]][[lang code='en,other']]&nbsp;Your result is right except for missing terms.[[/lang]]"),
    str_also: castext("[[lang code='de']]&nbsp;Au&szlig;erdem fehlt ein Term.[[/lang]][[lang code='en,other']]&nbsp;Also, a term is missing.[[/lang]]"),
    str_alsos: castext("[[lang code='de']]&nbsp;Au&szlig;erdem fehlen Terme.[[/lang]][[lang code='en,other']]&nbsp;Also, terms are missing.[[/lang]]"),
    str_dsum: castext("[[lang code='de']]&nbsp;Im markierten Term werden Gr&ouml;&szlig;en verschiedener Einheiten addiert.[[/lang]][[lang code='en,other']]&nbsp;The marked term adds quantities of different units.[[/lang]]"),
    str_dfun: castext("[[lang code='de']]&nbsp;Im markierten Term hat eine Funktion (z.&nbsp;B. sin, exp, ln) oder ein Exponent ein Argument mit Einheit.[[/lang]][[lang code='en,other']]&nbsp;In the marked term, a function (e.g. sin, exp, ln) or an exponent has an argument with a unit.[[/lang]]"),
    str_root: castext("[[lang code='de']]&nbsp;Unter der Wurzel:[[/lang]][[lang code='en,other']]&nbsp;Under the root:[[/lang]]"),
    str_fun: castext("[[lang code='de']]&nbsp;Pr&uuml;fen Sie die Funktion.[[/lang]][[lang code='en,other']]&nbsp;Check the function.[[/lang]]")
  ],
  %_s: fb_floats_norm(%_sans), %_t: fb_floats_norm(%_tans), %_s0: %_s,
  /* function arguments: the calls of the answer are paired in order with those of the model answer
     of the same function; differing arguments are compared by fb_floats() itself (recursively,
     with the same tolerance), and the call is then taken as that of the model answer, so that
     the summands below can be paired. A call without a partner stays: its summand gets "Check the
     marked term". The display below shows the student's calls again (%_back). */
  %_sc: fb_floats_calls(%_s), %_tc: fb_floats_calls(%_t),
  %_tu2: makelist(false, length(%_tc)), fb_floats_rnew: makelist(false, length(%_sc)),
  for %_i thru length(%_sc) do block([%_cs: fb_floats_call(%_sc[%_i]), %_m: 0, %_ct, %_rr, %_c],
    for %_j thru length(%_tc) do
      if %_m = 0 and not %_tu2[%_j] and is(first(fb_floats_call(%_tc[%_j])) = first(%_cs)) then %_m: %_j,
    if %_m = 0 then %_lone: endcons(fb_floats_round(%_sc[%_i]), %_lone),
    if %_m > 0 then (
      %_tu2[%_m]: true, %_ct: fb_floats_call(%_tc[%_m]),
      if not is(second(%_cs) = second(%_ct)) then (
        %_rr: fb_floats_main(second(%_cs), second(%_ct), %_tol, true),
        fb_floats_rnew[%_i]: %_tc[%_m],
        %_back: endcons([fb_floats_round(%_tc[%_m]), fb_floats_round(%_sc[%_i]), not %_rr[2]], %_back),
        if not %_rr[2] then (
          %_c: fb_floats_round(%_sc[%_i]),
          %_argtxt: castext_concat(%_argtxt, castext_concat(
            if listp(first(%_cs)) then str_root
            else if first(%_cs) = "exp" then castext("[[lang code='de']]&nbsp;Im Exponenten von {@%_c@}:[[/lang]][[lang code='en,other']]&nbsp;In the exponent of {@%_c@}:[[/lang]]")
            else castext("[[lang code='de']]&nbsp;Im Argument von {@%_c@}:[[/lang]][[lang code='en,other']]&nbsp;In the argument of {@%_c@}:[[/lang]]"),
            %_rr[1])))))),
  /* a call without a partner whose argument is that of a call of the model answer without a
     partner (e.g. asin(x) for acos(x)): only the function is wrong */
  for %_i thru length(%_sc) do block([%_cs: fb_floats_call(%_sc[%_i]), %_m: 0],
    if member(fb_floats_round(%_sc[%_i]), %_lone) then (
      for %_j thru length(%_tc) do
        if %_m = 0 and not %_tu2[%_j] and second(fb_floats_main(second(%_cs), second(fb_floats_call(%_tc[%_j])), %_tol, true)) then %_m: %_j,
      if %_m > 0 then (%_tu2[%_m]: true,
        %_fcalls: endcons(fb_floats_round(%_sc[%_i]), %_fcalls), %_fraw: endcons(%_sc[%_i], %_fraw)))),
  if %_back # [] then (fb_floats_rk: 0, %_s: expand(fb_floats_repl(%_s))),
  %_sT: fb_floats_terms(%_s), %_tT: fb_floats_terms(%_t),
  /* each summand of the model answer gets the first free summand of the answer with its key */
  %_used: makelist(false, length(%_sT)),
  for %_j thru length(%_tT) do block([%_m: 0],
    for %_i thru length(%_sT) do
      if %_m = 0 and not %_used[%_i] and is(%_sT[%_i][1] = %_tT[%_j][1]) then %_m: %_i,
    if %_m > 0 then (%_used[%_m]: true, %_pairs: endcons([%_m, %_j], %_pairs)) else %_ut: endcons(%_j, %_ut)),
  %_us: sublist(makelist(%_i, %_i, length(%_sT)), lambda([%_i], not %_used[%_i])),
  /* no summand in common: feedback on the whole answer (dimension, variables or a general hint) */
  if %_pairs = [] then (
    %_txt: castext_concat(fb_dimension(%_sans, %_tans), fb_vars(%_sans, %_tans)),
    /* nothing else to say, but calls without a partner (e.g. asin where the model answer has
       acos): the evaluated form with these calls marked */
    if %_txt = "" and %_argtxt = "" and %_lone # [] then (
      %_disp: fb_floats_round(%_s),
      for %_p in %_back do %_disp: subst(if %_p[3] then fb_floats_mark(%_p[2]) else %_p[2], %_p[1], %_disp),
      for %_p in %_lone do %_disp: block([simp: false], subst(if member(%_p, %_fcalls) then fb_floats_fmark_of(%_p) else fb_floats_mark(%_p), %_p, %_disp)),
      %_others: sublist(%_lone, lambda([%_p], not member(%_p, %_fcalls))),
      %_txt: castext_concat(castext("[[lang code='de']]&nbsp;Ausgewertet entspricht Ihre Eingabe {@%_disp@}.[[/lang]][[lang code='en,other']]&nbsp;Evaluated, your answer is {@%_disp@}.[[/lang]]"),
        castext_concat(if %_fcalls # [] then str_fun else "",
          if %_others = [] then "" else if length(%_others) = 1 then str_term else str_terms))),
    if %_txt = "" and %_argtxt = "" then %_txt: str_structure,
    return([castext_concat(%_argtxt, %_txt), false])),
  /* the numbers of the common summands; fb_unit() reports the deviation also for a matching
     number: only numbers outside the tolerance, as [summand of the answer, position, numbers] */
  for %_p in %_pairs do block([%_a: %_sT[%_p[1]][2], %_b: %_tT[%_p[2]][2], %_k],
    for %_k thru length(%_b) do
      if is(abs(%_a[%_k] - %_b[%_k]) > %_tol*abs(%_b[%_k])) then %_bad: endcons([%_p[1], %_k, %_a[%_k], %_b[%_k]], %_bad)),
  if %_bad = [] and %_us = [] and %_ut = [] then return(if %_argtxt = "" then ["", true] else [%_argtxt, false]),
  /* the extra summands: their dimension, if fb_dims is declared. A summand with a wrong unit makes
     the numbers meaningless: then they are neither marked nor named */
  if %_us # [] then (
    %_tab: fb_dims_table(),
    %_dt: if %_tab = [] then '%_dunk else fb_dims_of(%_t, %_tab),
    if not fb_dims_bad(%_dt) then for %_i in %_us do (
      %_ds: fb_dims_of(%_sT[%_i][3]*%_sT[%_i][4], %_tab),
      if %_ds = '%_dsum then %_dimtxt: castext_concat(%_dimtxt, str_dsum)
      else if %_ds = '%_dfun then %_dimtxt: castext_concat(%_dimtxt, str_dfun)
      else if %_ds # '%_dunk and not is(%_ds = %_dt) then (
        %_du: fb_dims_show(%_ds), %_tu: fb_dims_show(%_dt),
        if length(%_us) = 1 then %_dimtxt: castext_concat(%_dimtxt, castext("[[lang code='de']]&nbsp;Der markierte Term hat die Einheit {@%_du@}, das Ergebnis aber {@%_tu@}.[[/lang]][[lang code='en,other']]&nbsp;The marked term has the unit {@%_du@}, the result {@%_tu@}.[[/lang]]"))
        else (%_v: fb_floats_round(%_sT[%_i][3]*%_sT[%_i][4]),
          %_dimtxt: castext_concat(%_dimtxt, castext("[[lang code='de']]&nbsp;Der Term {@%_v@} hat die Einheit {@%_du@}, das Ergebnis aber {@%_tu@}.[[/lang]][[lang code='en,other']]&nbsp;The term {@%_v@} has the unit {@%_du@}, the result {@%_tu@}.[[/lang]]"))))),
    if %_dimtxt # "" then %_bad: []),
  /* the evaluated form with the deviating numbers and the extra summands marked: for marked
     summands, and for an answer that differs from its evaluated form (exact constants, factored
     forms), so that the numbers below can be found */
  if %_us # [] or (%_bad # [] and (if %_inner then length(%_sT) > 1 else not is(%_sans = %_s0))) then (
    /* an extra summand whose only fault is a function (its argument right) gets only the function
       marked, not the whole summand */
    %_disp: apply("+", makelist(fb_floats_tshow(%_sT[%_i], member(%_i, %_us) and fb_floats_nofcall(%_sT[%_i][4], %_fraw),
      map(second, sublist(%_bad, lambda([%_b], %_b[1] = %_i)))), %_i, length(%_sT))),
    /* the student's calls instead of those of the model answer, the wrong ones marked */
    for %_p in %_back do %_disp: subst(if %_p[3] then fb_floats_mark(%_p[2]) else %_p[2], %_p[1], %_disp),
    for %_p in %_fcalls do %_disp: block([simp: false], subst(fb_floats_fmark_of(%_p), %_p, %_disp)),   /* keep the order */
    %_txt: castext("[[lang code='de']]&nbsp;Ausgewertet entspricht Ihre Eingabe {@%_disp@}.[[/lang]][[lang code='en,other']]&nbsp;Evaluated, your answer is {@%_disp@}.[[/lang]]"),
    str_value: str_marked),
  %_txt: castext_concat(%_txt, %_argtxt),
  /* fb_vars() for the extra summands against the summands of the model answer without a partner */
  if %_us # [] then (
    %_vt: fb_vars(apply("+", map(lambda([%_i], %_sT[%_i][3]*%_sT[%_i][4]), %_us)),
                  apply("+", map(lambda([%_j], %_tT[%_j][3]*%_tT[%_j][4]), %_ut))),
    %_txt: castext_concat(%_txt, castext_concat(%_dimtxt, %_vt)),
    %_others: sublist(%_us, lambda([%_i], fb_floats_nofcall(%_sT[%_i][4], %_fraw))),
    if %_dimtxt = "" and %_vt = "" then %_txt: castext_concat(%_txt, castext_concat(
      if %_fcalls # [] then str_fun else "",
      if %_others = [] then "" else if length(%_others) = 1 then str_term else str_terms))),
  for %_b in %_bad do (
    %_r: fb_unit(%_b[3], %_b[4], %_tol),
    /* the number with 4 significant figures (an exact answer gives long decimals) */
    %_txt: castext_concat(%_txt, castext_concat(castext_concat(str_value, castext("{@significantfigures(%_b[3], 4)@}:")), %_r))
  ),
  /* summands of the model answer without a partner, beyond those that the extra summands may stand for */
  if length(%_ut) > length(%_us) then
    %_txt: castext_concat(%_txt,
      if %_us = [] and %_bad = [] then (if length(%_ut) = 1 then str_missing else str_missings)
      else (if length(%_ut) - length(%_us) = 1 then str_also else str_alsos)),
  [%_txt, false]
);

/* https://github.com/mkraska/meclib/wiki/fb_number */
fb_number(%_sans, %_tans, %_tol) := fb_unit(%_sans, %_tans, %_tol);
/* this should return true if the check passes, false otherwise */
fb_numberOK(%_snum, %_tnum, %_tol):=stringp(fb_number(%_snum, %_tnum, %_tol));

/* https://github.com/mkraska/meclib/wiki/fb_unit_matrix() */
/* Element-wise feedback for matrix (vector) answers. fb_unit_matrix() checks every element
   with fb_unit() and returns [text, isOK]: isOK is true iff every element is within the
   tolerance, so it is a complete numeric check. fb_vars_matrix() checks every element with
   fb_vars() and returns text only, like fb_vars() itself (no message does not prove
   equivalence). In both, only elements with a message appear, each as "<br>label: message".
   Labels (row by row):
     "xyz" (default)  x-/y-/z-Komponente for vectors with up to 3 elements
     "index"          Element 1, Element 2, ... for vectors
     a list           ['x_A, 'y_A] (symbols or expressions, shown as formulas; quote them so
                      that question variables of the same name are not substituted) or strings
   Matrices that are not vectors always get "Zeile i, Spalte j" unless a list is given.
   A list given instead of a matrix is taken as a column vector. */
fb_matrix_label(%_i, %_j, %_n, %_m, %_labels) := block([%_k, %_lab, %_c],
  %_k: (%_i - 1)*%_m + %_j,
  if matrixp(%_labels) then %_labels: flatten(args(%_labels)),
  if listp(%_labels) and %_k <= length(%_labels) then (
    %_lab: %_labels[%_k],
    return(castext("<br>{@%_lab@}:"))
  ),
  if %_n = 1 or %_m = 1 then (
    if %_labels # "index" and %_n*%_m <= 3 then (
      %_c: ['x, 'y, 'z][%_k],
      return(castext("<br>{@%_c@}[[lang code='de']]-Komponente:[[/lang]][[lang code='en,other']]-component:[[/lang]]"))
    ),
    return(castext("<br>Element {#%_k#}:"))
  ),
  castext("<br>[[lang code='de']]Zeile {#%_i#}, Spalte {#%_j#}:[[/lang]][[lang code='en,other']]Row {#%_i#}, column {#%_j#}:[[/lang]]")
);
/* common checks: returns "" or the message for non-matrix or differently sized answers */
fb_matrix_shape(%_sans, %_tans) := block(
  [str_not_matrix: castext("<br>[[lang code='de']]Die Eingabe ist keine Matrix.[[/lang]][[lang code='en,other']]The input is not a matrix.[[/lang]]"),
   str_size: castext("<br>[[lang code='de']]Die Matrix hat nicht die erwartete Gr&ouml;&szlig;e.[[/lang]][[lang code='en,other']]The matrix does not have the expected size.[[/lang]]")],
  if not matrixp(%_sans) then return(str_not_matrix),
  if matrix_size(%_sans) # matrix_size(%_tans) then return(str_size),
  ""
);
fb_unit_matrix(%_sans, %_tans, %_tol, [%_opt]) := block(
  [%_labels, %_txt: "", %_ok: true, %_n, %_m, %_r, %_r0, %_shape],
  %_labels: if length(%_opt) > 0 then %_opt[1] else "xyz",
  if listp(%_sans) then %_sans: transpose(matrix(%_sans)),
  if listp(%_tans) then %_tans: transpose(matrix(%_tans)),
  %_shape: fb_matrix_shape(%_sans, %_tans),
  if %_shape # "" then return([%_shape, false]),
  [%_n, %_m]: matrix_size(%_tans),
  for %_i thru %_n do for %_j thru %_m do (
    /* the flag must not depend on debug, which makes fb_unit() report in-tolerance values too */
    %_r0: block([debug: false], fb_unit(%_sans[%_i, %_j], %_tans[%_i, %_j], %_tol)),
    if %_r0 # "" then %_ok: false,
    %_r: if debug = true then fb_unit(%_sans[%_i, %_j], %_tans[%_i, %_j], %_tol) else %_r0,
    if %_r # "" then
      %_txt: castext_concat(%_txt, castext_concat(fb_matrix_label(%_i, %_j, %_n, %_m, %_labels), %_r))
  ),
  [%_txt, %_ok]
);
fb_vars_matrix(%_sans, %_tans, [%_opt]) := block(
  [%_vars, %_labels, %_tol, %_txt: "", %_n, %_m, %_r, %_shape],
  %_vars: if length(%_opt) > 0 then %_opt[1] else [],
  %_labels: if length(%_opt) > 1 then %_opt[2] else "xyz",
  %_tol: if length(%_opt) > 2 then %_opt[3] else 0,
  if listp(%_sans) then %_sans: transpose(matrix(%_sans)),
  if listp(%_tans) then %_tans: transpose(matrix(%_tans)),
  %_shape: fb_matrix_shape(%_sans, %_tans),
  if %_shape # "" then return(%_shape),
  [%_n, %_m]: matrix_size(%_tans),
  for %_i thru %_n do for %_j thru %_m do (
    %_r: fb_vars(%_sans[%_i, %_j], %_tans[%_i, %_j], %_vars, "", %_tol),
    if %_r # "" then
      %_txt: castext_concat(%_txt, castext_concat(fb_matrix_label(%_i, %_j, %_n, %_m, %_labels), %_r))
  ),
  %_txt
);

/* https://github.com/mkraska/meclib/wiki/fb_dim */
fb_dim(%_res, %_vars, %_dims):=rat(subst(map("=", %_vars, map("*", %_vars, %_dims)),%_res)/%_res);

/* https://github.com/mkraska/meclib/wiki/fb_HAG */
/* Feedback on the sides of a right triangle: hypotenuse H, legs (Katheten) A and G, checked for
   a hypotenuse that is not longer than the longer leg or not shorter than the sum of the legs.
   Returns the feedback text ("" if neither applies), to be shown with {@fb_HAG(H, A, G)@}.
   The values are shown as formulas with 3 significant figures and the question's decimal
   separator; a symbolic variable in them needs a sign (e.g. assume(a > 0)).
   (Moved into the library from the questions, which carried their own copies.) */
fb_HAG(%_H, %_A, %_G) := block([%_h, %_a, %_g, %_s,
   %_r: lambda([%_x], fb_HAG_round(float(%_x)))],
  %_h: %_r(%_H), %_a: %_r(%_A), %_g: %_r(%_G), %_s: %_r(%_A + %_G),
  if is(%_H <= max(%_G, %_A)) then
    return(castext("[[lang code='de']] Die Hypotenuse ({@%_h@}) muss gr&ouml;&szlig;er als die gr&ouml;&szlig;te der beiden Katheten ({@%_a@} und {@%_g@}) sein.[[/lang]][[lang code='en,other']] The hypotenuse ({@%_h@}) must be longer than the longer of the two legs ({@%_a@} and {@%_g@}).[[/lang]]")),
  if is(%_H >= %_G + %_A) then
    return(castext("[[lang code='de']] Die Hypotenuse ({@%_h@}) muss kleiner als die Summe der beiden Katheten ({@%_a@} + {@%_g@} = {@%_s@}) sein.[[/lang]][[lang code='en,other']] The hypotenuse ({@%_h@}) must be shorter than the sum of the two legs ({@%_a@} + {@%_g@} = {@%_s@}).[[/lang]]")),
  "");
/* the numbers of an expression with 3 significant figures */
fb_HAG_round(%_x) := if floatnump(%_x) then significantfigures(%_x, 3)
  else if atom(%_x) then %_x
  else block([inflag: true], apply(op(%_x), map(fb_HAG_round, args(%_x))));

/* https://github.com/mkraska/meclib/wiki/Multilingual-questions#multilingual-syntax-hints */
meclib_h_number: castext("[[lang code='de']]Zahl[[/lang]][[lang code='en,other']]number[[/lang]]");
meclib_h_unit: castext("[[lang code='de']]Zahl mit Einheit[[/lang]][[lang code='en,other']]number with unit[[/lang]]");
meclib_h_alg: castext("[[lang code='de']]Ausdruck[[/lang]][[lang code='en,other']]expression[[/lang]]");
